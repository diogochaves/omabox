# What a release tarball (release.sh, git archive) leaves out: demo media, the original spike, CI,
# GitHub Pages' config, distribution recipes (packaging/: a package of omabox need not carry them).
docs/media/ export-ignore
spike/ export-ignore
.github/ export-ignore
_config.yml export-ignore
packaging/ export-ignore
# (the benchmark of small models, test/bench/: its fixtures are apps of their own, with dependencies
# a package of omabox does not have; the suite does not run it)
test/bench/ export-ignore
