#!/usr/bin/env bash
# omabox stand-in for inotifywait (#129), first on the PATH of what the box's Hyprland starts. Omarchy's
# plugin registry watches the plugins dir with it and reloads a local plugin on each change, often
# several times per save of a mounted --plugin (its files are the host checkout's); a shot or `wait
# still` then caught a half-reloaded plugin. In a box nothing reloads by itself: `omabox restart-shell`
# does. For that one watch, exactly as Omarchy runs it, this waits without watching, and ends with the
# shell (exiting would only have the registry start it again a second later); anything else goes to the
# real one. t_unit_omarchy_contract checks the registry still runs it this way. Only for the box's own
# session (OMABOX_OWN_SESSION, set by its Hyprland): a shell a command under `omabox run` starts, such as
# Omarchy's own shell tests, reloads as on a desktop, which those tests check (finding 424).
if [ "${OMABOX_OWN_SESSION:-}" = 1 ] && [ $# = 8 ] &&
   [ "${*:1:7}" = "-m -r -q -e close_write,create,delete,move --format %w%f" ] &&
   [[ ${8%/} == */.config/omarchy/plugins ]]; then
  # It waits without starting a process (#275: Omarchy's idle-spawn test counts each one). Quickshell
  # holds the write end of our stdin and never writes to it, so `read` sleeps until the shell is gone
  # (end of file), waking once an hour to ask. The shell is alive while it is still our parent (it is
  # no longer once it exits, even unreaped: `kill -0` would still find it). A stdin that ends while the
  # shell lives (another parent's /dev/null) falls back to asking every 5 s, with bash's own sleep.
  shell_alive() { local _pid _comm _state ppid; read -r _pid _comm _state ppid _ < /proc/$$/stat && [ "$ppid" = "$PPID" ]; }
  while IFS= read -r -t 3600 _ || [ $? -gt 128 ]; do shell_alive || exit 0; done
  enable -f /usr/lib/bash/sleep sleep 2>/dev/null || enable -f /usr/lib64/bash/sleep sleep 2>/dev/null || true
  while shell_alive; do sleep 5; done
  exit 0
fi
exec /usr/bin/inotifywait "$@"
