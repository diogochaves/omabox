#!/bin/sh
# The agent guard's omarchy-theme-set (finding 750), and through the three files beside it that run
# this one, its omarchy-theme-bg-set, omarchy-theme-bg-next and omarchy-font-set: first on a guarded
# agent's PATH, as omarchy-shell is. None of them needs a display. Omarchy 4.5's omarchy-theme-set has
# no `set -e`, and only its hyprctl and omarchy-shell calls fail under the guard: it still swaps the
# user's theme in ~/.local/state/omarchy/current, repoints the background, signals their terminals,
# rewrites tmux, btop, editor and browser colours, runs gsettings and the theme-set hook.
# omarchy-theme-bg-set repoints current/background before its (best effort, -q) omarchy-shell call;
# omarchy-theme-bg-next picks the next and runs it; omarchy-font-set rewrites the terminals' configs and
# fontconfig and signals kitty and ghostty. Refuse them while the display names no socket, saying what
# to run instead; a display that is a socket goes on to the next one on PATH (the caller named one on
# purpose; in a box, and for `omabox host`, the guard's directory is off PATH and this is not reached).
# Not caught (the guard is not a boundary, SECURITY.md): `omarchy theme set` and the rest of Omarchy's
# own `omarchy` dispatcher, which runs each command by its path, and a caller naming the path itself.
name=${OMABOX_GUARD_AS:-${0##*/}}
unset OMABOX_GUARD_AS
r=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
d=${WAYLAND_DISPLAY:-}
case $d in /*) ;; ?*) d=$r/$d ;; esac
if [ -z "$d" ] || [ ! -S "$d" ]; then
  # Run by another of Omarchy's commands (omarchy-theme-refresh, omarchy-theme-install): named too.
  by=$(tr '\0' '\n' < "/proc/$PPID/cmdline" 2>/dev/null | sed -n "s|^\(.*/\)\{0,1\}\(omarchy-[a-z0-9-]*\)$|\2|p" | grep -vxF "$name" | head -n 1)
  [ -n "$by" ] && by=" (run by $by)"
  # (the words as one argument, quoted when it has spaces: a theme's or font's name)
  w=$*; case $w in *" "*) w="\"$w\"" ;; esac
  a=${w:-ARG}
  case $name in
    omarchy-theme-set)
      what="it switches the user's real theme even with no display (their theme files, wallpaper, terminals, GTK, browser and keyboard colours, and the theme-set hook)"
      box="For a box: omabox up --theme $a, or omabox look theme $a; in a box that is up: omabox run -- omarchy-theme-set $a" ;;
    omarchy-theme-bg-set|omarchy-theme-bg-next)
      what="it changes the user's real wallpaper (the link ~/.local/state/omarchy/current/background) even with no display"
      box="For a box: omabox run -- $name${w:+ $w}" ;;
    omarchy-font-set)
      what="it rewrites the user's real font settings even with no display (their terminals' configs and fontconfig) and signals their terminals"
      box="For a box: omabox run -- omarchy-font-set $a" ;;
    *)
      what="it changes the user's real desktop settings"
      box="For a box: omabox run -- $name ..." ;;
  esac
  echo "omabox guard: not running $name$by here: $what. $box. Only when the user asked for their real desktop: omabox host -- $name${w:+ $w}" >&2
  exit 4
fi
# The next one on PATH that is not a guard's (any checkout's, as caller_path in bin/omabox).
set -f; IFS=:
for p in $PATH; do
  case $p in */share/guard|*/share/guard/|"") continue ;; esac
  [ -x "$p/$name" ] && { unset IFS; exec "$p/$name" "$@"; }
done
echo "omabox guard: no $name on PATH" >&2
exit 127
