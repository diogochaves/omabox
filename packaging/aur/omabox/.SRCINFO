pkgbase = omabox
	pkgdesc = Contained, invisible Hyprland desktops where agents run, drive and screenshot apps
	pkgver = 1.2.2
	pkgrel = 1
	url = https://github.com/diogochaves/omabox
	install = omabox.install
	arch = x86_64
	license = MIT
	makedepends = pkgconf
	makedepends = cargo
	depends = bash
	depends = glibc
	depends = libgcc
	depends = hyprland>=0.56
	depends = labwc
	depends = wlr-randr
	depends = bubblewrap
	depends = util-linux
	depends = iproute2
	depends = jq
	depends = grim>=1.5
	depends = gnome-keyring
	depends = libsecret
	depends = dbus
	depends = passt
	depends = wl-clipboard
	depends = wayland
	depends = libxkbcommon
	depends = pixman
	depends = libpng
	depends = at-spi2-core
	depends = glib2
	depends = systemd-libs
	depends = coreutils
	depends = diffutils
	depends = findutils
	depends = gawk
	depends = grep
	depends = procps-ng
	depends = sed
	depends = tar
	optdepends = quickshell: a shell in a box (Omarchy's bar in Omarchy boxes; plain boxes with --shell)
	optdepends = gtk3: GTK settings in Omarchy boxes
	optdepends = xdg-terminal-exec: the terminal a box opens (else foot, alacritty, kitty or ghostty)
	optdepends = foot: a terminal for plain boxes
	optdepends = python: omabox log journal (a box's journal sockets), the agent guard for Codex, a jailed agent's project in its box
	optdepends = gdb: omabox gdb (backtraces of a box's Hyprland or shell)
	optdepends = imagemagick: omabox shot --changed and omabox calibrate (the test card)
	optdepends = mesa-utils: up and ls say when a box's apps render in software
	optdepends = wf-recorder: omabox record (videos of a box)
	optdepends = ffmpeg: omabox record
	optdepends = pipewire: omabox up --audio (a box with sound of its own)
	optdepends = wireplumber: omabox up --audio
	optdepends = git: omabox setup --aquamarine (headless NVIDIA boxes, confirm-close)
	optdepends = cmake: omabox setup --aquamarine
	optdepends = ninja: omabox setup --aquamarine
	optdepends = hyprwayland-scanner: omabox setup --aquamarine
	optdepends = base-devel: omabox setup --aquamarine
	optdepends = github-cli: the opt-in omabox-feedback skill (setup --feedback-skill) files issues with gh
	optdepends = nftables: protect-ports (host ports no connected box reaches)
	source = https://github.com/diogochaves/omabox/releases/download/v1.2.2/omabox-1.2.2.tar.gz
	sha256sums = 0901a5f2d7d7ea3e9ac0eb0f916cb4e1098f3a50994d3580f61afa1dad421646

pkgname = omabox
