#!/usr/bin/env bash
# omabox: a contained, invisible Hyprland + Omarchy desktop ("box") for agents.
# Architecture, findings and safety rules: NOTES.md. Usage: omabox help.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
BOXES=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/omabox
# The broker's socket: how omabox inside ai-jail reaches its boxes (issue #16, finding 99).
BROKER_SOCK=${OMABOX_BROKER_SOCK:-$BOXES/.broker/sock}
# Box HOMEs live on disk, not in the runtime dir: a box writing a lot there would otherwise fill the
# tmpfs the real session's sockets live on (finding 50). <box dir>/home links to it.
HOMES=${XDG_CACHE_HOME:-$HOME/.cache}/omabox
# Saves (`omabox save`): box HOMEs kept on purpose, apart from HOMES, which `up` sweeps.
SAVES=${XDG_DATA_HOME:-$HOME/.local/share}/omabox/saves
POINTER=$ROOT/tools/pointer/omabox-pointer
KEYBOARD=$ROOT/tools/keyboard/omabox-keyboard
PEEK=$ROOT/tools/peek/omabox-peek
STILL=$ROOT/tools/still/omabox-still
WLFD=$ROOT/tools/wlfd/omabox-wlfd
RELAY=$ROOT/tools/relay/omabox-relay
AQUAMARINE=$ROOT/build/prefix/lib
PASS_KEY="SUPER + ALT + ESCAPE"
READY_TIMEOUT=${OMABOX_READY_TIMEOUT:-30}
HOST_SIG="" HOST_WL=""   # host_session's, never the caller's
PASS=()   # run --pass: the caller's variables for the command
ENVKV=()  # run --env-file: KEY=VAL entries for the command, before --pass (which wins)
# The fake display the agent guard (`omabox guard`) gives agents' shells (finding 65).
GUARD=omabox-guard

usage() {
  cat <<EOF
omabox: a contained, invisible Hyprland + Omarchy desktop for agents.

  omabox up [NAME] [--size WxH[@HZ]|host] [--interactive] [--plugin PATH|ID]... [--overlay DIR]...
            [--ro-bind DIR[:DEST]]... [--net isolated [--allow PORT,...]] [--env KEY=VAL]...
            [--idle DURATION] [--stock-bar] [--systemd] [--xwayland] [--no-shell] [--from SAVE]
            [--hyprland PATH]                            a Hyprland build of yours instead of the installed one
            [--workspace WS] [--confirm-close | --no-confirm-close]      (interactive)
            [--new]                                      a free name, box-1, box-2, ... (printed)
  omabox run [-b NAME] [-d [--wait]] [--pass VAR]... [--env-file FILE]... [UP OPTIONS] -- CMD [ARG...]
                                                         UP OPTIONS: up's, for a throwaway box only
  omabox shot [-b NAME] [-o FILE | FILE] [--window SEL | --active] [-g "X,Y WxH"] [--fit N]
  omabox windows [-b NAME] [--json]                      the box's windows, where they are, what covers them
  omabox keys [-b NAME] [--window SEL] [--wait] (COMBO | -t TEXT | --pass VAR | -s MS)...  e.g. super+space  -t hi  Return
  omabox click [-b NAME] [--window SEL [--no-raise] | --in SHOT] [--wait] X Y [left|right|middle] [--double]
  omabox drag [-b NAME] [--window SEL [--no-raise] | --in SHOT] [--wait | --shot FILE] X1 Y1 X2 Y2 [left|right|middle]
              [--steps 10] [--hold MS]                   press, move, hold, release
  omabox pointer [-b NAME] [--window SEL | --in SHOT] -- ARGS...  raw: move X Y, click/down/up [BTN], scroll DY, sleep MS
  omabox wait [-b NAME] [--timeout 10s] [--json] COND   until COND holds (exit 0), 124 if not in time
         COND: still [--quiet 300ms] [-g GEOM | --window SEL] [--strict] | change [-g GEOM | --window SEL]
               | window SEL [--gone | --focused] | layer NAMESPACE [--gone] | cmd -- CMD [ARG...]
  omabox hyprctl [-b NAME] ARGS...
  omabox peek [-b NAME] [--fps N] [--focus] [--workspace WS]  live view-only window of a box (workspace 9)
  omabox restart-shell [-b NAME]                         reload the Omarchy shell (after plugin edits)
  omabox mode [-b NAME] [WxH[@HZ]|host]                  show or change a headless box's screen mode
  omabox gpu [-b NAME] [SECONDS] [--json]                GPU engine time of this box's processes (default 5s)
  omabox env [NAME | -b NAME]                            exports for host-side Wayland tools
  omabox path [NAME | -b NAME]                           the box dir (HOME is <dir>/home)
  omabox down [NAME | -b NAME | --all]
  omabox ls [--json]
  omabox save SAVE [-b NAME] [--force]                   keep the box's HOME: up/run --from SAVE start from it
  omabox saves [--json] | saves rm SAVE...               the saves: list, delete
  omabox config [--json | KEY [VALUE | default]]         settings: workspace, confirm-close, bar-icon
  omabox guard [on|off [claude|codex]]                   the agent guard: show, add, remove
  omabox guard exec -- AGENT [ARG...]                    run any other agent under the guard
  omabox host -- CMD [ARG...]                            one command on your real desktop (when asked for)
  omabox broker [on|off]                                 let agents inside ai-jail drive their own boxes
  omabox --version

NAME defaults to \$OMABOX, else the current git repo's name, else "default". In an agent session
(Claude Code, Codex, \`guard exec\`) that name gets the session's id, myrepo-5cc72cdc: one box per
session, gone when its agent exits. OMABOX_SESSION= (empty) turns that off. A git worktree is named
by its own folder, so each worktree has its own box.
\`omabox run\` with no box up starts a throwaway box for the command, with the current repo
mounted as a discarded overlay (writes succeed, vanish at teardown), and tears it down after.
A box named with -b or \$OMABOX must be up: \`run\` fails rather than start a throwaway. With a
box up, \`run\` uses it and the repo is read-only there (tests that write into the tree: down first).
--net isolated --allow PORTS on a throwaway \`run\` keeps tests off your real local services.
Every box has its own network (pasta): by default the internet, the LAN and your servers. Across
the box boundary use 127.0.0.1, not localhost; a box's servers appear on your 127.0.0.1 about a
second after they listen. --net isolated: a loopback and the --allow ports only.
\`run\` starts the command with the box's environment, not yours: --pass VAR hands it one of your
variables (a password too: never on a command line); --env-file FILE hands it a file's KEY=VAL lines
(a dev.env: read as data, nothing expanded; --pass wins); \`keys --pass VAR\` types one (never \`-t\`
for a secret: the process list shows it). --env KEY=VAL is the box session's, on \`up\`.
--no-shell: Hyprland only, no Omarchy shell (faster; no bar, tray or notifications).
--hyprland PATH: the box runs that binary (its folder mounted read-only at its own path) with the
patched aquamarine, so a build must link the same libaquamarine soname (checked before the box
starts); hyprctl and hyprpm stay the installed ones (a warning when the versions differ). \`ls\` and
\`windows\` name it. Compositor logic runs for real (layouts, focus, input routing, the Lua config,
IPC, protocols); DRM/KMS, real monitors, HDR/VRR, multi-GPU, libinput with real devices and the
session/suspend/lock paths never run in a box.
SEL picks one window: active, its address (0x...), pid:N, class:RE, title:RE, initialClass:RE,
initialTitle:RE (any case), or a word (its class or the class's last part, nautilus for
org.gnome.Nautilus, or part of its title); repeat to narrow. None or
several is exit 2, with the candidates. \`shot --window\` (-w; --active is --window active) is the
window's own pixels, covered or on another workspace too; \`click --window\` takes the window's
coordinates and focuses it first when it is off screen or covered there (--no-raise refuses instead);
\`keys --window\` focuses it, then types. --fit N scales a shot's longest side down to N pixels.
-g "X,Y WxH" (or X,Y,W,H) crops: the screen's, or with --window the window's own coordinates.
A cropped or scaled shot says so on stderr: \`click --in SHOT X Y\` (and \`drag\`, \`pointer --in\`)
take that image's pixels (a window shot follows the window if it moved). Screen shots show the
pointer; window shots never do. -o makes the file's folder if it is missing.
\`wait still\`: nothing on screen changed for --quiet; a caret (4 px or thinner) and the cursor do not
count, and are said (--strict counts them). \`keys\`, \`click\` and \`run -d\` take --wait [--start 2s]
[--quiet 300ms] [--timeout 10s] [--json]: a change within --start (5s for run -d), then quiet.
Exit 0 satisfied, 124 not by --timeout (after --wait: the input WAS sent), 1 unknown (the box went
down, an interactive box's hidden window renders nothing): never 0 for what could not be seen.
Durations: 300ms, 2s, 1m; --timeout at most 10m. Waiting counts as using the box.
\$OMABOX_READY_TIMEOUT: seconds \`up\` waits for Hyprland and the shell (default 30).
Interactive boxes and peek windows open on workspace 9, without focus: \`omabox config workspace WS\`
(1-99, special = Omarchy's scratchpad on SUPER+S, special:NAME) or --workspace. A peek window shows
click, pointer and keys for ~3 s (a ring, key captions, --pass values as *); never the box's own frames.
Closing an interactive box's window ends the box; \`omabox config confirm-close on\` asks first (a
second close is a yes).
$PASS_KEY toggles sending SUPER keys to an interactive box.
A headless box goes down after \$OMABOX_IDLE (default 2h) with no omabox command against it, no
peek window and no \`omabox run\` still running; --idle 30m|2h|0 (never) per box. Interactive: never.
A \`run -d\` job is not activity: a server only polled over HTTP needs --idle 0 (or longer).
At --idle 0 a session's box still goes with its agent (\`ls\` says never); a box with another name
(-b NAME) stays.
Sizes: WxH is @60; \`host\` copies your focused monitor's size and refresh rate (scale stays 1).
Measure rendering cost with \`omabox gpu\` in a box whose mode matches your monitor.
The agent guard (opt-in) gives agents' shell commands (Claude Code, Codex) a display that does not
exist, so a window, hyprctl or grim outside a box fails instead of reaching your desktop; omabox
still works, and \`omabox host\` runs a command you asked for on the real desktop.
An agent inside ai-jail cannot enter a box: \`omabox broker on\` (a systemd user socket) lets its
omabox hand commands to omabox outside, which keeps the jail's boxes to what the jail has (its
project, its network or none) and to themselves. It prints the lines to add to ~/.ai-jail.
Crashes in a box skip the desktop's crash notifications (core limit 1 byte; raise it inside for a core).
A save keeps what a box's apps set up (signed in, a PIN, a library): the box HOME without .cache and
its logs, keyring included, paused for the copy. \`up --from\` starts with it, then seeds your Omarchy
look on top as for any box (theme, bar, terminals: today's, not the save's). Close an app first for a
clean save. Saves live in ~/.local/share/omabox/saves until \`saves rm\`.
EOF
}

die() { echo "omabox: $*" >&2; exit 1; }
optarg() { [ $# -ge 2 ] && [ -n "$2" ] || die "$1 needs a value"; }   # optarg "$@" before reading $2
say() { echo "omabox: $*" >&2; }

# --- settings ------------------------------------------------------------------------------------
# ~/.config/omabox/config, KEY=VALUE lines: what `omabox config` and the bar widget change (finding
# 70). A value that does not check out is ignored with a warning, never used.
CONFIG=$HOME/.config/omabox/config
CONF_KEYS=(workspace confirm-close bar-icon)
conf_default() { case $1 in workspace) echo 9 ;; confirm-close) echo off ;; bar-icon) echo always ;; esac; }
# A value for KEY, printed in its normal form, or a failure.
conf_check() {
  case $1 in
    workspace) ws_check "$2" ;;
    confirm-close) case $2 in on|true|yes|1) echo on ;; off|false|no|0) echo off ;; *) return 1 ;; esac ;;
    bar-icon) case $2 in auto|always) echo "$2" ;; *) return 1 ;; esac ;;
    *) return 1 ;;
  esac
}
# Where interactive and peek windows open: a workspace 1-99, `special` (Omarchy's scratchpad, which
# SUPER+S shows) or special:NAME. It goes into the host's Lua: nothing but these shapes passes.
ws_check() {
  case $1 in
    special) echo special:scratchpad ;;
    special:*) [[ ${1#special:} =~ ^[A-Za-z0-9_-]{1,32}$ ]] && echo "$1" ;;
    *) [[ $1 =~ ^[1-9][0-9]?$ ]] && echo "$1" ;;
  esac
}
ws_text() {
  case $1 in
    special:scratchpad) echo "the scratchpad (SUPER+S shows it)" ;;
    special:*) echo "special workspace ${1#special:}" ;;
    *) echo "workspace $1" ;;
  esac
}
conf_get() {
  local v=""
  [ -f "$CONFIG" ] && v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1 | sed 's/[[:space:]]*$//')
  if [ -n "$v" ]; then
    conf_check "$1" "$v" && return 0
    say "$CONFIG: ignoring $1=$v"
  fi
  conf_default "$1"
}
# Set KEY (or remove it: back to the default), keeping the rest of the file, comments included.
# Through a link to its target (a config kept in a dotfiles repo stays a link), one change at a time
# (the widget and the CLI may set at once).
conf_set() {
  mkdir -p "$(dirname "$CONFIG")"
  local file=$CONFIG lock tmp
  [ ! -L "$file" ] || file=$(readlink -f "$file")
  exec {lock}>"$(dirname "$CONFIG")/.config.lock"
  flock -w 10 "$lock" || true
  tmp=$(mktemp "$file.XXXXXX")
  [ -f "$file" ] && { grep -v "^[[:space:]]*$1[[:space:]]*=" "$file" > "$tmp" || true; }
  [ -z "${2:-}" ] || echo "$1=$2" >> "$tmp"
  mv "$tmp" "$file"
  exec {lock}>&-
}

# --- box selection -------------------------------------------------------------------------------

# Whether $OMABOX names a box. `omabox run` marks its commands with OMABOX=1 and OMABOX_NAME: that 1 is
# not a box named "1". A command under it that sets OMABOX=NAME does name one (issue #19).
env_names_box() { [ -n "${OMABOX:-}" ] && { [ "$OMABOX" != 1 ] || [ -z "${OMABOX_NAME:-}" ]; }; }

default_name() {
  local top base sid
  # A jailed caller's omabox worked its default out where it runs, in the jail (relay_call).
  if in_jail; then echo "${OMABOX_RELAY_DEFAULT:-default}"; return; fi
  if env_names_box; then echo "$OMABOX"; return; fi
  if top=$(git rev-parse --show-toplevel 2>/dev/null); then base=$(basename "$top"); else base=default; fi
  # An agent session gets a box of its own (finding 88): two agents in one repo would otherwise share
  # one, and one's `down` would end the other's work. The suffix survives select_box's 40-char cut.
  if sid=$(agent_session); then echo "$(printf '%s' "$base" | cut -c1-31)-$sid"; else echo "$base"; fi
}

# The agent session this command runs in, as 8 characters, or a failure outside one. Claude Code and
# Codex export their session's id to every shell command; `omabox guard exec` sets OMABOX_SESSION for
# other agents, and OMABOX_SESSION= (empty) opts out. The id's tail: Codex's is a UUIDv7, whose head is
# a timestamp that two sessions started in the same minute share.
AGENT_VARS=(OMABOX_SESSION CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID)
agent_var() {
  local v
  for v in "${AGENT_VARS[@]}"; do
    [ -n "${!v+x}" ] || continue
    [ -n "${!v}" ] || return 1
    echo "$v"; return 0
  done
  return 1
}
agent_session() {
  local v id; v=$(agent_var) || return 1
  id=$(printf '%s' "${!v}" | tr -cd 'A-Za-z0-9')
  [ ${#id} -ge 8 ] || return 1
  id=${id: -8}; echo "${id,,}"
}

# The agent's own process, as "PID START" (START: its start time, so a reused pid is not taken for it),
# or a failure (finding 93). Claude Code exports its pid as CLAUDE_PID; `guard exec` exports the pid it
# execs the agent as, OMABOX_AGENT_PID. Codex sets its session variable for its children only, so it is
# the nearest ancestor without it (compared by value: a `codex` started from another session's shell
# carries the outer id). OMABOX_SESSION set by hand, for a shell or one command, names no agent: that
# box only idles out. Neither does an agent in a pid namespace of its own (a sandbox), nor a pid this
# command does not descend from.
agent_proc() {
  local v pid=""
  v=$(agent_var) || return 1
  case $v in
    CLAUDE_CODE_SESSION_ID) pid=${CLAUDE_PID:-} ;;
    OMABOX_SESSION) pid=${OMABOX_AGENT_PID:-} ;;
    CODEX_THREAD_ID)
      # grep -z reads the NUL-separated file itself: `tr | grep -q` could lose a match under pipefail
      # (grep quits at it, and tr, with a large environment left to write, dies of SIGPIPE).
      pid=$$
      while [ "$pid" -gt 1 ] && grep -qzxF "$v=${!v}" "/proc/$pid/environ" 2>/dev/null; do
        pid=$(proc_ppid "$pid") || return 1
      done ;;
  esac
  [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] && [ -r "/proc/$pid/environ" ] && descends_from "$pid" || return 1
  # Gone meanwhile: no start time to record (with none, agent_alive would never find it gone).
  local start; start=$(proc_start "$pid") && [ -n "$start" ] || return 1
  echo "$pid $start"
}
# Whether this process is PID or runs under it.
descends_from() {
  local p=$$
  until [ "$p" = "$1" ]; do
    [ "$p" -gt 1 ] || return 1
    p=$(proc_ppid "$p") || return 1
  done
}
# Fields of /proc/PID/stat after the command name (which may hold spaces and parentheses). A pid only:
# an empty one would read /proc//stat, which is the system-wide /proc/stat.
proc_stat() {
  local s fields; [[ $1 =~ ^[0-9]+$ ]] && s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  read -ra fields <<<"${s##*) }"; echo "${fields[$2]}"
}
proc_ppid() { proc_stat "$1" 1; }
proc_start() { proc_stat "$1" 19; }

# Sets NAME and D (the box dir). Names end up in paths and window titles: keep them tame.
select_box() {
  NAME=${1:-$(default_name)}
  NAME=$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9_.-' '-' | cut -c1-40)
  [[ $NAME =~ ^[A-Za-z0-9] ]] || die "bad box name: $NAME"
  D=$BOXES/$NAME
  # A jailed agent drives only the boxes its jail started (finding 99): not the user's, nor another
  # jail's, which may see more than this one.
  if in_jail && [ -f "$D/box.json" ] && [ "$(meta jail)" != "$(jail_get .id)" ]; then
    die "box '$NAME' is not this jail's: an agent inside ai-jail drives only the boxes it started"
  fi
}
# Whether the box selected is the one this agent session's commands get by default (finding 88). A
# jailed agent's boxes go with its jail instead.
session_box() { ! in_jail && ! env_names_box && agent_session >/dev/null && [ "$NAME" = "$(select_box ""; echo "$NAME")" ]; }

# The box's PID 1 on the host, or nothing. Top-level boxes run inside pasta's pid namespace (Arch's
# pasta has no --no-pidns yet: UPSTREAM.md), so bwrap's child-pid is pasta's numbering: pasta_pid
# records the host one (and is asked again if `up` never got to it). A recorded pid is only the box's
# while it is still in the box's own pid namespace (box.json `pidns`, written by `up`): after the box
# died and the pid was reused, it is some other process of the user's, which `down` must not SIGKILL
# and `run` must not enter.
box_pid() {
  local pid=""
  if [ -f "$D/pasta.pid" ]; then
    pasta_pid && pid=$(cat "$D/pid" 2>/dev/null) || true
  else
    pid=$(jq -r '."child-pid" // empty' "$D/info.json" 2>/dev/null) || true
  fi
  [ -n "$pid" ] || return 0
  # From another user namespace (unshare -Ur, a sandbox that makes its own) a process of ours has an
  # unreadable ns: that is not a dead box (`up` would clear the live box's dir and orphan it), so it
  # is status 3, which box_alive stops on. A process that is not ours (its pid reused) is unreadable
  # too, and is not the box.
  local ns want
  ns=$(readlink "/proc/$pid/ns/pid" 2>/dev/null) || {
    [ "$(stat -c %u "/proc/$pid" 2>/dev/null)" != "$(id -u)" ] || return 3
    return 0
  }
  [ "$ns" != "$(readlink /proc/self/ns/pid)" ] || return 0
  want=$(meta pidns)
  [ -z "$want" ] || [ "$ns" = "$want" ] || return 0
  echo "$pid"
}
# Records the box's host pid in $D/pid, unless it is there already (box_pid then checks it is still the
# box's). Only through this box's own pasta: pasta never removes its pid file, and every box's PID 1 is
# pid 2 in its pasta's namespace, so a pasta.pid whose pid now belongs to another box's pasta would
# lead to that box's PID 1, which `down` would then SIGKILL.
pasta_pid() {
  local inner pasta bw p
  [ -s "$D/pid" ] && return 0
  inner=$(jq -r '."child-pid" // empty' "$D/info.json" 2>/dev/null) && [ -n "$inner" ] || return 1
  pasta=$(box_pasta) && bw=$(pgrep -P "$pasta" | head -1) || return 1
  for p in $(pgrep -P "$bw"); do   # pasta -> bwrap -> the box's PID 1, whose pid in pasta's ns is $inner
    [ "$(awk '/^NSpid:/ {print $3}' "/proc/$p/status" 2>/dev/null)" = "$inner" ] && { echo "$p" > "$D/pid"; return 0; }
  done
  return 1
}
# The pid in pasta.pid while it is still this box's pasta, or a failure: a pasta (its comm: pasta re-execs
# itself as passt.avx2 on most CPUs, and is non-dumpable, but comm stays readable) whose command line
# names this pid file. Neither alone: a copy of sleep can be called pasta, and any argv can hold a path.
box_pasta() {
  local pasta; pasta=$(cat "$D/pasta.pid" 2>/dev/null) && [ -n "$pasta" ] || return 1
  case $(cat "/proc/$pasta/comm" 2>/dev/null) in pasta|pasta.*|passt|passt.*) ;; *) return 1 ;; esac
  (tr '\0' ' ' < "/proc/$pasta/cmdline") 2>/dev/null | grep -Fq -- " -P $D/pasta.pid " || return 1
  echo "$pasta"
}
box_alive() {
  local pid rc=0; pid=$(box_pid) || rc=$?
  [ $rc != 3 ] || die "cannot tell whether box '$NAME' is up from this user namespace (a sandbox's?): run omabox outside it"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}
meta() { jq -r --arg k "$1" '.[$k] // empty' "$D/box.json" 2>/dev/null; }

need_box() {
  if box_alive; then touch "$D/used" 2>/dev/null || true; take_over && return 0; fi
  [ -f "$BOXES/.expired-$NAME" ] && die "box '$NAME' went down after $(cat "$BOXES/.expired-$NAME") idle (start it again with: omabox up $NAME; --idle 0 keeps it)"
  [ -f "$D/box.json" ] && die "box '$NAME' is dead (logs: $D/box.log $D/home/*.log; clear it with: omabox down $NAME)"
  local have; have=$(list_names | tr '\n' ' ')
  die "no box '$NAME' is up (${have:+up: $have; }start one with: omabox up $NAME)"
}

list_names() {
  local d id=""; ! in_jail || id=$(jail_get .id)
  for d in "$BOXES"/*/; do
    [ -f "$d/info.json" ] || continue
    [ -z "$id" ] || [ "$(jq -r '.jail // empty' "$d/box.json" 2>/dev/null)" = "$id" ] || continue
    basename "$d"
  done 2>/dev/null; true
}

# The box's processes, as host pids: everything in its pid namespace (a find pattern: pid:[N] is a glob).
box_pids() {
  local ns; ns=$(readlink "/proc/$(box_pid)/ns/pid") || return 1
  ns=${ns//\[/\\[}; ns=${ns//\]/\\]}
  # find fails on the /proc entries it cannot read (other users', processes gone meanwhile).
  { find /proc/[0-9]*/ns/pid -maxdepth 0 -lname "$ns" 2>/dev/null || true; } | cut -d/ -f3
}

# --- talking to a box ----------------------------------------------------------------------------

# One value from the environment Hyprland's children get (share/hyprland.lua writes it at start). The
# file is in the box's runtime dir, which the box can write: only a tame name is taken (finding 63).
box_env() {
  local v; v=$(tr '\0' '\n' < "$D/run/omabox.env" | sed -n "s/^$1=//p" | head -1)
  [[ $v =~ ^[A-Za-z0-9_.-]+$ ]] && echo "$v"
}

# Tools the box has at /opt/omabox/bin (bound read-only by `up`).
BOX_KEYBOARD=/opt/omabox/bin/omabox-keyboard
BOX_POINTER=/opt/omabox/bin/omabox-pointer
BOX_STILL=/opt/omabox/bin/omabox-still

# Run a tool against the box's compositor (grim, hyprctl, the keyboard and pointer), inside the box's
# mount namespace with a clean environment (finding 63). Its sockets live in the box's runtime dir,
# which the box can write: resolved from the host, a socket the box swapped for a symlink would send
# `keys`, `click` or `shot` to any compositor the host can reach, the user's included. Inside, every
# path resolves in the box's own view, where only the box is. (Also short enough for Hyprland's
# socket path, which from the host dir is past the 108-byte limit, finding 7.) stdin/stdout pass
# through: `grim -` writes the host's file.
on_box() {
  local pid wd sig
  pid=$(box_pid); [ -n "$pid" ] || die "box '$NAME' is not up"
  wd=$(box_env WAYLAND_DISPLAY) || die "box '$NAME': no WAYLAND_DISPLAY in its omabox.env"
  sig=$(box_env HYPRLAND_INSTANCE_SIGNATURE) || die "box '$NAME': no HYPRLAND_INSTANCE_SIGNATURE in its omabox.env"
  nsenter -t "$pid" -U -m --preserve-credentials -- env -i PATH=/usr/bin XDG_RUNTIME_DIR="/run/user/$UID" \
    WAYLAND_DISPLAY="$wd" HYPRLAND_INSTANCE_SIGNATURE="$sig" LANG="${LANG:-C.UTF-8}" "$@"
}

# run --env-file FILE (#30): its KEY=VAL lines, NUL-separated. `export ` and # comment lines are
# allowed, and a value in matching quotes loses them; nothing is expanded (the file is data, not a
# script) and a # after a value is part of it. A bad line fails with its number, never its text.
envfile_read() {
  local f=$1 line n=0 k v
  [ -f "$f" ] && [ -r "$f" ] || die "--env-file: cannot read $f"
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1)) line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || die "--env-file $f: line $n is not KEY=VALUE"
    k=${BASH_REMATCH[2]} v=${BASH_REMATCH[3]}
    if [[ $v =~ ^\"(.*)\"$ || $v =~ ^\'(.*)\'$ ]]; then v=${BASH_REMATCH[1]}; fi
    printf '%s=%s\0' "$k" "$v"
  done < "$f"
}

# A variable of the caller's as it was when omabox started (run --pass): from /proc, not ${!NAME},
# which would give omabox's own ROOT, D or NAME instead of the caller's. Fails when it is not there.
caller_env() {
  local kv k=$1
  in_jail && k=OMABOX_RELAY_PASS_$1   # a jailed caller's, sent by its omabox (relay_call)
  while IFS= read -r -d '' kv; do
    [[ $kv == "$k="* ]] && { printf '%s' "${kv#*=}"; return 0; }
  done < "/proc/$$/environ"
  return 1
}

# The caller's PATH without the guard's xdg-open (finding 92): in a box, and for `host`, links open.
# Any checkout's: a hook written from another clone or worktree names its own. A PATH entry may end in /.
caller_path() {
  local d out=() dirs p=${PATH:-}
  ! in_jail || p=${OMABOX_RELAY_PATH:-}   # a jailed caller's, not the broker's own
  IFS=: read -ra dirs <<<"$p"
  for d in "${dirs[@]}"; do case $d in */share/guard|*/share/guard/) ;; *) out+=("$d") ;; esac; done
  local IFS=:; printf '%s' "${out[*]}"
}

# Run a command inside the box's namespaces (unprivileged: we own its user namespace) with the
# session environment. Working directory: $PWD when it is the same directory in the box (a mount of
# it: same device and inode, or an overlay of it), else the box HOME. Not just any dir of that name:
# /home/USER and /tmp exist in a box too, empty or the box's own (finding 63).
# PATH (findings 47, 57): omabox's stand-ins, the box HOME's ~/.local/bin (stubs), then the caller's
# PATH in its order (so the same node or python wins as on the host), keeping only absolute dirs the
# box can see, then the rest of the box's own: the order the session itself has.
box_exec() {
  local env=() cwd=/home/sbx pid
  pid=$(box_pid); [ -n "$pid" ] || die "box '$NAME' is not up"
  mapfile -d '' env < "$D/run/omabox.env"
  local here there wd=$PWD
  ! in_jail || wd=$(jail_get '.cwd // empty')   # a jailed caller's, when its jail and the host agree on it
  if [ -n "$wd" ]; then
    here=$(stat -c %d:%i -- "$wd" 2>/dev/null) || here=""
    there=$(nsenter -t "$pid" -U -m --preserve-credentials stat -c %d:%i -- "$wd" 2>/dev/null) || there=""
    if [ -n "$here" ] && [ "$here" = "$there" ]; then cwd=$wd
    elif [ -n "$there" ] && jq -e --arg p "$wd/" 'any(.overlays[]?; . as $o | $p | startswith($o + "/"))' "$D/box.json" >/dev/null 2>&1; then cwd=$wd
    fi
  fi
  # The box's own network namespace (every box has one since finding 89), so its local services are
  # reachable. A box started before that shares the host's, which is not ours to join (EPERM).
  local ns=(-U -m -p -u -i)
  [ "$(readlink "/proc/$pid/ns/net")" = "$(readlink /proc/self/ns/net)" ] || ns+=(-n)
  # `run --pass VAR` (finding 66): the caller's values go through a pipe (printf is a builtin: no
  # argv), never on a command line, where the process list would show a password to every user.
  # --env-file's entries first: a --pass of the same name comes later and wins.
  local pass=() pfd
  if [ ${#PASS[@]} -gt 0 ] || [ ${#ENVKV[@]} -gt 0 ]; then
    exec {pfd}< <(for kv in "${ENVKV[@]}"; do printf '%s\0' "$kv"; done
      for v in "${PASS[@]}"; do printf '%s=%s\0' "$v" "$(caller_env "$v")"; done)
    pass=(OMABOX_PASS_FD="$pfd")
  fi
  # shellcheck disable=SC2016 # $1/$@ belong to the inner bash
  nocore nsenter -t "$pid" "${ns[@]}" --preserve-credentials -- \
    env -i "${env[@]}" OMABOX=1 OMABOX_NAME="$NAME" OMABOX_CALLER_PATH="$(caller_path)" "${pass[@]}" bash -c '
      if [ -n "${OMABOX_PASS_FD:-}" ]; then
        while IFS= read -r -d "" kv <&"$OMABOX_PASS_FD"; do export "$kv"; done
        eval "exec $OMABOX_PASS_FD<&-"; unset OMABOX_PASS_FD
      fi
      cd "$1" && shift
      p=/opt/omabox/share/bin:/home/sbx/.local/bin; set -f; IFS=:
      for d in $OMABOX_CALLER_PATH $PATH; do
        case $d in /*) ;; *) continue ;; esac
        case ":$p:" in *":$d:"*) ;; *) [ -d "$d" ] && p=$p:$d ;; esac
      done
      unset IFS OMABOX_CALLER_PATH; set +f; PATH=$p exec -- "$@"' bash "$cwd" "$@"
  local rc=$?
  [ ${#pass[@]} -eq 0 ] || exec {pfd}<&-
  return $rc
}

# Processes in a box, and what `run` starts there, get a core limit of exactly 1 byte: the kernel then
# skips the core helper (systemd-coredump), so a crash in a box (an app under test, a Qt program with
# no display) never becomes a "Process crashed" notification on the user's desktop through
# omarchy-crash-watch (finding 67). The hard limit stays: `ulimit -c unlimited` inside gets cores back.
# With a hard limit of 0 there are no cores to skip.
nocore() {
  if [ "$(ulimit -Hc)" = 0 ]; then "$@"; else prlimit --core=1: "$@"; fi
}

# The user's Hyprland session, for what omabox does on the host on purpose (interactive windows,
# peek, --size host): sets HOST_SIG and HOST_WL (its Wayland socket, a path). The environment's
# session when it names a live one, else the only one in the runtime dir: so omabox still reaches the
# desktop from a shell whose display was taken away on purpose (the agent guard, finding 65). With
# several and none named, it refuses rather than guess.
host_session() {
  [ -z "${HOST_SIG:-}" ] || return 0
  local sig=${HYPRLAND_INSTANCE_SIGNATURE:-} all
  all=$(HYPRLAND_INSTANCE_SIGNATURE=$GUARD hyprctl -j instances 2>/dev/null) && jq -e 'type == "array"' <<<"$all" >/dev/null 2>&1 || all='[]'
  # A signature left from a session that crashed (a tmux shell outlived it) names a dir whose socket
  # file stays: only a live instance counts.
  if [ -z "$sig" ] || ! jq -e --arg s "$sig" 'any(.[]; .instance == $s)' <<<"$all" >/dev/null; then
    case $(jq length <<<"$all") in
      1) sig=$(jq -r '.[0].instance' <<<"$all") ;;
      0) die "no Hyprland session in $XDG_RUNTIME_DIR/hypr: this needs the user's desktop" ;;
      *) die "several Hyprland sessions: set HYPRLAND_INSTANCE_SIGNATURE to one of $(jq -r 'map(.instance) | join(", ")' <<<"$all")" ;;
    esac
  fi
  local wl; wl=$(jq -r --arg s "$sig" 'first(.[] | select(.instance == $s) | .wl_socket) // empty' <<<"$all")
  [[ $wl =~ ^[A-Za-z0-9._-]+$ ]] && [ -S "$XDG_RUNTIME_DIR/$wl" ] || die "Hyprland session $sig: no Wayland socket found"
  HOST_SIG=$sig HOST_WL=$XDG_RUNTIME_DIR/$wl
}

# hyprctl on the user's session (host_session), wherever this shell's display points.
host_hyprctl() {
  host_session
  HYPRLAND_INSTANCE_SIGNATURE=$HOST_SIG hyprctl "$@"
}

# A screen mode for a headless box: WxH (@60), WxH@HZ, or `host` for the user's focused monitor
# (a read-only hyprctl on the host; scale stays 1). Prints WxH@HZ.
parse_mode() {
  local m=$1
  if [ "$m" = host ]; then
    host_session
    m=$(host_hyprctl -j monitors | jq -r 'map(select(.focused)) | .[0] // empty |
      "\(.width)x\(.height)@\(.refreshRate * 100 | round / 100)"') && [ -n "$m" ] || die "no focused monitor on the host"
  fi
  [[ $m =~ ^[1-9][0-9]*x[1-9][0-9]*(@[0-9]+(\.[0-9]+)?)?$ ]] || die "a size is WxH, WxH@HZ or host, got $1"
  [[ $m == *@* ]] || m=$m@60
  # The rate as box_screen prints it (60.0 and 060 are 60), so `mode` can compare; never 0.
  local hz; hz=$(awk -v h="${m#*@}" 'BEGIN { h = int(h * 100 + 0.5) / 100; if (h <= 0) exit 1; printf "%g", h }') ||
    die "a refresh rate is above 0, got ${m#*@}"
  echo "${m%@*}@$hz"
}

# The layout's size, for mapping absolute pointer coordinates.
# (Under set -e a caller's `x=$(extent)` would end omabox without a word when the box's Hyprland
# does not answer: extent says so and fails.)
extent() {
  on_box hyprctl -j monitors 2>/dev/null | jq -er '[.[] | select(.disabled | not)] |
    "\(map(.x + (.width / .scale)) | max | floor)x\(map(.y + (.height / .scale)) | max | floor)"' 2>/dev/null ||
    die "cannot read the screen size of box '$NAME' (its Hyprland did not answer)"
}

# A box that ended while `up` waited for it, with Hyprland's last line when it logged one (an interactive
# box's: an abort such as finding 95's `CBackend::create() failed!`).
died_starting() {
  local last; last=$(grep -v '^[[:space:]]*$' "$D/home/hyprland.log" 2>/dev/null | tail -n 1 | sed 's/^[[:space:]]*//') || true
  die "box '$NAME' died while starting${last:+ (Hyprland: $last)}; logs: $D/home/*.log $D/box.log"
}

# Until the box's Hyprland is up (share/hyprland.lua writes omabox.env once it is).
wait_hyprland() {
  local deadline=$((SECONDS + READY_TIMEOUT))
  until [ -s "$D/run/omabox.env" ]; do
    box_alive || died_starting
    [ $SECONDS -lt $deadline ] || die "Hyprland not up after ${READY_TIMEOUT}s; logs: $D/home/*.log"
    sleep 0.1
  done
}

wait_ready() {
  local want_shell=$1 deadline=$((SECONDS + READY_TIMEOUT))
  wait_hyprland
  if [ "$(meta wayland_screen)" = true ]; then
    # labwc's initial xdg configure can replace the requested mode with 1280x720. Reapply it
    # after Hyprland starts, when the parent headless output already has the requested size.
    local size; size=$(meta size)
    on_box hyprctl eval "hl.monitor({ output = 'WAYLAND-1', mode = '$size', position = '0x0', scale = 1 })" >/dev/null ||
      die "could not set the NVIDIA box screen to $size"
    local screen
    until screen=$(box_screen) && [ "${screen#* }" = "$size" ]; do
      [ $SECONDS -lt $deadline ] || die "NVIDIA box screen stayed at ${screen#* }, asked for $size"
      sleep 0.1
    done
  fi
  [ "$want_shell" = 1 ] || return 0
  # The bar on screen; only wait for the tray watcher when the user's layout has a tray.
  local tray_expected=0
  jq -e '[.bar.layout[][]? | if type == "object" then .id else . end] | index("omarchy.tray") != null' \
    "$D/home/.config/omarchy/shell.json" >/dev/null && tray_expected=1
  until on_box hyprctl -j layers 2>/dev/null | grep -q '"omarchy-bar"' &&
        { [ "$tray_expected" = 0 ] || box_exec busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1; }; do
    box_alive || died_starting
    [ $SECONDS -lt $deadline ] || die "shell not ready after ${READY_TIMEOUT}s; see $D/home/shell.log"
    sleep 0.1
  done
  # And the notification server (the built-in one, or a mounted plugin's: every box has one, finding
  # 42), which registers up to ~3 s after the bar: a `notify-send` right after `up` failed with
  # ServiceUnknown (finding 62). A server that never comes is a warning, not a failed box.
  local nd=$((SECONDS + 5))
  # (NameHasOwner: `busctl status` exits 0 for a name nobody owns yet.)
  until [ "$(box_exec busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
           NameHasOwner s org.freedesktop.Notifications 2>/dev/null)" = "b true" ]; do
    [ $SECONDS -lt $nd ] || { say "no notification server on the box's bus yet; see $D/home/shell.log"; break; }
    sleep 0.1
  done
  # The bar paints its widgets ~150 ms after it maps and animates in for ~500 ms more: wait until its
  # pixels hold still (3 identical captures), so the first screenshot shows a finished bar. Not for
  # interactive boxes: they are for the user's eyes, and a hidden one draws only at the host's
  # render_unfocused_fps (before drawn_hidden, not at all: screencopy never returned).
  [ "$(meta mode)" = interactive ] && return 0
  local geom last="" now same=0
  geom=$(on_box hyprctl -j layers | jq -r 'first(.. | objects | select(.namespace? == "omarchy-bar")) | "\(.x),\(.y) \(.w)x\(.h)"')
  while [ $same -lt 3 ] && [ $SECONDS -lt $deadline ]; do
    now=$(on_box timeout 2 grim -g "$geom" - 2>/dev/null | md5sum) || now=""   # a missed frame: try again
    if [ "$now" = "$last" ]; then same=$((same + 1)); else same=0; last=$now; fi
    sleep 0.1
  done
}

# --- up ------------------------------------------------------------------------------------------

# The GPU render node the box renders with: $OMABOX_RENDER_NODE, else the first usable one. Only ever a
# render node (renderD*), never a card node: that is the seat (finding 5).
render_node() {
  local n=${OMABOX_RENDER_NODE:-}
  if [ -z "$n" ]; then
    for n in /dev/dri/renderD*; do [ -r "$n" ] && [ -w "$n" ] && break; n=""; done
  fi
  [[ $n =~ ^/dev/dri/renderD[0-9]+$ ]] && [ -r "$n" ] && [ -w "$n" ] ||
    die "no usable GPU render node (/dev/dri/renderD*); set OMABOX_RENDER_NODE"
  echo "$n"
}

# Every usable render node, for an interactive box: its Hyprland renders on the GPU the desktop's
# compositor names (aquamarine's Wayland backend opens the parent's dmabuf main device), which is not
# necessarily render_node's, so the box gets them all (finding 95). Still render nodes only.
render_nodes() {
  local n
  for n in /dev/dri/renderD*; do [ -r "$n" ] && [ -w "$n" ] && echo "$n"; done
  return 0
}

# The kernel driver behind a render node: amdgpu, i915, xe, nvidia, ...
render_driver() { basename "$(readlink -f "/sys/class/drm/${1##*/}/device/driver")"; }

# Match the selected render node to NVIDIA's userspace device node. Never expose a DRM card.
nvidia_device() {
  local render=$1 slot info minor
  slot=$(basename "$(readlink -f "/sys/class/drm/${render##*/}/device")")
  info=/proc/driver/nvidia/gpus/$slot/information
  [ -r "$info" ] || die "NVIDIA GPU $slot has no $info"
  minor=$(awk -F: '/^Device Minor:/ {gsub(/[[:space:]]/, "", $2); print $2}' "$info")
  [[ $minor =~ ^[0-9]+$ ]] && [ -c "/dev/nvidia$minor" ] && [ -c /dev/nvidiactl ] ||
    die "NVIDIA GPU $slot has no usable /dev/nvidia$minor or /dev/nvidiactl"
  echo "/dev/nvidia$minor"
}

# Resolve --plugin PATH|ID to "id<TAB>realpath".
resolve_plugin() {
  local p=$1 dir id
  if [ -f "$p/manifest.json" ]; then dir=$(readlink -f "$p")
  elif [ -f "$HOME/.config/omarchy/plugins/$p/manifest.json" ]; then dir=$(readlink -f "$HOME/.config/omarchy/plugins/$p")
  else die "plugin not found: $p (a plugin dir with manifest.json, or an id under ~/.config/omarchy/plugins)"
  fi
  id=$(jq -r '.id // empty' "$dir/manifest.json")
  [ -n "$id" ] || die "no id in $dir/manifest.json"
  printf '%s\t%s\n' "$id" "$dir"
}

# The box's fake HOME: the user's Omarchy look, no secrets (never api-keys.env, keyrings, tokens).
# shell.json keeps the user's bar settings but only the built-in widgets plus the plugins mounted
# into this box, each enabled where its manifest says it belongs. --stock-bar starts from Omarchy's
# default shell.json instead, without the user's shell.toml: the bar most people have (finding 60). Idle times out after ~11 days
# (no screensaver or lock without real input, finding 10) while Stay Awake still reads off (51).
seed_home() {
  local h=$D/home state=$HOME/.local/state/omarchy/current bg id dir kinds section
  # First the HOME a new Omarchy user starts with (/etc/skel, finding 69): Omarchy's configs, desktop
  # entries, menu extension, toggles, migrations marked done. Not nvim's 85 MB of plugins, nor the
  # XDG autostart entries (what starts in a box is omabox's choice). The user's look goes on top.
  # A HOME from a save (`up --from`) has had it since that box: the apps' configs there are the save's.
  if [ -z "${FROM:-}" ] && [ -d /etc/skel/.config/omarchy ]; then
    tar -C /etc/skel --exclude=./.local/share/nvim --exclude=./.config/autostart -cf - . | tar -C "$h" -xf -
  fi
  mkdir -p "$h/.config/omarchy/plugins" "$h/.config/omabox" "$h/.local/state/omarchy/current" "$h/.local/state/omarchy/indicators"
  # The bus watches only the service dirs that exist when it starts: one made later lists its services
  # after their first activation (finding 87).
  mkdir -p "$h/.local/share/dbus-1/services"
  local shell_json=$HOME/.config/omarchy/shell.json
  if [ "$STOCK_BAR" = 1 ]; then
    shell_json=/usr/share/omarchy/config/omarchy/shell.json
    [ -f "$shell_json" ] || die "--stock-bar: no $shell_json in this Omarchy"
  else
    cp "$HOME/.config/omarchy/shell.toml" "$h/.config/omarchy/" 2>/dev/null || true
  fi
  local ids; ids=$(printf '%s\n' "${PLUGINS[@]}" | cut -f1 | jq -R . | jq -s .)
  # A user who swapped the built-in notifications for a plugin (e.g. njpatel.omapager) has it disabled, and that
  # plugin is not in the box: turn the built-in back on unless a mounted plugin serves them itself.
  local notify=true p
  for p in "${PLUGINS[@]}"; do grep -rqs --include='*.qml' NotificationServer "${p#*$'\t'}" && notify=false; done
  jq --argjson keep "$ids" --argjson notify $notify '
      def keep: (if type == "object" then .id else . end) as $i | ($i | startswith("omarchy.")) or ($keep | index($i));
      if $notify and .disabledPlugins then .disabledPlugins -= ["omarchy.notifications"] else . end
      | .idle = {screensaver: 1000000, lock: 1000000}
      | if (.bar.layout? | type) == "object" then .bar.layout |= map_values(map(select(keep))) else . end
      | if .plugins then .plugins |= map(select(keep)) else . end
      | (.bar.centerAnchor? // "") as $a
      | if $a != "" and (($a | startswith("omarchy.")) or ($keep | index($a)) | not)
        then del(.bar.centerAnchor) else . end' \
    "$shell_json" > "$h/.config/omarchy/shell.json" 2>/dev/null ||
    echo '{"version":1,"idle":{"screensaver":1000000,"lock":1000000}}' > "$h/.config/omarchy/shell.json"
  for p in "${PLUGINS[@]}"; do
    id=${p%%$'\t'*}; dir=${p#*$'\t'}
    kinds=$(jq -c '.kinds // []' "$dir/manifest.json")
    section=$(jq -r '.barWidget.defaultSection // "center"' "$dir/manifest.json")
    jq --arg id "$id" --arg sec "$section" --argjson kinds "$kinds" '
        def ids: [(.bar.layout // {})[]?[]? | if type == "object" then .id else . end] + [(.plugins // [])[].id];
        if ($kinds | index("bar")) then .bar.id = $id
        elif (ids | index($id)) then .
        elif ($kinds | index("bar-widget")) then .bar.layout[$sec] = ((.bar.layout[$sec] // []) + [{id: $id}])
        else .plugins = ((.plugins // []) + [{id: $id}]) end' \
      "$h/.config/omarchy/shell.json" > "$h/.config/omarchy/shell.json.new"
    mv "$h/.config/omarchy/shell.json.new" "$h/.config/omarchy/shell.json"
  done
  rm -rf "$h/.local/state/omarchy/current/theme"   # a save's: cp would copy into it
  cp -rL "$state/theme" "$h/.local/state/omarchy/current/theme"
  cp "$state/theme.name" "$h/.local/state/omarchy/current/" 2>/dev/null || true
  if bg=$(readlink "$state/background"); then
    ln -sfn "/home/sbx/.local/state/omarchy/current/theme/${bg#*/current/theme/}" "$h/.local/state/omarchy/current/background"
  fi
  # The rest of the user's look (finding 69), none of it secret: terminal configs (they include the
  # theme's colours) and the terminal choice, branding (About sizes its window from about.txt), the
  # menu extension, custom themes (the theme picker), Hyprland toggles. Never ~/.config/omarchy
  # wholesale: api-keys.env lives there, and hooks are the user's scripts.
  for dir in foot alacritty ghostty kitty; do seed_copy "$HOME/.config/$dir" "$h/.config/$dir"; done
  cp "$HOME/.config/"*xdg-terminals.list "$h/.config/" 2>/dev/null || true
  for dir in branding extensions; do seed_copy "$HOME/.config/omarchy/$dir" "$h/.config/omarchy/$dir"; done
  # Each theme on its own: one linked in from the repo it is developed in is followed that far.
  for dir in "$HOME/.config/omarchy/themes"/*/; do
    [ -d "$dir" ] && seed_copy "$dir" "$h/.config/omarchy/themes/$(basename "$dir")"
  done
  mkdir -p "$h/.local/state/omarchy/toggles"
  seed_copy "$HOME/.local/state/omarchy/toggles/hypr" "$h/.local/state/omarchy/toggles/hypr"
  # Without /etc/skel (an older Omarchy), at least the desktop entries: foot's X-TerminalArgAppId is
  # what makes xdg-terminal-exec pass --app-id, which Omarchy's window rules match (About's float).
  if [ ! -d "$h/.local/share/applications" ] && [ -d /usr/share/omarchy/applications ]; then
    mkdir -p "$h/.local/share/applications"
    cp /usr/share/omarchy/applications/*.desktop "$h/.local/share/applications/" 2>/dev/null || true
  fi
  # Git's identity only (finding 48): commits and release dry-runs need one. Never the rest of the
  # user's git config (credential helpers, tokens in URLs). A value that is not set is skipped, not a
  # failure that ends `up` under set -e (finding 91); from /, so a broken repo in $PWD cannot fail it.
  local key val
  for key in user.name user.email; do
    val=$(git -C / config --global "$key" 2>/dev/null) || continue
    git -C / config --file "$h/.gitconfig" "$key" "$val"
  done
}

# Copy one of the user's dirs into the box HOME (seed_home). The dir itself may be a link (dotfiles), but
# links inside it stay links, to host paths the box does not have, instead of bringing in what they
# point at (finding 74: a theme linked from its repo brought its .env and .git/config, a link to
# api-keys.env the keys). No hidden files or node_modules, and nothing refuse_src keeps out of a mount.
# seed_copy SRC DEST
seed_copy() {
  local src; src=$(readlink -f -- "$1" 2>/dev/null) && [ -d "$src" ] || return 0
  ! refuse_src "$src" >/dev/null || return 0
  mkdir -p "$2"
  (
    shopt -s nullglob; cd "$src" || exit 0
    set -- *; [ $# -gt 0 ] || exit 0
    tar --exclude='.[!.]*' --exclude=node_modules --exclude=api-keys.env -cf - -- "$@"
  ) 2>/dev/null | tar -C "$2" -xf - 2>/dev/null || true
}

# A read-only mount spec, DIR or DIR:DEST (DEST absolute, e.g. ~/nas:/mnt/nas to test path mapping):
# prints "src<TAB>dest" (both resolved), or fails if DIR does not exist.
robind_spec() {
  local src=$1 dest=""
  if [[ $1 == *:/* ]]; then src=${1%%:/*}; dest=/${1#*:/}; fi
  src=${src/#\~/$HOME}
  [ -e "$src" ] || return 1
  src=$(readlink -f -- "$src")
  [ -z "$dest" ] || dest=$(realpath -m -- "$dest")   # //usr and /a/../usr are /usr
  printf '%s\t%s\n' "$src" "${dest:-$src}"
}

# Why a host path must not go into a box (prints the reason), or nothing (fails) when it may (finding
# 63). Read-only mounts, overlays and plugin dirs are files the box's code can read, and sockets it can
# connect() to whatever the network mode. Refused: anything that contains HOME, ~/.config/omarchy
# (api-keys.env) or /tmp; anything inside or containing the secret stores, the runtime dir, /run, the
# kernel's trees, or /tmp's socket dirs (X11, tmux, ssh-agent). A repo in /tmp or a plugin under
# ~/.config/omarchy/plugins is fine.
refuse_src() {
  local s x; s=$(readlink -f -- "$1" 2>/dev/null) || s=$1; s=${s%/}/
  for x in "$HOME" "$HOME/.config/omarchy" /tmp; do
    x=${x%/}/
    case "$x" in "$s"*) echo "it contains $x"; return 0 ;; esac
  done
  for x in "$HOME/.ssh" "$HOME/.gnupg" "$HOME/.local/share/keyrings" "$HOME/.password-store" \
           "$HOME/.aws" "$HOME/.kube" "$HOME/.docker" "$HOME/.netrc" \
           "${XDG_RUNTIME_DIR:-/run/user/$UID}" /run /dev /proc /sys /tmp/.X11-unix /tmp/.ICE-unix \
           /tmp/tmux-* /tmp/ssh-* /tmp/gpg-*; do
    [[ $x == *\** ]] && continue   # a glob that matched nothing
    x=${x%/}/
    case "$s" in "$x"*) echo "it is inside $x (secrets or live sockets)"; return 0 ;; esac
    case "$x" in "$s"*) echo "it contains $x (secrets or live sockets)"; return 0 ;; esac
  done
  return 1
}

# Why a path inside the box must not be mounted over (prints the reason), or fails when it may: the
# system dirs, the runtime dir, and omabox's own mounts or anything above them. Inside the box's /tmp
# (its own tmpfs) is fine, so a repo in /tmp mounts at its own path; /tmp itself and Xwayland's socket
# dirs are not.
refuse_dest() {
  local d=${1%/}/ x
  case "$d" in
    /|/usr/*|/etc/*|/proc/*|/dev/*|/sys/*|/run/*|/bin/*|/lib/*|/lib64/*|/tmp/|/tmp/.X11-unix/*|/tmp/.ICE-unix/*|/opt/omabox/*|/home/sbx/*)
      echo "that is the box's own system, runtime dir, /tmp or HOME"; return 0 ;;
  esac
  for x in /home/sbx/ /opt/omabox/ /tmp/; do
    case "$x" in "$d"*) echo "it would hide $x"; return 0 ;; esac
  done
  return 1
}

# What `up` says of a box that is up already, which counts as use.
up_already() {
  touch "$D/used" 2>/dev/null || true
  say "box '$NAME' is already up (options ignored; omabox down $NAME to change them)"
}

cmd_up() {
  STOCK_BAR=0
  local systemd=0 owner=""
  local size=1920x1080 interactive=0 xwayland=0 shell=1 name="" net=connected allow="" idle=${OMABOX_IDLE:-2h}
  local overlays=() robinds=() plugin_args=() envs=() spec why ws="" confirm="" new=0 net_set=0 hyprland="" hypr_bind=1
  FROM=""
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      --size) optarg "$@"; size=$2; shift ;;
      --workspace) optarg "$@"; ws=$(ws_check "$2") || die "--workspace: 1-99, special (the scratchpad, SUPER+S) or special:NAME, got $2"; shift ;;
      --new) new=1 ;;
      --confirm-close) confirm=on ;;
      --no-confirm-close) confirm=off ;;
      --interactive|-i) interactive=1 ;;
      --plugin) optarg "$@"; plugin_args+=("$2"); shift ;;
      --overlay) optarg "$@"; [ -d "$2" ] || die "--overlay: no such directory: $2"; overlays+=("$(readlink -f -- "$2")"); shift ;;
      --ro-bind) optarg "$@"; spec=$(robind_spec "$2") || die "--ro-bind: no such path: ${2%%:/*}"; robinds+=("$spec"); shift ;;
      --net) optarg "$@"; net=$2; net_set=1; shift ;;
      --allow) optarg "$@"; allow=$2; shift ;;
      --env) optarg "$@"; [[ $2 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "--env wants KEY=VAL, got $2"; envs+=(--setenv "${2%%=*}" "${2#*=}"); shift ;;
      --idle) optarg "$@"; idle=$2; shift ;;
      --from) optarg "$@"; FROM=$2; shift ;;
      --hyprland) optarg "$@"; hyprland=$(hypr_bin "$2") || exit 1; shift ;;
      --owner) optarg "$@"; owner=$2; shift ;;   # internal: `run`'s throwaway box goes when this pid does
      --stock-bar) STOCK_BAR=1 ;;
      --systemd) systemd=1 ;;
      --xwayland) xwayland=1 ;;
      --no-shell) shell=0 ;;
      -h|--help) usage; return ;;
      -*) die "up: unknown option $1" ;;
      *) [ -z "$name" ] || die "up: one box name, got $name and $1"; name=$1 ;;
    esac
    shift
  done
  if [ $new = 1 ]; then
    # A name no box has (finding 73): box-1, box-2, ... The choice holds a lock until the box's dir
    # exists, so two at once (a double click in the widget) never pick the same one. Printed on stdout.
    [ -z "$name" ] || die "up: --new picks the name itself, got $name too"
    mkdir -p "$BOXES"
    exec {NEWLOCK}>"$BOXES/.lock-new"
    flock -w 60 "$NEWLOCK" || die "another up --new is still choosing a name; try again"
    local n=1; while [ -e "$BOXES/box-$n" ]; do n=$((n + 1)); done
    name=box-$n
  fi
  select_box "$name"
  # The box an agent session gets by default goes when the agent does (finding 93), or when idle; so
  # does that name given with -b (it is the same box). Not an interactive box (the user's window), a
  # throwaway, or any box while OMABOX is set (it names the box instead of the session).
  local agent=""
  if [ $interactive = 0 ] && [ -z "$owner" ] && session_box; then
    agent=$(agent_proc) || agent=""
  fi
  # A jailed agent's box goes with its jail (the jail's bwrap), and sees no more than the jail does
  # (finding 99): driving a box is running code in it, so the box must not be a way out of the jail.
  if in_jail; then
    [ $interactive = 0 ] || die "up: a window on the user's desktop is not for an agent inside ai-jail (headless boxes only)"
    [ -n "$owner" ] || agent=$(jail_get .id)
    # Saves are the user's (finding 100): a keyring with their secrets, an app signed in as them.
    [ -z "$FROM" ] || die "up: saves are the user's (keyring secrets, apps signed in), not for an agent inside ai-jail"
    if [ "$(jail_get .net)" != true ]; then
      [ $net_set = 0 ] || [ "$net" = isolated ] || die "up: this jail has no network, so its boxes have none either (--net isolated, the default here)"
      [ -z "$allow" ] || die "up: this jail has no network, so its boxes reach no host port (no --allow)"
      net=isolated
    fi
    local x
    for x in "${overlays[@]}" "${plugin_args[@]}"; do
      jail_root "$x" >/dev/null || die "up: $x is not a folder this jail was given whole (its project, or one of its maps), so it does not go into the box"
    done
    for x in "${robinds[@]}"; do
      jail_root "${x%%$'\t'*}" >/dev/null || die "up: ${x%%$'\t'*} is not a folder this jail was given whole (its project, or one of its maps), so it does not go into the box"
    done
    # --hyprland's folder is mounted as --ro-bind's are: one of the jail's folders, whole. A build
    # inside the jail's project needs no mount of its own: the project is in the box, and the path
    # resolves there, in the box's view, not the host's.
    if [ -n "$hyprland" ] && ! jail_root "${hyprland%/*}" >/dev/null; then
      local top
      top=$(repo_top) && jail_sees "$hyprland" >/dev/null && [[ $hyprland == "$top"/* ]] ||
        die "up: --hyprland $hyprland is not in this jail's project nor in a folder it was given whole, so it does not go into the box"
      hypr_bind=0
    fi
  fi
  # --hyprland (finding 116): the build's folder, read-only at its own path, refused as --ro-bind's are
  # (a binary right in HOME or /tmp would take all of it along). Not one under /usr: the box has it.
  if [ -n "$hyprland" ] && [ "$hypr_bind" = 1 ] && [[ $hyprland != /usr/* ]]; then
    why=$(refuse_src "${hyprland%/*}") && die "--hyprland: refusing to mount ${hyprland%/*} (the binary's folder) into a box: $why; put the build in a folder of its own"
    why=$(refuse_dest "${hyprland%/*}") && die "--hyprland: refusing to mount ${hyprland%/*} (the binary's folder) at its own path in a box: $why"
    robinds+=("${hyprland%/*}"$'\t'"${hyprland%/*}")
  fi
  size=$(parse_mode "$size")
  local idle_s; idle_s=$(duration "$idle") || die "--idle wants 30m, 2h, 90s or 0 (never), got $idle"
  [ $interactive = 0 ] || idle_s=0
  [ $interactive = 1 ] || [ -z "$ws$confirm" ] || die "up: --workspace and --confirm-close are for --interactive (peek takes --workspace)"
  # Settings (finding 70): the flags, else ~/.config/omabox/config. confirm_close_from says whether a
  # later `omabox config confirm-close` changes this box too.
  local confirm_from=flag
  [ -n "$ws" ] || ws=$(conf_get workspace)
  [ -n "$confirm" ] || { confirm=$(conf_get confirm-close); confirm_from=config; }
  # host: connected's name from before every box had a network of its own (finding 89). A nested
  # connected box (its host is a box) cannot have a connected pasta (a box has no /dev/net/tun), so
  # its network is none: an empty namespace of its own.
  case $net in host|connected) net=connected ;; isolated) ;; *) die "up: --net is connected (the default) or isolated" ;; esac
  [ -z "$allow" ] || [ "$net" = isolated ] || die "up: --allow needs --net isolated"
  [ "$net" = connected ] && [ -f /opt/omabox/share/session.sh ] && net=none
  [[ -z $allow || $allow =~ ^[0-9]+(,[0-9]+)*$ ]] || die "up: --allow takes ports: 8081,8082"
  if [ -n "$FROM" ]; then
    save_dir "$FROM" >/dev/null   # (not inside the $(...) below: its refusal must end `up`)
    local saved_on; saved_on=$(jq -r '.hyprland // empty' "$SAVES/$FROM/save.json" 2>/dev/null) || saved_on=""
    [ "$saved_on" = "$hyprland" ] ||
      say "note: save '$FROM' was made in a box on ${saved_on:-the installed Hyprland}, this one runs ${hyprland:-the installed Hyprland}"
  fi
  # Nor does a box behind pasta start from a process with no_new_privs: bwrap cannot write its uid
  # map there (finding 89). A connected box falls back to none, as a nested one does: an agent's
  # sandbox that sets no_new_privs mostly has no network to give it anyway, and the box still gets a
  # namespace of its own (no host X11 capture). An isolated one is refused: its --allow ports need
  # pasta. An interactive box is started by the host's Hyprland, not this process. A box that is up
  # already is still found up (without the lock below, so a refusal leaves no .lock): such a process,
  # a sandboxed agent's, can use a box the user started.
  if [ "$net" != none ] && [ $interactive = 0 ] && grep -q '^NoNewPrivs:[[:space:]]*1$' /proc/self/status; then
    box_alive && { up_already; return 0; }
    [ "$net" = connected ] || die "an isolated box cannot start from a no_new_privs process like this one" \
      "(an agent's sandbox, a systemd unit with NoNewPrivileges=, a box's own session): its bwrap cannot write the uid map behind pasta"
    net=none
    say "box '$NAME' has no network: pasta's cannot start from a no_new_privs process like this one" \
      "(an agent's sandbox, a systemd unit with NoNewPrivileges=); it has only a loopback of its own"
  fi
  # Every top-level box's network is pasta's (finding 89); a connected one's is a tap device, which
  # pasta cannot make without /dev/net/tun (it would fail inside the box, where only box.log says why).
  # Before check_install: no box starts without them, whatever is built.
  command -v pasta >/dev/null || die "a box's network needs pasta: sudo pacman -S passt"
  # A sandbox that refuses new namespaces (ai-jail's seccomp filter) cannot start a box: say what does.
  in_jail || unshare -U true 2>/dev/null ||
    die "cannot start a box here: this sandbox refuses new namespaces. Inside ai-jail, omabox goes through the broker: run 'omabox broker on' outside the jail and add the lines it prints to ~/.ai-jail"
  [ "$net" != connected ] || [ -c /dev/net/tun ] ||
    die "a box's network needs /dev/net/tun (the tun kernel module); --net isolated does without, and has no internet"
  check_install "$hyprland"
  # One `up` or `down` per name at a time: two agents in one repo both running `omabox up` would
  # otherwise each start a box on the same dir, and one would be orphaned where `down` cannot see it.
  mkdir -p "$BOXES"
  exec {LOCK}>"$BOXES/.lock-$NAME"
  flock -w 60 "$LOCK" || die "box '$NAME' is busy (another up or down); try again"
  # No down can come first here (this holds the lock): only a box that just died starts again.
  if box_alive && take_over held; then up_already; return 0; fi
  [ $systemd = 0 ] || systemctl --user is-system-running >/dev/null 2>&1 || [ "$(systemctl --user is-system-running 2>/dev/null)" = degraded ] ||
    die "--systemd needs your systemd user manager (systemctl --user) to delegate the box a cgroup"
  PLUGINS=()
  local p; for p in "${plugin_args[@]}"; do PLUGINS+=("$(resolve_plugin "$p")") || exit 1; done
  for p in "${PLUGINS[@]}"; do
    why=$(refuse_src "${p#*$'\t'}") && die "refusing to mount plugin ${p#*$'\t'} into a box: $why"
  done

  # Host code, read-only (at the same path unless DIR:DEST): the repo `up` runs from, mise's
  # toolchains, ~/.config/omabox/ro-bind, --ro-bind. Checked before anything is created: a refusal
  # leaves no box dir. What the user named is refused loudly; what omabox adds by itself is skipped.
  local top
  if top=$(repo_top); then
    if why=$(refuse_src "$top"); then say "not mounting the repo $top: $why"
    else robinds=("$top"$'\t'"$top" "${robinds[@]}"); fi
  fi
  # Language toolchains mise installed (node, python, ...): interpreters and compilers, no secrets.
  # Mounted so `omabox run` finds the same ones as the host (finding 47); rustup's ~/.cargo is not.
  # Not for a jailed agent whose jail has no mise, nor the user's own mounts (finding 99).
  local mise=${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs
  [ -d "$mise" ] && { ! in_jail || jail_sees "$mise" >/dev/null; } && robinds+=("$(readlink -f "$mise")"$'\t'"$(readlink -f "$mise")")
  if [ -f "$HOME/.config/omabox/ro-bind" ] && ! in_jail; then
    local line
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%%[[:space:]]#*}; [[ $line == \#* ]] && continue      # comments: whole line, or after a space
      line=${line#"${line%%[![:space:]]*}"}; line=${line%"${line##*[![:space:]]}"}   # trim, keep inner spaces
      [ -n "$line" ] || continue
      if spec=$(robind_spec "$line"); then robinds+=("$spec")
      else say "$HOME/.config/omabox/ro-bind: skipping $line (no such path)"; fi
    done < "$HOME/.config/omabox/ro-bind"
  fi
  local src dest ro_args=()
  for p in "${robinds[@]}"; do
    src=${p%%$'\t'*} dest=${p#*$'\t'}
    why=$(refuse_src "$src") && die "refusing to mount $src into a box: $why"
    why=$(refuse_dest "$dest") && die "refusing to mount $src at $dest in a box: $why"
    ro_args+=(--ro-bind "$src" "$dest")
  done
  for p in "${overlays[@]}"; do
    why=$(refuse_src "$p") && die "refusing to overlay $p in a box: $why"
    why=$(refuse_dest "$p") && die "refusing to overlay $p in a box: $why"
  done

  rm_box; rm -f "$BOXES/.expired-$NAME"; mkdir -p "$D/run" "$HOMES/$NAME/home"; ln -s "$HOMES/$NAME/home" "$D/home"
  [ -z "$FROM" ] || cp -a --reflink=auto "$(save_dir "$FROM")/home/." "$HOMES/$NAME/home/" || die "could not copy save '$FROM' into box '$NAME'"
  # The name is taken now (its dir exists): let the next `up --new` choose, and keep the lock out of
  # the box's long-lived processes.
  [ -z "${NEWLOCK:-}" ] || exec {NEWLOCK}>&-
  sweep_homes
  seed_home
  # Read again as late as possible: a change made while this box was being set up (the widget's
  # switch during "New interactive box") would otherwise be lost for it; once box.json exists,
  # confirm_live sees the box.
  [ "$confirm_from" = flag ] || confirm=$(conf_get confirm-close)
  local render renders nvidia_devs=() dev n wayland_screen=0 run=/run/user/$UID
  render=$(render_node)
  if [ $interactive = 1 ]; then
    mapfile -t renders < <(render_nodes)
    # An NVIDIA node whose userspace nodes are missing is left out: the desktop is not rendering on it.
    for n in "${renders[@]}"; do
      [ "$(render_driver "$n")" != nvidia ] || ! dev=$(nvidia_device "$n" 2>/dev/null) || nvidia_devs+=("$dev")
    done
  elif [ "$(render_driver "$render")" = nvidia ]; then
    renders=("$render")
    dev=$(nvidia_device "$render") || die "cannot use NVIDIA render node $render"
    nvidia_devs=("$dev") wayland_screen=1
  else
    renders=("$render")
  fi
  jq -n --arg name "$NAME" --arg mode "$([ $interactive = 1 ] && echo interactive || echo headless)" \
    --arg size "$([ $interactive = 1 ] && echo window || echo "$size")" --arg created "$(date -Is)" \
    --arg net "$net" --arg allow "$allow" --argjson idle "$idle_s" --arg bar "$([ "$STOCK_BAR" = 1 ] && echo stock || echo user)" \
    --argjson systemd "$([ $systemd = 1 ] && echo true || echo false)" --arg owner "$owner" --arg agent "$agent" \
    --argjson plugins "$(printf '%s\n' "${PLUGINS[@]}" | cut -f1 | jq -R 'select(. != "")' | jq -s .)" \
    --argjson overlays "$(printf '%s\n' "${overlays[@]}" | jq -R 'select(. != "")' | jq -s .)" \
    --arg ws "$ws" --arg confirm "$confirm" --arg confirm_from "$confirm_from" --argjson wayland_screen "$wayland_screen" \
    --arg jail "$(! in_jail || jail_get .id)" --arg from "$FROM" --arg hyprland "$hyprland" \
    '{name: $name, mode: $mode, size: $size, created: $created, plugins: $plugins, net: $net, allow: $allow,
      idle: $idle, bar: $bar, systemd: $systemd, overlays: $overlays, wayland_screen: ($wayland_screen == 1)}
      + (if $jail != "" then {jail: $jail} else {} end)
      + (if $from != "" then {from: $from} else {} end)
      + (if $hyprland != "" then {hyprland: $hyprland} else {} end)
      + (if $owner != "" then {owner: ($owner | tonumber)} else {} end)
      + (if $agent != "" then ($agent | split(" ") | {agent: (.[0] | tonumber), agent_start: .[1]}) else {} end)
      + (if $mode == "interactive" then {workspace: $ws, confirm_close: ($confirm == "on"), confirm_close_from: $confirm_from,
          drawn_hidden: true} else {} end)' > "$D/box.json"
  [ $interactive = 0 ] || write_confirm_flag "$D/run" "$confirm"

  # Safety invariant (finding 5): Hyprland tries DRM first. Never bind /dev/dri/card*, /dev/input,
  # /run/seatd.sock, the system bus or the real XDG_RUNTIME_DIR: only a render node goes in.
  # The host's name in both network modes (finding 54): pasta's own UTS namespace would otherwise
  # name an isolated box pasta-HOST.
  local args=(--info-fd 3 --unshare-pid --unshare-ipc --unshare-uts --hostname "$(uname -n)"
    --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib /lib64 --ro-bind /etc /etc
    --proc /proc --dev /dev --ro-bind /sys /sys
    --tmpfs /tmp --bind "$D/run" "$run" --bind "$HOMES/$NAME/home" /home/sbx
    --ro-bind "$ROOT/share" /opt/omabox/share --ro-bind "$AQUAMARINE" /opt/omabox/lib
    --ro-bind "$KEYBOARD" "$BOX_KEYBOARD" --ro-bind "$POINTER" "$BOX_POINTER" --ro-bind "$STILL" "$BOX_STILL")
  for n in "${renders[@]}"; do args+=(--dev-bind "$n" "$n"); done
  [ ${#nvidia_devs[@]} = 0 ] || args+=(--dev-bind /dev/nvidiactl /dev/nvidiactl)
  for n in "${nvidia_devs[@]}"; do args+=(--dev-bind "$n" "$n"); done
  args+=("${ro_args[@]}")
  # A real user manager (finding 61): the box's own cgroup (the delegated scope it is launched in,
  # below) writable as its whole /sys/fs/cgroup under a cgroup namespace, and the marker systemd
  # checks for a systemd-booted system. @CGROUP@ is filled in inside the scope.
  [ $systemd = 0 ] || args+=(--unshare-cgroup --bind @CGROUP@ /sys/fs/cgroup --dir /run/systemd/system)
  # DNS (finding 52): /etc is the host's but /run is the box's, so a resolv.conf linking into /run
  # (systemd-resolved's stub, NetworkManager's) points at nothing. A connected box gets that one
  # file (pasta forwards the stub's port); an isolated box has no network to resolve names for.
  # (A link whose directory is missing makes readlink -f fail: no file to bind, not a silent exit.)
  local resolv; resolv=$(readlink -f /etc/resolv.conf) || resolv=""
  if [ "$net" = connected ] && [[ $resolv = /run/* ]] && [ -f "$resolv" ]; then args+=(--ro-bind "$resolv" "$resolv"); fi
  for p in "${PLUGINS[@]}"; do args+=(--ro-bind "${p#*$'\t'}" "/home/sbx/.config/omarchy/plugins/${p%%$'\t'*}"); done
  for p in "${overlays[@]}"; do args+=(--overlay-src "$p" --tmp-overlay "$p"); done
  # share/bin first: stand-ins for tools that need a systemd user manager (uwsm-app).
  # The XDG base dirs, as an Omarchy session has them: dbus-daemon reads the box HOME's D-Bus services
  # only from $XDG_DATA_HOME; without it, it looks in the passwd entry's home, not $HOME (finding 87).
  # QT_FORCE_STDERR_LOGGING (finding 98): a Qt app without a terminal logs to the journal, which a box
  # has none of, so a `run -d` log stayed empty; --env QT_FORCE_STDERR_LOGGING=0 turns it off.
  # OMABOX_HYPRLAND: the build share/start-hyprland.sh starts instead of /usr/bin/Hyprland (finding 116).
  local hypr_env=(); [ -z "$hyprland" ] || hypr_env=(--setenv OMABOX_HYPRLAND "$hyprland")
  args+=(--setenv PATH /opt/omabox/share/bin:/usr/bin --setenv XDG_RUNTIME_DIR "$run" --setenv HOME /home/sbx
    --setenv XDG_DATA_HOME /home/sbx/.local/share --setenv XDG_CONFIG_HOME /home/sbx/.config
    --setenv XDG_CACHE_HOME /home/sbx/.cache --setenv XDG_STATE_HOME /home/sbx/.local/state
    --setenv QT_FORCE_STDERR_LOGGING 1
    --setenv OMABOX_RENDER_NODE "$render" --setenv OMABOX_CALLER_PATH "$(caller_path)"
    --setenv OMABOX_WAYLAND_SCREEN "$wayland_screen"
    --setenv OMABOX_SIZE "$size" --setenv OMABOX_INTERACTIVE "$interactive" --setenv OMABOX_XWAYLAND "$xwayland"
    --setenv OMABOX_SYSTEMD "$systemd" --setenv OMABOX_SHELL "$shell"
    "${hypr_env[@]}" "${envs[@]}" /opt/omabox/share/session.sh)

  local launch=(bwrap)
  if [ $interactive = 1 ]; then
    host_session
    [ -x "$WLFD" ] || die "missing $WLFD: run install.sh"
    launch=("$WLFD" "$HOST_WL" bwrap)
  fi
  # Every box has its own network namespace (finding 89): in the host's, labwc's lazy Xwayland could
  # claim the host's abstract X11 :0 socket and host X11 apps would open in the box. The default mode
  # keeps the internet, the LAN and the host's loopback (ports bound on either side are forwarded,
  # within about a second); an isolated box has only a loopback and the --allow ports. pasta maps us
  # to root, bwrap maps back to our uid. pasta closes inherited fds: bwrap's info fd is opened inside
  # it, and omabox-wlfd connects from inside (a unix socket).
  if [ "$net" = none ]; then
    # A nested connected box (its pasta would need /dev/net/tun, which the outer box's /dev lacks),
    # or one started from a no_new_privs process (above).
    # It fails closed: a network namespace of its own with only a loopback. (A nested isolated box
    # still runs pasta --splice-only, below: that needs no tun. Only a headless one started from
    # omabox run, though: what the box's session starts (an interactive box's launch.sh included)
    # has no_new_privs, and there bwrap cannot write its uid map, finding 89.)
    launch+=(--unshare-net)
  else
    local pasta_args=(-q -P "$D/pasta.pid")
    if [ "$net" = isolated ]; then
      pasta_args+=(--splice-only -t none -u none -U none -T "${allow:-none}")
    else
      # Box ports reach the host on its 127.0.0.1 only: plain `-t auto` binds *:P, which opens them to
      # the LAN, and a host client of `localhost` tries ::1 first, which pasta accepts, then resets,
      # instead of refusing (no fallback to 127.0.0.1). 1-65535,auto: ephemeral ports too, which auto
      # alone skips. --no-map-gw: the gateway is the router again, not all of the host's loopback.
      # -D/-S none: DNS is the host's resolv.conf (its stub's port comes in through -T), so pasta
      # has none to hand out and no warning to print about it.
      local ports=1-65535,auto
      pasta_args+=(--config-net --no-map-gw -D none -S none --host-lo-to-ns-lo
        -t "127.0.0.1/$ports" -u "127.0.0.1/$ports" -T "$ports" -U "$ports")
    fi
    # pasta adds its own pid namespace (no --no-pidns in Arch's yet), so it writes its pid for
    # pasta_pid to find the box's. It is bwrap's parent: --die-with-parent ends the box with it (OOM, a
    # killall), rather than leave it up with no network, DNS or forwards for the rest of its life.
    # shellcheck disable=SC2016 # $0 and $@ belong to the inner sh
    launch=(pasta "${pasta_args[@]}" --
      sh -c 'exec 3>"$0"; exec "$@"' "$D/info.json" "${launch[@]}" --unshare-user --uid "$UID" --gid "$(id -g)"
      --die-with-parent)
  fi
  # --systemd: the whole box (including pasta when used) runs in a transient scope that delegates
  # its cgroup, the only way an unprivileged sandbox gets a cgroup subtree of its own to manage. The
  # scope goes by itself once everything in it has died (`down` kills PID 1).
  local sdenv=()
  if [ $systemd = 1 ]; then
    # shellcheck disable=SC2016 # expanded inside the scope
    launch=(systemd-run --user --scope --quiet --collect --expand-environment=no -p Delegate=yes --unit "omabox-$NAME-$$"
      bash -c 'cg=/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup); exec "${@//@CGROUP@/$cg}"' omabox-cgroup "${launch[@]}")
    sdenv=(XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR")   # systemd-run finds the user manager through it
  fi
  # Without pasta, no --die-with-parent: bwrap's parent is then this command, which the box outlives;
  # `omabox down` (or closing an interactive box's window) ends it.
  # env -i keeps Hyprland's exec-rule token (finding 45): the host matches a new window to its exec
  # rule by the launched pid or by this token in the client's environment, and pasta forks, so a
  # top-level box's window (every one is behind pasta, finding 89) only lands on its workspace through
  # the token. bwrap drops it inside.
  { printf '#!/usr/bin/env bash\nexec'
    # USER/LOGNAME too (finding 49): widgets and scripts name the user from them. SHELL, which login
    # sets on the host (terminals and multiplexers open it), and every locale variable, not only LANG
    # (finding 58: LC_TIME and the rest are the user's formats).
    # (login_shell, not shell: that is cmd_up's "wait for the Omarchy shell" flag, finding 62.)
    local login_shell; login_shell=$(getent passwd "$(id -un)" | cut -d: -f7); [ -x "$login_shell" ] || login_shell=/bin/bash
    printf ' %q' env -i PATH=/usr/bin TERM=dumb LANG="${LANG:-C.UTF-8}" USER="$(id -un)" LOGNAME="$(id -un)" SHELL="$login_shell" "${sdenv[@]}"
    local v; for v in LANGUAGE ${!LC_*}; do [ -z "${!v:-}" ] || printf ' %q' "$v=${!v}"; done
    # shellcheck disable=SC2016 # expanded when launch.sh runs, under the host's exec rule
    printf ' %s' '${HL_EXEC_RULE_TOKEN:+HL_EXEC_RULE_TOKEN=$HL_EXEC_RULE_TOKEN}'
    [ "$(ulimit -Hc)" = 0 ] || printf ' %q' prlimit --core=1:   # nocore, for the whole box
    printf ' %q' setsid "${launch[@]}" --unsetenv HL_EXEC_RULE_TOKEN "${args[@]}"
    printf ' 3>%q </dev/null >%q 2>&1\n' "$D/info.json" "$D/box.log"
  } > "$D/launch.sh"
  # From here a box may be running: if `up` fails, kill it rather than leave it running unseen, with no
  # idle expiry. The dir stays, so the logs `die` points at can be read; `ls` shows it dead, `down`
  # clears it.
  trap '[ $? = 0 ] || kill_box' EXIT
  if [ $interactive = 1 ]; then
    install_passthrough
    # Launched by the host Hyprland so its exec rules apply to exactly this process's window: onto
    # the configured workspace (9 unless changed, finding 70) without focus. (Aquamarine names every nested window "aquamarine"; a class rule
    # would also catch any other nested Hyprland the user runs.) render_unfocused: the host sends the
    # hidden window frame callbacks, so the box keeps drawing and `shot` works without it on screen.
    host_eval "hl.exec_cmd('bash $(lua_str "$D/launch.sh")', { workspace = '$ws silent', no_initial_focus = true, render_unfocused = true })"
  else
    bash "$D/launch.sh" {LOCK}>&- &
  fi
  local deadline=$((SECONDS + 10))
  until [ -n "$(box_pid)" ]; do
    if [ $SECONDS -ge $deadline ]; then
      # bwrap writes info.json as it starts: with it there, the box started and was already gone
      # (finding 95: Hyprland aborted in it; "bwrap did not start" sent everyone looking elsewhere).
      [ -s "$D/info.json" ] || die "bwrap did not start; see $D/box.log"
      died_starting
    fi
    sleep 0.05
  done
  # What box_pid checks from now on: this box's pid namespace, not a later owner of the pid.
  local ns; ns=$(readlink "/proc/$(box_pid)/ns/pid")
  jq --arg ns "$ns" '.pidns = $ns' "$D/box.json" > "$D/box.json.tmp" && mv "$D/box.json.tmp" "$D/box.json"
  if [ -n "$hyprland" ]; then wait_hyprland; hypr_version; fi
  wait_ready "$shell"
  trap - EXIT
  [ $interactive = 1 ] && say "box '$NAME' is a window on $(ws_text "$ws"); $PASS_KEY passes SUPER keys to it (again to stop)"
  touch "$D/used"
  if [ "$idle_s" != 0 ] || [ -n "$owner$agent" ] || [ $interactive = 1 ]; then
    setsid -f "$ROOT/bin/omabox" _reap "$NAME" "$(meta created)" </dev/null >>"$D/reap.log" 2>&1 {LOCK}>&-
  fi
  local screen; screen=$(box_screen); say "box '$NAME' up (${screen#* }) in $D"
  [ $new = 0 ] || echo "$NAME"
}

# What `up` needs from install.sh: the helpers, and the patched aquamarine under the soname the
# box's Hyprland links (after an Arch update to a new soname, the box would otherwise silently run
# the unpatched system library). check_install [HYPRLAND]: the installed one, or `up --hyprland`'s
# build (finding 116), which is refused here rather than left to crash in the box.
check_install() {
  [ -x "$KEYBOARD" ] && [ -x "$POINTER" ] && [ -x "$STILL" ] || die "missing $KEYBOARD, $POINTER or $STILL: run install.sh"
  # Only an NVIDIA box sizes its screen with wlr-randr (finding 78); AMD and Intel boxes do without.
  [ -x /usr/bin/wlr-randr ] || [ "$(render_driver "$(render_node)")" != nvidia ] ||
    die "missing /usr/bin/wlr-randr, which NVIDIA boxes need: run install.sh"
  local want have
  if [ -z "${1:-}" ]; then
    want=$(ldd "$(command -v Hyprland || echo /usr/bin/Hyprland)" 2>/dev/null | awk '/libaquamarine/ {print $1; exit}') || true
    [ -n "$want" ] || die "cannot tell which libaquamarine Hyprland links (ldd $(command -v Hyprland))"
    [ -e "$AQUAMARINE/$want" ] || die "Hyprland links $want but $AQUAMARINE lacks it: run install.sh"
    return 0
  fi
  # A build's own libraries: its ELF dynamic section, read (readelf), never run. Its libaquamarine
  # soname must be the patched build's: the box finds that one first (LD_LIBRARY_PATH), and a build
  # against another soname would load the system's unpatched one, or none.
  want=$(elf_needed "$1" | grep -m1 '^libaquamarine\.so') || die "--hyprland $1 links no libaquamarine (readelf -d): not a Hyprland build?"
  have=$(elf_needed "$AQUAMARINE/libaquamarine.so" SONAME) || have="nothing ($AQUAMARINE: run install.sh)"
  [ "$want" = "$have" ] && [ -e "$AQUAMARINE/$want" ] ||
    die "--hyprland $1 links $want, but the patched aquamarine a box runs with is $have: build Hyprland against it" \
      "(PKG_CONFIG_PATH=$ROOT/build/prefix/lib/pkgconfig) or against an aquamarine with the same soname"
  # Any other library it needs and the box lacks (a newer hyprutils, say): ldd, as the box's loader sees
  # them. Not for a jailed agent's file: the broker does not load what the jail hands it.
  in_jail && return 0
  local missing; missing=$(LD_LIBRARY_PATH=$AQUAMARINE ldd -- "$1" 2>/dev/null | awk '/=> not found/ {print $1}' | paste -sd ' ') || true
  [ -z "$missing" ] || die "--hyprland $1 needs $missing, which the box lacks (it has the system's libraries and $AQUAMARINE)"
}

# An ELF file's dynamic section entries of one kind (NEEDED, or SONAME), one per line: its own words,
# read by readelf, never run or loaded. Fails when there are none.
elf_needed() {
  readelf -d -- "$1" 2>/dev/null | sed -n "s/.*(${2:-NEEDED}).*\[\(.*\)\]\$/\1/p" | grep .
}

# `up --hyprland PATH` (finding 116): PATH resolved, when it is an executable ELF file. What it links
# is check_install's.
hypr_bin() {
  local p; p=$(readlink -f -- "$1" 2>/dev/null) && [ -f "$p" ] || die "--hyprland: no such file: $1"
  [ -x "$p" ] || die "--hyprland: $p is not executable"
  [ "$(head -c 4 -- "$p" | od -An -tx1 | tr -d ' \n')" = 7f454c46 ] ||
    die "--hyprland: $p is not an ELF binary (a Hyprland build's own binary, e.g. build/Hyprland; not a wrapper script)"
  printf '%s\n' "$p"
}

# A box on its own Hyprland (finding 116): its version, as the box's Hyprland says it (the first line
# of `hyprctl version`), into box.json for `ls` and `windows`, and a warning when the host's hyprctl
# (and hyprpm, the installed Hyprland's) is of another version: their IPC may not match.
hypr_version() {
  local line ver host
  line=$(on_box hyprctl version 2>/dev/null | head -n 1) || line=""
  ver=$(on_box hyprctl version -j 2>/dev/null | jq -r '.version // empty' 2>/dev/null) || ver=""
  [ -n "$line" ] || { say "box '$NAME': its Hyprland ($(meta hyprland)) did not say its version (hyprctl version)"; return 0; }
  jq --arg v "$line" '.hyprland_version = $v' "$D/box.json" > "$D/box.json.tmp" && mv "$D/box.json.tmp" "$D/box.json"
  host=$(/usr/bin/Hyprland --version-json 2>/dev/null | jq -r '.version // empty' 2>/dev/null) || host=""
  [ -z "$ver" ] || [ -z "$host" ] || [ "$ver" = "$host" ] ||
    say "warning: box '$NAME' runs Hyprland $ver, but hyprctl and hyprpm are the installed $host's: their IPC may not match (omabox hyprctl, the shell's calls)"
}

# A value inside a single-quoted Lua string sent to the host Hyprland. Our own paths only; anything
# that could end the string is refused rather than escaped.
lua_str() {
  [[ $1 != *[\'\"\\$'\n']* ]] || die "unsafe characters in a path for the host Hyprland: $1"
  printf '%s' "$1"
}

# SIGKILL the box's PID 1 (the kernel then kills everything in its pid namespace; SIGTERM is ignored,
# finding 6) and pasta's; wait for them, at most 10 s. The dir stays.
kill_box() {
  local pid pasta
  pid=$(box_pid) || true
  [ -n "$pid" ] && kill -KILL "$pid" 2>/dev/null
  # A launcher stopped along with its command can't reap it, and PID 1 can't exit until it does.
  [ -n "$pid" ] && pkill -CONT -f "^nsenter -t $pid " 2>/dev/null
  # A box whose pid was never found: pasta's own pid namespace holds it, end that instead.
  if pasta=$(box_pasta); then
    kill -KILL "$pasta" "$(pgrep -P "$pasta" | head -1)" 2>/dev/null
  fi
  local end=$((SECONDS + 10))
  while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; do
    [ $SECONDS -lt $end ] || { say "box '$NAME': PID 1 ($pid) still exiting after 10 s ($(cat "/proc/$pid/wchan" 2>/dev/null))"; return 1; }
    sleep 0.05
  done
  true
}

# 30m, 2h, 90s, 45 (minutes), 0 → seconds.
duration() {
  [[ $1 =~ ^([0-9]{1,6})([smh]?)$ ]] || return 1
  local n=$((10#${BASH_REMATCH[1]}))   # decimal: 010 is ten, not octal eight
  case ${BASH_REMATCH[2]} in s) echo "$n" ;; h) echo $((n * 3600)) ;; *) echo $((n * 60)) ;; esac
}

# Seconds as the user would write them: 90s, 30m, 2h.
human_duration() {
  if [ $(($1 % 3600)) = 0 ] && [ "$1" -gt 0 ]; then echo "$(($1 / 3600))h"
  elif [ $(($1 % 60)) = 0 ] && [ "$1" -gt 0 ]; then echo "$(($1 / 60))m"
  else echo "${1}s"; fi
}

# Idle expiry (finding 59), a host process per headless box started by `up`: agents forget `down`, and
# a box holds ~500 MB and a GPU client. Idle = no omabox command naming the box (need_box and `run`
# touch $D/used), no peek window on it, and no `omabox run` still running in it. `run`'s throwaway
# boxes get one too, with no idle limit but an owner: the `omabox run` process; when that is gone
# (killed with SIGKILL, so its EXIT trap never ran), so is the box. Exits when the box goes, or when a
# new box took the name (its creation time differs). A throwaway box found dead once its run is gone
# is cleared too: its run's teardown gave up on it (PID 1 slow to exit under load) and nobody reads its
# logs; other dead boxes stay for theirs. An agent session's own box (finding 93) goes when the agent's
# process does (the one `up` recorded, with its start time), with --idle 0 too. In use then (a peek
# window, an `omabox run` still running), it stays while in use and goes at the next check once nobody
# uses it, without waiting out its idle limit. A dead one keeps its logs, as others do.
cmd__reap() {
  select_box "$1"; local created=$2 idle owner mode agent; idle=$(meta idle); owner=$(meta owner); mode=$(meta mode)
  agent=$(meta agent)
  [ -n "$idle" ] || idle=0
  [ "$idle" -gt 0 ] || [ -n "$owner$agent" ] || [ "$mode" = interactive ] || return 0
  local every=$((idle / 4)); [ $every -le 60 ] || every=60; [ $every -ge 5 ] || every=5
  # With no idle limit and only its agent to watch, as often as a 2 h box: not every 5 s all session.
  [ "$idle" -gt 0 ] || [ -z "$agent" ] || every=60
  # An interactive box closed by its user goes from the widget and `ls` within a poll or so.
  [ "$mode" != interactive ] || every=2
  while sleep "$every"; do
    [ "$(meta created)" = "$created" ] || return 0
    if ! box_alive; then
      if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then DOWN_IF_CREATED=$created cmd_down "$NAME"
      # Ended on purpose (its window closed, or "Shut down" when asked): nothing to keep. A box that
      # died any other way stays dead, logs and all, until `down` (finding 71). Interactive only: the
      # file is the box's to write, and a headless box has no window to close (finding 74).
      elif [ "$mode" = interactive ] && [ -f "$D/run/omabox.closed" ]; then
        say "$(date -Is) box '$NAME': closed by its user: clearing it"
        DOWN_IF_CREATED=$created cmd_down "$NAME"
      fi
      return 0
    fi
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      say "$(date -Is) box '$NAME': its omabox run ($owner) is gone: taking it down"
      DOWN_IF_CREATED=$created cmd_down "$NAME"; return 0
    fi
    [ "$idle" -gt 0 ] || [ -n "$agent" ] || continue
    local pid; pid=$(box_pid)
    if peek_pid >/dev/null || pgrep -f "^nsenter -t $pid " >/dev/null; then
      touch "$D/used"; continue
    fi
    if [ -n "$agent" ] && ! agent_alive; then
      say "$(date -Is) box '$NAME': its agent session ($(meta agent)) ended: taking it down"
      DOWN_IF_CREATED=$created DOWN_IF_AGENT_GONE=1 cmd_down "$NAME"
      # Still up, with an agent that runs: its session took it over meanwhile (take_over). Watch that.
      [ -d "$D" ] && [ "$(meta created)" = "$created" ] && agent_alive || return 0
      say "$(date -Is) box '$NAME': taken over by its session's new agent ($(meta agent)): kept"; continue
    fi
    [ "$idle" -gt 0 ] || continue
    [ $(($(date +%s) - $(stat -c %Y "$D/used"))) -ge "$idle" ] || continue
    local human; human=$(human_duration "$idle")
    say "$(date -Is) box '$NAME' idle for $human: taking it down"
    DOWN_IF_CREATED=$created cmd_down "$NAME"
    [ -d "$D" ] || echo "$human" > "$BOXES/.expired-$NAME"
    return 0
  done
}

# Whether the agent `up` recorded for this box still runs: its pid, started when it was then, and not
# a zombie (exited, but not reaped yet: a parent that never waits would keep it so for good). None
# recorded, or no start time, is none alive.
agent_alive() {
  local pid start; pid=$(meta agent) && start=$(meta agent_start) || return 1
  [ -n "$pid" ] && [ -n "$start" ] || return 1
  [ "$(proc_stat "$pid" 0)" != Z ] && [ "$(proc_start "$pid")" = "$start" ]
}

# A session resumed in a new process (`claude --continue` and `--resume` keep its id) finds its box
# still up and recording the agent that exited, and the reaper would take the box down under the new
# one at its next check (finding 93). So the session's box goes over to this command's agent, but
# only then: not a box that records no agent, nor one whose agent still runs. Every command that finds
# a box up calls it: need_box does, and so do `up`, `run` and `path`, which do not go through it.
# Under the box's lock, which the reaper's `down` takes too before it checks the agent again; `up`
# holds it already (`take_over held`: a second flock on it would wait out the timeout). Fails when the
# box is no longer up once it has the lock (that down came first): the caller then says so.
take_over() {
  [ -n "$(meta agent)" ] && ! agent_alive && session_box || return 0
  local agent lock="" rc=0; agent=$(agent_proc) || return 0
  if [ "${1:-}" != held ]; then
    exec {lock}>"$BOXES/.lock-$NAME"
    flock -w 60 "$lock" || { exec {lock}>&-; return 0; }
  fi
  # Both checked again under the lock: the reaper's down, then a new `up` of the name that found no
  # agent, may have come first.
  if ! box_alive; then rc=1
  elif [ -n "$(meta agent)" ] && ! agent_alive &&
    jq --argjson pid "${agent%% *}" --arg start "${agent#* }" '.agent = $pid | .agent_start = $start' \
      "$D/box.json" > "$D/box.json.tmp"; then
    mv "$D/box.json.tmp" "$D/box.json"
  fi
  [ -z "$lock" ] || exec {lock}>&-
  return $rc
}

# Write VALUE to a file in a box's runtime dir (<box dir>/run/FILE). The box can write that dir too, so
# never open what is there: a link to a host file would be written through, a FIFO would block
# (finding 74; set -C still followed a link to a FIFO). A new file in the box dir, which the box cannot
# see, renamed over it. box_file PATH VALUE
box_file() {
  local tmp; tmp=$(mktemp "$(dirname "$(dirname "$1")")/.write.XXXXXX") || return 1
  { printf '%s\n' "$2" > "$tmp" && mv -fT "$tmp" "$1"; } || { rm -f "$tmp"; return 1; }
}

# A regular expression matching $1 literally (for pgrep -f).
re_quote() { printf '%s' "$1" | sed 's/[][\.*^$+?(){}|/]/\\&/g'; }

# The pid of this box's peek window, if one is open.
peek_pid() { pgrep -f "^$(re_quote "$PEEK --box $D/run/")" | head -1 | grep .; }

# What click/pointer/keys did, one line each, for the peek window to draw (finding 85; the formats are
# in tools/peek). Only while a peek window is open. $D/marks is in the box dir, which the box cannot
# see: nothing in it can forge marks or read them. Emptied past 64 KB (peek starts over), gone at down.
mark() {
  local f=$D/marks
  [ $# -gt 0 ] || return 0
  peek_pid >/dev/null || { rm -f "$f"; return 0; }
  [ ! -f "$f" ] || [ "$(stat -c %s "$f")" -le 65536 ] || : > "$f"
  (umask 077; printf '%s\n' "$@" >> "$f") 2>/dev/null || true
}

# The box dir and its HOME. A user manager (--systemd) leaves mode-000 entries in the runtime dir
# (systemd/inaccessible): ours, but rm cannot enter them until they are made writable.
rm_box() {
  [[ $D == "$BOXES"/?* ]] || return 0
  chmod -R u+rwX "$D/run" 2>/dev/null || true
  rm -rf "$D" "${HOMES:?}/$NAME"
}

# HOMEs whose box is gone: the runtime dir is cleared at logout or reboot, ~/.cache is not. The box dir
# is always created before its HOME, so a box being set up right now is never swept.
sweep_homes() {
  local h
  for h in "$HOMES"/*/; do
    h=${h%/}; [ -d "$h" ] && [ ! -e "$BOXES/${h##*/}" ] && rm -rf "$h"
  done
  true
}

# Host side of interactive mode. Runtime-only (hyprctl eval): gone at the next host config reload,
# never written to the user's config. Adds the "omabox" submap in which only the toggle key is bound,
# so every other key (SUPER binds included) reaches the focused box. Passthrough ends by itself, so
# nobody gets stuck with SUPER swallowed: when focus goes to another window, or on the first key
# pressed while the pointer is off the box (clicking the host bar leaves the box focused, so focus
# alone does not tell; that first key, usually SUPER, still reaches the box, the rest are the host's).
# Versioned: a newer omabox replaces the hooks of an older one in a running Hyprland.
install_passthrough() {
  host_eval "if (omabox_pass_version or 0) < 2 then
    for _, sub in ipairs(omabox_pass_subs or {}) do sub:remove() end
    if not omabox_passthrough then
      omabox_passthrough = true
      hl.define_submap('omabox', function()
        hl.bind('$PASS_KEY', hl.dsp.submap('reset'), { description = 'omabox: stop passing keys to the box' })
      end)
      hl.bind('$PASS_KEY', hl.dsp.submap('omabox'), { description = 'omabox: pass keys to the box' })
    end
    omabox_pass_version = 2
    local function over_box()
      local c = hl.get_cursor_pos()
      if not c then return false end
      for _, w in ipairs(hl.get_windows({ class = 'aquamarine' })) do
        local a, s = w.at, w.size
        if w.mapped and not w.hidden and w.workspace and w.workspace.visible
          and c.x >= a.x and c.x < a.x + s.x and c.y >= a.y and c.y < a.y + s.y then return true end
      end
      return false
    end
    local function leave()
      if hl.get_current_submap() == 'omabox' then hl.dispatch(hl.dsp.submap('reset')) end
    end
    omabox_pass_subs = {
      hl.on('window.active', function(w) if not (w and w.class == 'aquamarine') then leave() end end),
      hl.on('input.keyboard.key', function(_, _, state)
        if state == 1 and hl.get_current_submap() == 'omabox' and not over_box() then leave() end
      end),
    }
  end"
}

# Lua on the host Hyprland; its errors are ours to report.
host_eval() {
  local out; out=$(host_hyprctl eval "$1" 2>&1) || true
  [ "$out" = ok ] || die "host hyprctl eval failed: $out"
}

# --- run -----------------------------------------------------------------------------------------

cmd_run() {
  local name="" detach=0 up_args=()
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -d|--detach) detach=1 ;;
      --wait|--start|--quiet|--timeout|--strict|--json) settle_opt "$@"; shift $((SETTLE_TOOK - 1)) ;;
      --pass) optarg "$@"
        [[ $2 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "run: --pass takes a variable name, got $2"
        caller_env "$2" >/dev/null || die "run: --pass $2: not in this command's environment (export it first)"
        PASS+=("$2"); shift ;;
      --env-file) optarg "$@"
        in_jail && die "run: --env-file is read by a jailed agent's own omabox, never at a path here"
        envfile_read "$2" >/dev/null   # a bad line stops here, said
        local kvs; mapfile -d '' kvs < <(envfile_read "$2"); ENVKV+=("${kvs[@]}"); shift ;;
      --size|--plugin|--ro-bind|--overlay|--net|--allow|--env|--idle|--from|--hyprland) optarg "$@"; up_args+=("$1" "$2"); shift ;;
      --xwayland|--no-shell|--stock-bar|--systemd) up_args+=("$1") ;;
      -h|--help) usage; return ;;
      --) shift; break ;;
      -*) die "run: unknown option $1 (the command goes after --; --interactive is up's only)" ;;
      *) break ;;
    esac
    shift
  done
  [ $# -gt 0 ] || die "run: nothing to run (omabox run -- CMD ...)"
  settle_opts_check
  [ "$SETTLE_WAIT" = 0 ] || [ $detach = 1 ] || die "run: --wait goes with -d (a command run to its end has nothing to wait for)"
  select_box "$name"
  if box_alive; then
    [ ${#up_args[@]} -eq 0 ] || say "box '$NAME' is already up: ${up_args[*]} ignored"
    touch "$D/used" 2>/dev/null || true   # use, for idle expiry (so is its end, below)
    take_over || need_box   # gone while it waited: says so
    if [ $detach = 1 ]; then
      local log; log=$D/home/run-$(date +%s%N).log
      # --wait: until what it opens has settled (a first frame within 5 s unless --start says).
      if [ "$SETTLE_WAIT" = 1 ]; then
        local p; p=$(cursor_now) && [ -n "$p" ] && SETTLE_ARGS+=(--ignore "$(cursor_rect "$p")")
        settle_begin settle --start 5000 "${SETTLE_ARGS[@]}"
        settle_ready "$SETTLE_JSON"
      fi
      # setsid -f forks and exits, so nsenter exits too and the command is reparented to the box's
      # PID 1. A host nsenter left waiting would stop along with it and hang down (finding 39).
      settle_act box_exec setsid -f "$@" </dev/null >"$log" 2>&1
      say "started in box '$NAME' (log: $log)"
      [ "$SETTLE_WAIT" = 0 ] || { settle_end settle "$SETTLE_JSON" "the command was started"; return; }
      return 0
    fi
    local rc=0
    box_exec "$@" || rc=$?
    touch "$D/used" 2>/dev/null || true
    return $rc
  fi
  [ $detach = 0 ] || die "run -d needs a box that is up (omabox up $NAME)"
  # A box asked for by name (-b, $OMABOX), one that was up and died, or one that expired is not
  # replaced by a throwaway: that would run the command in a new network namespace without the box's mounts
  # (its --net isolated included), and hide what happened to it.
  [ -z "$name" ] && ! env_names_box && [ ! -d "$D" ] && [ ! -f "$BOXES/.expired-$NAME" ] || need_box
  # Throwaway box for this one command. The repo is an overlay: the command can write build
  # output, logs and caches there, the host checkout never changes, and it all goes at teardown.
  # Only a repo that may go into a box, never the directory we happen to be in (from ~ that would be
  # all of HOME, finding 63); outside one the command runs in the box HOME.
  local top why overlay=()
  if top=$(repo_top); then
    if why=$(refuse_src "$top"); then say "not overlaying $top: $why"; else overlay=(--overlay "$top"); fi
  fi
  # The name keeps its -run<pid> whatever the base's length: two runs in one repo never share a box.
  select_box "$(printf '%s' "$NAME" | cut -c1-28)-run$$"
  # A teardown that fails says why (the box's reaper retries it once this process is gone).
  trap 'out=$(cmd_down "$NAME" 2>&1) || say "$out"' EXIT
  # `up` as its own process: its errors reach the user and its `set -e` holds (inside a `||` here it
  # would not). --owner: if this process is killed outright, the box's reaper takes the box down.
  local err
  if ! err=$("$ROOT/bin/omabox" up "$NAME" "${overlay[@]}" --idle 0 --owner $$ "${up_args[@]}" 2>&1 >/dev/null); then
    printf '%s\n' "$err" | grep -v "^omabox: box '$NAME' up " >&2
    die "throwaway box failed to start"
  fi
  # Its warnings and notes still reach the caller (another Hyprland version than hyprctl's, finding 116).
  printf '%s\n' "$err" | grep -E '^omabox: (warning|note):' >&2 || true
  local rc=0
  box_exec "$@" || rc=$?
  return $rc
}

# --- windows -------------------------------------------------------------------------------------

# The box's mapped windows (finding 81), in hyprctl's order, which is the stacking order: later on
# top, except that floating windows are above tiled ones, fullscreen above the rest and a special
# workspace above a normal one. Each with where it is (`at`/`size`: its own surface, no border), its
# workspace, whether it is on screen (its workspace shown and not an inactive group tab) and `cover`:
# the windows drawn over part of it, with their geometry for a point test. Shell layers (bar, menus,
# panels) are not counted: they are full-screen surfaces. win_annotate CLIENTS MONITORS ACTIVEWINDOW
# shellcheck disable=SC2016 # jq, not shell
WIN_JQ='
  def overlaps($o): .at[0] < $o.at[0] + $o.size[0] and $o.at[0] < .at[0] + .size[0]
    and .at[1] < $o.at[1] + $o.size[1] and $o.at[1] < .at[1] + .size[1];
  def above($o; $t):
    if $o.workspace.id < 0 and $t.workspace.id > 0 then true
    elif $o.workspace.id != $t.workspace.id then false
    elif ($o.fullscreen > 0) != ($t.fullscreen > 0) then $o.fullscreen > 0
    elif $o.floating != $t.floating then $o.floating
    else $o.z > $t.z end;
  ([$m[] | .activeWorkspace.id, .specialWorkspace.id] | map(select(. != 0))) as $shown
  | [$c | map(select(.mapped)) | to_entries[] | .value + {z: .key}
     | .onscreen = (.workspace.id as $w | any($shown[]; . == $w) and (.hidden | not))] as $all
  | [$all[] | . as $t | {address, stableId, class, title, initialClass, initialTitle, pid,
      workspace: .workspace.name, at, size, floating, fullscreen: (.fullscreen > 0), xwayland,
      active: (.address == $a.address), onscreen,
      cover: [$all[] | select(.address != $t.address and .onscreen and above(.; $t) and overlaps($t))
              | {address, class, title, at, size}]}]'
win_annotate() { jq -c -n --argjson c "$1" --argjson m "$2" --argjson a "$3" "$WIN_JQ"; }
box_windows() {
  win_annotate "$(on_box hyprctl -j clients)" "$(on_box hyprctl -j monitors)" "$(on_box hyprctl -j activewindow)"
}

# A window selector (SEL): active, an address (0x..., address:0x...), pid:N, class:RE, title:RE,
# initialClass:RE, initialTitle:RE (regular expressions, any case), or a word: the class or its last
# dot-separated part, whole (nautilus for org.gnome.Nautilus, issue #20), or part of the title (any case). Several are all to match. Exactly one window or nothing: none or several is
# exit 2 with the candidates, never the first match.
# shellcheck disable=SC2016 # jq, not shell
WIN_SEL_JQ='
  def m($s):
    if $s == "active" then .active
    elif ($s | test("^(address:)?0x[0-9a-fA-F]+$")) then .address == ($s | sub("^address:"; "") | ascii_downcase)
    elif ($s | test("^pid:[0-9]+$")) then .pid == ($s[4:] | tonumber)
    elif ($s | test("^(class|title|initialClass|initialTitle):")) then
      ($s | capture("^(?<k>[A-Za-z]+):(?<v>.*)$")) as $kv | (.[$kv.k] // "") | test($kv.v; "i")
    else (.class | ascii_downcase) as $c | ($s | ascii_downcase) as $w
      | $c == $w or ($c | split(".") | last) == $w or (.title | ascii_downcase | contains($w)) end;
  [.[] | select(. as $w | all($ARGS.positional[]; . as $s | $w | m($s)))]'
# win_select WINDOWS SEL...: the one window (win_annotate's object), or exit 2.
win_select() {
  local wins=$1 hits; shift
  [ $# -gt 0 ] || die "no window selector"
  hits=$(jq -c "$WIN_SEL_JQ" --args "$@" <<<"$wins" 2>&1) || { say "bad window selector ($*): ${hits#jq: error*: }"; exit 2; }
  case $(jq length <<<"$hits") in
    1) jq -c '.[0]' <<<"$hits"; return ;;
    0) say "no window matches $*; the box's windows:"; win_lines "$wins" >&2 ;;
    *) say "$* matches $(jq length <<<"$hits") windows: name one by its address (or add a selector):"; win_lines "$hits" >&2 ;;
  esac
  exit 2
}
win_lines() {
  jq -r 'if length == 0 then "  (none)" else .[] | "  \(.address)  \(.class)  \(.title | tojson)  workspace \(.workspace)" end' <<<"$1"
}
# 0x... class "title", for messages.
win_desc() { jq -r '"\(.address) \(.class) \(.title | tojson)"' <<<"$1"; }

# Why a point of a window (window coordinates) cannot be clicked, or nothing.
# win_blocked WINDOW X Y
win_blocked() {
  jq -r --argjson x "$2" --argjson y "$3" '(.at[0] + $x) as $px | (.at[1] + $y) as $py
    | if .onscreen | not then "not on screen (workspace \(.workspace))"
      else first(.cover[] | select($px >= .at[0] and $px < .at[0] + .size[0] and $py >= .at[1] and $py < .at[1] + .size[1])
        | "covered there by \(.address) \(.class) \(.title | tojson)") // empty end' <<<"$1"
}

# Focus a window as a user would: its workspace comes to the screen (a special one opens), an
# inactive group tab comes to the front, and a floating window is raised; a tiled one stays under the
# floats. Waits until it is the active window.
win_raise() {
  local addr out; addr=$(jq -r .address <<<"$1")
  [[ $addr =~ ^0x[0-9a-f]+$ ]] || die "bad window address: $addr"
  out=$(on_box hyprctl dispatch "hl.dsp.focus({ window = 'address:$addr' })" 2>&1) || true
  [ "$out" = ok ] || die "could not focus window $addr: $out"
  if [ "$(jq -r .floating <<<"$1")" = true ]; then
    out=$(on_box hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = 'top', window = 'address:$addr' })" 2>&1) || true
    [ "$out" = ok ] || die "could not raise window $addr: $out"
  fi
  local deadline=$((SECONDS + 3))
  until [ "$(on_box hyprctl -j activewindow | jq -r '.address // empty')" = "$addr" ]; do
    [ $SECONDS -lt $deadline ] || die "window $addr did not take focus"
    sleep 0.05
  done
}

# The screen point for window coordinates X,Y of the window SEL picks, raised first when it is not on
# screen or something covers that point (unless RAISE is 0); a point still covered is refused, naming
# what covers it. win_point RAISE X Y SEL... → "SX SY"
win_point() {
  local raise=$1 x=$2 y=$3 w desc why; shift 3
  # `|| exit`: win_point runs in its caller's $(...), where errexit is off (no inherit_errexit), so
  # win_select's exit 2 (none or several) would otherwise fall through to a wrong message and exit 1.
  w=$(win_select "$(box_windows)" "$@") || exit $?
  desc=$(win_desc "$w")
  jq -e --argjson x "$x" --argjson y "$y" '$x < .size[0] and $y < .size[1]' <<<"$w" >/dev/null ||
    die "$x,$y is outside window $desc ($(jq -r '"\(.size[0])x\(.size[1])"' <<<"$w"); coordinates are the window's own)"
  why=$(win_blocked "$w" "$x" "$y")
  if [ -n "$why" ]; then
    [ "$raise" = 1 ] || die "window $desc is $why (click --window raises it; --no-raise and pointer do not)"
    win_raise "$w"
    w=$(win_select "$(box_windows)" "$(jq -r .address <<<"$w")") || exit $?
    why=$(win_blocked "$w" "$x" "$y")
    [ -z "$why" ] || die "window $desc is still $why after focusing it: move or close that window first"
  fi
  jq -r --argjson x "$x" --argjson y "$y" '"\(.at[0] + $x) \(.at[1] + $y)"' <<<"$w"
}

cmd_windows() {
  local name="" json=0
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      --json) json=1 ;;
      -*) die "windows: unknown option $1" ;;
      *) die "windows: unexpected $1" ;;
    esac
    shift
  done
  select_box "$name"; need_box
  local wins; wins=$(box_windows)
  if [ $json = 1 ]; then jq . <<<"$wins"; return; fi
  # A box on a Hyprland build of its own (finding 116) says so first.
  [ -z "$(meta hyprland)" ] || printf 'box %s runs Hyprland %s%s\n' "$NAME" "$(meta hyprland)" "$(v=$(meta hyprland_version); [ -z "$v" ] || echo " ($v)")"
  # Bottom to top, as they stack.
  printf '%-16s %-8s %-10s %-20s %-22s %-16s %s\n' ADDRESS PID WORKSPACE STATE GEOMETRY CLASS TITLE
  jq -r '.[] | [.address, .pid, .workspace,
      ((if .onscreen | not then "off-screen" elif .cover != [] then "covered" else "on-screen" end) + (if .active then ",active" else "" end)),
      "\(.size[0])x\(.size[1]) at \(.at[0]),\(.at[1])", .class, (.title | tojson)] | @tsv' <<<"$wins" |
    while IFS=$'\t' read -r a p ws st g c t; do
      printf '%-16s %-8s %-10s %-20s %-22s %-16s %s\n' "$a" "$p" "$ws" "$st" "$g" "$c" "$t"
    done
}

# --- driving ------------------------------------------------------------------------------------

# A -g value as "X Y W H": grim's "X,Y WxH", or X,Y,W,H and X,Y W,H as agents type it (#27).
geom_parse() {
  [[ $1 =~ ^(-?[0-9]+),(-?[0-9]+)[\ ,]([1-9][0-9]*)[x,]([1-9][0-9]*)$ ]] || return 1
  echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]} ${BASH_REMATCH[4]}"
}

# Width and height of a PNG, from its header.
png_size() {
  local b; read -r -a b < <(od -An -tu1 -j16 -N8 -- "$1")
  [ ${#b[@]} = 8 ] || return 1
  echo "$(((b[0] << 24) | (b[1] << 16) | (b[2] << 8) | b[3])) $(((b[4] << 24) | (b[5] << 16) | (b[6] << 8) | b[7]))"
}

# What every shot is of, for `click --in` / `pointer --in` (finding 81): $D/shots.tsv, which the box
# cannot see. One line per shot: path, size and mtime, the box's mode, `window ADDRESS` or `screen X,Y`
# (the image's origin), the size it covers on screen and the image's size (smaller with --fit).
# The file itself may be another name for it (FILE: a jailed caller's, as /dev/fd/N). shot_record PATH
# MODE WHERE GEOMETRY [FILE]
shot_record() {
  local f=$D/shots.tsv
  [[ $1 != *[$'\t\n']* ]] || { say "shot: a path with a tab or newline: no --in for this one"; return 0; }
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$(stat -L -c '%s %.9Y' -- "${5:-$1}")" "$2" "$3" "$4" >> "$f"
  if [ "$(wc -l < "$f")" -gt 500 ]; then tail -n 200 "$f" > "$f.new" && mv "$f.new" "$f"; fi
}

# The screen pixel (from the image's origin) under the centre of image pixel P, for an image of
# IMAGE pixels covering SCREEN pixels: P itself at scale 1. img_px P IMAGE SCREEN
img_px() { echo $(((2 * $1 + 1) * $3 / (2 * $2))); }

# Image pixel X,Y of a recorded shot → "window ADDRESS WX WY" (the window's own coordinates) or
# "screen SX SY". Refused: a file that is not a shot of this box, changed since, or taken in another
# screen mode; a window that is gone or resized. shot_point FILE X Y
shot_point() {
  local f key rec stamp mode kind ref geo x=$2 y=$3
  if in_jail; then
    # A jailed caller's omabox opened the shot in the jail and passed it as /dev/fd/N, with its name
    # there (relay_in): the broker opens no path of the caller's.
    [[ $1 =~ ^/dev/fd/[3-9]$ ]] && [ -f "$1" ] && [ -n "${OMABOX_RELAY_IN_AS:-}" ] ||
      die "--in: a jailed agent's shot is read by its own omabox, never at a path here"
    f=$1 key=$OMABOX_RELAY_IN_AS
  else
    f=$(readlink -f -- "$1" 2>/dev/null) && [ -f "$f" ] || die "--in: no such file: $1"
    key=$f
  fi
  rec=$(P=$key awk -F'\t' '$1 == ENVIRON["P"]' "$D/shots.tsv" 2>/dev/null | tail -n 1)   # (-v would unescape \)
  [ -n "$rec" ] || die "--in: $1 is not a shot of box '$NAME' (take one with omabox shot)"
  IFS=$'\t' read -r _ stamp mode kind geo <<<"$rec"
  ref=${kind#* } kind=${kind%% *}
  [ "$(stat -L -c '%s %.9Y' -- "$f")" = "$stamp" ] || die "--in: $key changed since the shot: take a new one"
  local screen; screen=$(box_screen)
  [ "${screen#* }" = "$mode" ] || die "--in: the box's mode is ${screen#* }, the shot was taken at $mode: take a new one"
  local lw lh iw ih; IFS='x ' read -r lw lh iw ih <<<"$geo"
  [ "$x" -lt "$iw" ] && [ "$y" -lt "$ih" ] || die "--in: $x,$y is outside the image (${iw}x$ih)"
  local rx ry; rx=$(img_px "$x" "$iw" "$lw") ry=$(img_px "$y" "$ih" "$lh")
  if [ "$kind" = window ]; then
    # "ADDRESS", or "ADDRESS X,Y WxH" for a -g crop of it: where the crop starts, the window's size.
    local addr org wsz; read -r addr org wsz <<<"$ref"
    [ -n "$org" ] || org=0,0 wsz=${lw}x$lh
    local w; w=$(jq -c --arg a "$addr" 'first(.[] | select(.address == $a)) // empty' <<<"$(box_windows)")
    [ -n "$w" ] || die "--in: the window of that shot ($addr) is gone"
    [ "$(jq -r '"\(.size[0])x\(.size[1])"' <<<"$w")" = "$wsz" ] ||
      die "--in: window $(win_desc "$w") is $(jq -r '"\(.size[0])x\(.size[1])"' <<<"$w") now, $wsz in the shot: take a new one"
    echo "window $addr $((${org%,*} + rx)) $((${org#*,} + ry))"
  else
    echo "screen $((${ref%,*} + rx)) $((${ref#*,} + ry))"
  fi
}

cmd_shot() {
  local name="" out="" geom="" sels=() fit="" tofd="" as=""
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -o|--output) optarg "$@"; out=$2; shift ;;
      # A jailed caller's omabox (relay_shot): the image goes to its file, opened in the jail and
      # passed as fd N, and is named AS in what shot says. The broker opens no path of the caller's.
      --to-fd) optarg "$@"; [[ $2 =~ ^[3-9]$ ]] || die "shot: --to-fd takes 3-9, got $2"; tofd=$2; shift ;;
      --as) optarg "$@"; as=$2; shift ;;
      -g) optarg "$@"; geom=$2; shift ;;
      -w|--window) optarg "$@"; sels+=("$2"); shift ;;
      --active) sels+=(active) ;;
      --fit) optarg "$@"; [[ $2 =~ ^[1-9][0-9]{1,4}$ ]] || die "shot: --fit takes the longest side in pixels (10-99999), got $2"; fit=$2; shift ;;
      -*) die "shot: unknown option $1" ;;
      *) out=$1 ;;
    esac
    shift
  done
  local g=""; [ -z "$geom" ] || g=$(geom_parse "$geom") || die "shot: -g is \"X,Y WxH\" (or X,Y,W,H), got $geom"
  select_box "$name"; need_box
  # file: what is written and read back; out: its name, for the caller.
  local file
  if [ -n "$tofd" ]; then
    [ -n "$as" ] && [ -z "$out" ] || die "shot: --to-fd goes with --as NAME, without -o"
    [ -f "/dev/fd/$tofd" ] || die "shot: fd $tofd is not a file"
    out=$as file=/dev/fd/$tofd
  else
    in_jail && die "shot: a jailed agent's shot is written by its own omabox (--to-fd), never at a path here"
    [ -n "$out" ] || out=${TMPDIR:-/tmp}/omabox-$NAME-$(date +%H%M%S-%N | cut -c1-10).png
    mkdir -p -- "$(dirname -- "$out")" || die "shot: cannot make the directory $(dirname -- "$out")"
    out=$(readlink -f -- "$out") file=$out.part
  fi
  # What the image covers: a window (its own pixels, finding 81), a region, or the whole layout.
  # PNG level 1: most of a shot's time was compression, for a file an agent reads once (finding 83).
  # With --window, -g is in the window's own coordinates (grim crops the window's capture), and the
  # shot records where in the window it starts, for --in.
  local grim=(grim -l 1) win="" where lw lh ww wh gx gy
  [ -z "$g" ] || read -r gx gy lw lh <<<"$g"
  if [ ${#sels[@]} -gt 0 ]; then
    win=$(win_select "$(box_windows)" "${sels[@]}")
    local id; id=$(jq -r .stableId <<<"$win")
    [[ $id =~ ^[0-9a-fA-F]+$ ]] || die "shot: window $(win_desc "$win") has no stableId to capture it by ($id)"
    grim+=(-T "$id")
    where="window $(jq -r .address <<<"$win")"
    read -r ww wh < <(jq -r '"\(.size[0]) \(.size[1])"' <<<"$win")
    if [ -n "$g" ]; then
      [ "$gx" -ge 0 ] && [ "$gy" -ge 0 ] && [ $((gx + lw)) -le "$ww" ] && [ $((gy + lh)) -le "$wh" ] ||
        die "shot: -g $gx,$gy ${lw}x$lh is not inside window $(win_desc "$win") (${ww}x$wh; -g is in the window's coordinates)"
      grim+=(-g "$gx,$gy ${lw}x$lh")
      where+=" $gx,$gy ${ww}x$wh"
    else lw=$ww lh=$wh; fi
  elif [ -n "$g" ]; then
    grim+=(-g "$gx,$gy ${lw}x$lh")
    where="screen $gx,$gy"
  else
    local ext; ext=$(extent)
    where="screen 0,0" lw=${ext%x*} lh=${ext#*x}
  fi
  # --fit: grim scales the capture (-s); it truncates the size, so the factor is rounded up.
  local long=$((lw > lh ? lw : lh))
  if [ -n "$fit" ] && [ "$long" -gt "$fit" ]; then
    grim+=(-s "$(awk -v n="$fit" -v l="$long" 'BEGIN { printf "%.6f", int(n / l * 1e6 + 1) / 1e6 }')")
  fi
  # grim runs in the box (on_box) and writes to stdout; the file is ours. Renamed into place, so a
  # failed capture never leaves a half-written or empty PNG at $out. A window's first capture can be
  # a frame from long ago: one that is off screen gets no frame callbacks, so it stops rendering, and
  # the capture itself is what makes it draw again (finding 81). So a window is captured twice.
  grab() { on_box timeout 10 "${grim[@]}" -; }
  # A jailed caller's file through its own fd, never reopened by name: /dev/fd/N opened for writing
  # would give the broker more than the caller passed (a read-only fd of a file it may not write).
  put() { if [ -n "$tofd" ]; then grab >&"$tofd"; else grab > "$file"; fi; }
  if ! { [ -z "$win" ] || { grab >/dev/null && sleep 0.1; }; } || ! put || [ ! -s "$file" ]; then
    [ -n "$tofd" ] || rm -f "$file"
    # Never tell an agent to show the window: switching the user's workspace for a frame is what the
    # box exists to avoid. A restart is the user's to do: a box from before drawn_hidden needs one, and
    # so does one whose window confirm-close replaced (the new window has no render_unfocused).
    # confirm-close.sh leaves omabox.reopened for that; the box can write there, so only test for it.
    if [ "$(meta mode)" = interactive ]; then
      [ "$(meta drawn_hidden)" = true ] ||
        die "shot: no frame from interactive box '$NAME': it was started by an older omabox, which does not draw its window while hidden. It needs a restart, which ends the user's session in it: ask the user. Never switch the user's workspace or focus to get a frame"
      [ ! -f "$D/run/omabox.reopened" ] ||
        die "shot: no frame from interactive box '$NAME': the user closed its window and kept the box running (confirm-close), and the new window is not drawn while hidden. It needs a restart, which ends the user's session in it: ask the user. Never switch the user's workspace or focus to get a frame"
      die "shot: no frame from interactive box '$NAME' ($(ws_text "$(meta workspace)")) in 10 s: ask the user; never switch the user's workspace or focus to get one"
    fi
    die "shot: grim failed"
  fi
  [ -n "$tofd" ] || { mv "$file" "$out"; file=$out; }
  local iw ih screen
  read -r iw ih < <(png_size "$file") || die "shot: $out is not a PNG"
  screen=$(box_screen)
  shot_record "$out" "${screen#* }" "$where" "${lw}x$lh ${iw}x$ih" "$file"
  # One line on stderr when image pixels are not screen pixels (cropped or scaled); stdout is the path.
  local k=""
  [ "$iw" = "$lw" ] || k=" (x$(awk -v a="$lw" -v b="$iw" 'BEGIN { s = sprintf("%.2f", a / b); sub(/\.?0+$/, "", s); print s }'))"
  if [ -n "$win" ]; then
    local state; state=$(jq -r 'if .onscreen | not then ", not on screen"
      elif .cover != [] then ", covered by \(.cover[0].address) \(.cover[0].class) \(.cover[0].title | tojson)"
        + (if (.cover | length) > 1 then " and \(.cover | length - 1) more" else "" end)
      else "" end' <<<"$win")
    local crop=""; [ -z "$g" ] || crop="; ${lw}x$lh of it at $gx,$gy"
    say "window $(win_desc "$win") ${ww}x$wh at $(jq -r '"\(.at[0]),\(.at[1])"' <<<"$win"), workspace $(jq -r .workspace <<<"$win")$state$crop${k:+; image ${iw}x$ih$k}; click with --in $out"
  elif [ "$where $lw $iw" != "screen 0,0 $lw $lw" ] || [ "$lh" != "$ih" ]; then
    say "${iw}x$ih image of the screen's ${lw}x$lh at ${where#screen }$k; click with --in $out"
  fi
  echo "$out"
}

# Keys through tools/keyboard (not wtype: finding 13). Tokens: COMBO (super+space, ctrl+shift+t,
# Return, a), -t TEXT, -s MS, --pass VAR. The layout is the box's, so keycodes mean what Hyprland
# thinks they mean. --pass types a variable of the caller's (finding 84): its value goes to the tool's
# stdin (printf is a builtin: no argv), never on a command line; the tool reads one text per -T.
cmd_keys() {
  local name="" toks=() sels=() pass=()
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -w|--window) optarg "$@"; sels+=("$2"); shift ;;
      # A value is the tool's, whatever it looks like (-t --wait types "--wait", -t --pass "--pass").
      -t|-s|--delay) [ $# -ge 2 ] || die "keys: $1 needs a value"; toks+=("$1" "$2"); shift ;;
      --pass) optarg "$@"
        [[ $2 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "keys: --pass takes a variable name, got $2"
        caller_env "$2" >/dev/null || die "keys: --pass $2: not in this command's environment (export it first)"
        pass+=("$2"); toks+=(-T); shift ;;
      *) settle_opt "$@"
         if [ "$SETTLE_TOOK" = 0 ]; then toks+=("$1"); else shift $((SETTLE_TOOK - 1)); fi ;;
    esac
    shift
  done
  settle_opts_check
  set -- "${toks[@]}"
  select_box "$name"; need_box
  [ $# -gt 0 ] || die "keys: nothing to send"
  # --window: that window focused first (finding 81), as a click on it would.
  if [ ${#sels[@]} -gt 0 ]; then
    local w; w=$(win_select "$(box_windows)" "${sels[@]}")
    [ "$(jq -r .active <<<"$w")" = true ] || win_raise "$w"
  fi
  # The box's own keyboard settings, so keycodes mean to the keymap what they mean to its binds
  # (kb_options like altwin:swap_lalt_lwin move Super).
  local layout variant model options
  layout=$(on_box hyprctl -j getoption input:kb_layout | jq -r '.str // "us"' | cut -d, -f1)
  variant=$(on_box hyprctl -j getoption input:kb_variant | jq -r '.str // ""' | cut -d, -f1)
  model=$(on_box hyprctl -j getoption input:kb_model | jq -r '.str // ""')
  options=$(on_box hyprctl -j getoption input:kb_options | jq -r '.str // ""')
  local kb=("$BOX_KEYBOARD" --layout "${layout:-us}" --variant "$variant" --model "$model" --options "$options" "$@")
  # Marks for a peek window, once sent: a secret only as its length.
  local lines=() i=0 t
  while [ $# -gt 0 ]; do
    case $1 in
      -s|--delay) shift ;;
      -t) t=${2//[[:cntrl:]]/ }; [ -z "$t" ] || lines+=("text ${t:0:200}"); shift ;;
      -T) t=$(caller_env "${pass[i]}"); [ -z "$t" ] || lines+=("secret ${#t}"); t=""; i=$((i + 1)) ;;
      *) lines+=("combo $1") ;;
    esac
    shift
  done
  if [ "$SETTLE_WAIT" = 1 ]; then
    # --wait: the screen before the keys, then a change and quiet after them. The cursor hides on a
    # key press: not a change.
    local p; p=$(cursor_now) && [ -n "$p" ] && SETTLE_ARGS+=(--ignore "$(cursor_rect "$p")")
    settle_begin settle "${SETTLE_ARGS[@]}"
    settle_ready "$SETTLE_JSON"
    settle_act keys_send
    mark "${lines[@]}"
    settle_end settle "$SETTLE_JSON" "the keys were sent"
  else
    keys_send
    mark "${lines[@]}"
  fi
}
# The keyboard tool (kb, pass: cmd_keys's), each --pass value on its stdin, NUL-terminated.
keys_send() {
  local v
  for v in "${pass[@]}"; do caller_env "$v"; printf '\0'; done | on_box "${kb[@]}"
}

# X Y are screen pixels; with --window SEL the window's own (0,0 is its top left corner, as in its
# `shot --window`), with --in SHOT that image's pixels (finding 81).
cmd_click() {
  local name="" btn=left double=0 xy=() sels=() raise=1 in=""
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -w|--window) optarg "$@"; sels+=("$2"); shift ;;
      --in) optarg "$@"; in=$2; shift ;;
      --no-raise) raise=0 ;;
      --double) double=1 ;;
      left|right|middle) btn=$1 ;;
      --*) settle_opt "$@"; [ "$SETTLE_TOOK" != 0 ] || die "click: unknown option $1"; shift $((SETTLE_TOOK - 1)) ;;
      *) [[ $1 =~ ^[0-9]+$ ]] || die "click: bad argument $1"; xy+=("$((10#$1))") ;;
    esac
    shift
  done
  settle_opts_check
  [ ${#xy[@]} -eq 2 ] || die "click: need X Y"
  [ -z "$in" ] || [ ${#sels[@]} = 0 ] || die "click: --in or --window, not both"
  [ $raise = 1 ] || [ -n "$in" ] || [ ${#sels[@]} -gt 0 ] || die "click: --no-raise goes with --window or --in"
  select_box "$name"; need_box
  local x=${xy[0]} y=${xy[1]} p
  if [ -n "$in" ]; then
    p=$(shot_point "$in" "$x" "$y")
    if [[ $p == window* ]]; then local a; read -r _ a x y <<<"$p"; sels=("$a"); else read -r _ x y <<<"$p"; fi
  fi
  if [ ${#sels[@]} -gt 0 ]; then
    p=$(win_point "$raise" "$x" "$y" "${sels[@]}")
    read -r x y <<<"$p"
  fi
  local seq=(move "$x" "$y" click "$btn")
  [ $double = 1 ] && seq+=(click "$btn")
  local ext; ext=$(extent)
  # The mark (for a peek window) has the screen pixels the click went to, however they were given.
  if [ "$SETTLE_WAIT" != 1 ]; then
    on_box "$BOX_POINTER" --extent "$ext" "${seq[@]}"
    mark "ptr $ext ${seq[*]}"
    return
  fi
  # --wait: the cursor where it is and where it goes is not the change looked for.
  local p; p=$(cursor_now) && [ -n "$p" ] && SETTLE_ARGS+=(--ignore "$(cursor_rect "$p")")
  SETTLE_ARGS+=(--ignore "$(cursor_rect "$x $y")")
  settle_begin settle "${SETTLE_ARGS[@]}"
  settle_ready "$SETTLE_JSON"
  settle_act on_box "$BOX_POINTER" --extent "$ext" "${seq[@]}"
  mark "ptr $ext ${seq[*]}"
  settle_end settle "$SETTLE_JSON" "the click was sent"
}

# -b NAME, --in SHOT and --window SEL before the arguments (and before `--`); everything else goes to
# the tool. --in maps each `move X Y` from that shot's image to the screen, --window from that
# window's coordinates (#25); either window must be on screen and uncovered there: this is raw, it
# raises nothing. The tool's --hold is omabox's own (it never returns): refused here.
cmd_pointer() {
  local name="" in="" sels=()
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift 2 ;;
      --in) optarg "$@"; in=$2; shift 2 ;;
      -w|--window) optarg "$@"; sels+=("$2"); shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [ -z "$in" ] || [ ${#sels[@]} = 0 ] || die "pointer: --in or --window, not both"
  local a; for a; do [ "$a" != --hold ] || die "pointer: --hold is omabox's own (it never returns); to keep a button down: down, move ..., up (or omabox drag)"; done
  select_box "$name"; need_box
  if [ -n "$in" ] || [ ${#sels[@]} -gt 0 ]; then
    local args=() p
    while [ $# -gt 0 ]; do
      if [ "$1" = move ] && [ $# -ge 3 ]; then
        [[ $2 =~ ^[0-9]+$ && $3 =~ ^[0-9]+$ ]] || die "pointer: move takes whole pixels, got $2 $3"
        if [ ${#sels[@]} -gt 0 ]; then
          p=$(win_point 0 "$((10#$2))" "$((10#$3))" "${sels[@]}") || exit $?
        else
          p=$(shot_point "$in" "$((10#$2))" "$((10#$3))")
          if [[ $p == window* ]]; then
            local wa wx wy; read -r _ wa wx wy <<<"$p"
            p=$(win_point 0 "$wx" "$wy" "$wa") || exit $?
          else p=${p#screen }; fi
        fi
        args+=(move "${p% *}" "${p#* }"); shift 3
      else args+=("$1"); shift; fi
    done
    set -- "${args[@]}"
  fi
  # The mark has screen pixels: --in's moves as mapped above.
  local ext; ext=$(extent)
  on_box "$BOX_POINTER" --extent "$ext" "$@"
  mark "ptr $ext $*"
}

# omabox drag X1 Y1 X2 Y2 (#25): press at the first point, move to the second in --steps, hold there
# --hold MS (a drop target reacting to the hover), release. --window and --in map both points as for
# click; --shot FILE takes a shot while the button is still down (the pointer tool pauses for it).
cmd_drag() {
  local name="" btn=left xy=() sels=() raise=1 in="" steps=10 hold=0 shot=""
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -w|--window) optarg "$@"; sels+=("$2"); shift ;;
      --in) optarg "$@"; in=$2; shift ;;
      --no-raise) raise=0 ;;
      --steps) optarg "$@"; [[ $2 =~ ^[1-9][0-9]{0,2}$ ]] || die "drag: --steps is 1-999, got $2"; steps=$2; shift ;;
      --hold) optarg "$@"; hold=$(ms_duration "$2") && [ "$hold" -le 60000 ] || die "drag: --hold is up to 60s (300ms, 2s), got $2"; shift ;;
      --shot) optarg "$@"; shot=$2; shift ;;
      left|right|middle) btn=$1 ;;
      --*) settle_opt "$@"; [ "$SETTLE_TOOK" != 0 ] || die "drag: unknown option $1"; shift $((SETTLE_TOOK - 1)) ;;
      *) [[ $1 =~ ^[0-9]+$ ]] || die "drag: bad argument $1"; xy+=("$((10#$1))") ;;
    esac
    shift
  done
  settle_opts_check
  [ ${#xy[@]} -eq 4 ] || die "drag: need X1 Y1 X2 Y2"
  [ -z "$in" ] || [ ${#sels[@]} = 0 ] || die "drag: --in or --window, not both"
  [ $raise = 1 ] || [ -n "$in" ] || [ ${#sels[@]} -gt 0 ] || die "drag: --no-raise goes with --window or --in"
  [ -z "$shot" ] || [ "$SETTLE_WAIT" = 0 ] || die "drag: --shot or --wait, not both (the shot is the look)"
  [ -z "$shot" ] || ! in_jail || die "drag: --shot is not for an agent inside ai-jail yet: omabox shot after the drag, or --hold and a shot of its own"
  select_box "$name"; need_box
  # Both points to screen pixels: from a shot's image, then from a window's coordinates.
  local pts=() i p a
  for i in 0 2; do
    local x=${xy[i]} y=${xy[i+1]} wsel=("${sels[@]}")
    if [ -n "$in" ]; then
      p=$(shot_point "$in" "$x" "$y")
      if [[ $p == window* ]]; then read -r _ a x y <<<"$p"; wsel=("$a"); else read -r _ x y <<<"$p"; fi
    fi
    if [ ${#wsel[@]} -gt 0 ]; then p=$(win_point "$raise" "$x" "$y" "${wsel[@]}") || exit $?; read -r x y <<<"$p"; fi
    pts+=("$x" "$y")
  done
  local x1=${pts[0]} y1=${pts[1]} x2=${pts[2]} y2=${pts[3]} seq n
  seq=(move "$x1" "$y1" down "$btn")
  for ((n = 1; n <= steps; n++)); do
    seq+=(move "$((x1 + (x2 - x1) * n / steps))" "$((y1 + (y2 - y1) * n / steps))")
  done
  [ "$hold" = 0 ] || seq+=(sleep "$hold")
  [ -z "$shot" ] || seq+=(pause)
  seq+=(up "$btn")
  local ext; ext=$(extent)
  if [ "$SETTLE_WAIT" = 1 ]; then
    p=$(cursor_now) && [ -n "$p" ] && SETTLE_ARGS+=(--ignore "$(cursor_rect "$p")")
    SETTLE_ARGS+=(--ignore "$(cursor_rect "$x2 $y2")")
    settle_begin settle "${SETTLE_ARGS[@]}"
    settle_ready "$SETTLE_JSON"
  fi
  if [ -z "$shot" ]; then
    if [ "$SETTLE_WAIT" = 1 ]; then settle_act on_box "$BOX_POINTER" --extent "$ext" "${seq[@]}"
    else on_box "$BOX_POINTER" --extent "$ext" "${seq[@]}"; fi
  else
    # The tool says "paused" once the button is down at the end; the shot is taken then, and a line on
    # its stdin lets it release. A shot that fails still releases the button.
    local rc=0 line
    coproc DRAG { on_box "$BOX_POINTER" --extent "$ext" "${seq[@]}"; }
    local dout=${DRAG[0]} din=${DRAG[1]} dpid=$DRAG_PID
    if read -r -t 120 line <&"$dout" && [ "$line" = paused ]; then
      ( cmd_shot -b "$NAME" -o "$shot" ) || rc=$?
    else rc=1; say "drag: the pointer did not get to the end of the drag"; fi
    echo >&"$din" || true
    exec {din}>&- || true
    wait "$dpid" || rc=$?
    [ $rc = 0 ] || exit $rc
  fi
  # For a peek window: where it started and ended (its steps would pass the mark's 64 tokens).
  mark "ptr $ext move $x1 $y1 down $btn move $x2 $y2 up $btn"
  [ "$SETTLE_WAIT" != 1 ] || settle_end settle "$SETTLE_JSON" "the drag was sent"
}

# --- waiting ------------------------------------------------------------------------------------
# `omabox wait COND` and `--wait` on keys, click and run -d (finding 82): until the screen holds still
# or changes (tools/still, in the box), a window or layer is there or gone, or a command succeeds.
# One line on stdout (or --json); exit 0 satisfied, 124 unsatisfied at the deadline (as timeout(1)),
# 1 unknown (the box went down, its screen is not rendered): never 0 for what could not be seen.

WAIT_MAX_MS=600000   # --timeout: 10 min at most

# 300ms, 2s, 1.5s, 2m, or a bare number of seconds → milliseconds (at least 1).
ms_duration() {
  [[ $1 =~ ^([0-9]{1,6}(\.[0-9]{1,3})?)(ms|s|m)?$ ]] || return 1
  awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]:-s}" 'BEGIN {
    ms = n * (u == "ms" ? 1 : u == "m" ? 60000 : 1000); ms = int(ms + 0.5); if (ms < 1) exit 1; print ms }'
}
# Milliseconds as seconds, 2 decimals: 430 → 0.43s.
ms_s() { awk -v m="$1" 'BEGIN { printf "%.2fs", m / 1000 }'; }

# Where the software cursor is drawn (it is in every frame: finding 82), as an omabox-still rectangle
# around the point "X Y": the arrow is 16x27 from 1 px up and left of its hotspot; the text I-beam
# (over a terminal or a field) is centred on it, ~10 px above and 5 left; the busy cursor shown while
# the box starts reaches ~40 px down.
cursor_rect() { echo "$((${1% *} - 16)),$((${1#* } - 16)),64,64"; }
cursor_now() { on_box hyprctl cursorpos | tr -d ' ' | awk -F, '/^[0-9]+,[0-9]+$/ { print $1, $2 }'; }

# omabox-still in the box, waiting on its first frame (the baseline). Its stdin is a pipe held here:
# when this process goes (an action failed, Ctrl-C), the tool sees it close and ends. Sets
# SETTLE_IN/SETTLE_OUT (fds), SETTLE_PID; SETTLE_T0 is when the baseline was there (ms, for messages).
# settle_begin MODE TOOL_ARGS...
settle_begin() {
  # (Before any input is sent: a box started by an omabox without the tool cannot watch.)
  on_box test -x "$BOX_STILL" || die "box '$NAME' has no $BOX_STILL (started by an older omabox): omabox down $NAME, then up again"
  local dir line; dir=$(mktemp -d)
  mkfifo "$dir/in" "$dir/out"
  on_box "$BOX_STILL" "$@" --tied < "$dir/in" > "$dir/out" 2>&1 &
  SETTLE_PID=$!
  exec {SETTLE_IN}>"$dir/in" {SETTLE_OUT}<"$dir/out"
  rm -rf "$dir"
  SETTLE_ERR=""
  while :; do
    if ! read -r -t 5 -u "$SETTLE_OUT" line; then line=""; break; fi
    [[ $line == ready* ]] && break
    [[ $line =~ ^(satisfied|unsatisfied|unknown)\  ]] && break
    SETTLE_ERR+="${SETTLE_ERR:+; }$line"
  done
  SETTLE_LINE=$line
  SETTLE_T0=$(date +%s%3N)
}

# Before keys, click or run -d act: no `ready` (the tool refused its options, or cannot watch the
# screen) means nothing is sent, and the answer is unknown (1), never the action done unwatched.
# settle_ready JSON
settle_ready() {
  [[ $SETTLE_LINE == ready* ]] && return 0
  settle_end settle "$1" "" || true
  say "nothing was sent: the screen could not be watched"
  exit 1
}

# Run an action (a function or command) without the settle pipes: nothing in the box gets them.
settle_act() { if [ -n "${SETTLE_IN:-}" ]; then "$@" {SETTLE_IN}>&- {SETTLE_OUT}<&-; else "$@"; fi; }

# The tool's answer: prints the line (or JSON), returns 0/124/1. COND names it in messages ("still",
# "change", "settle"); SENT is what an action already did, said on stderr when the answer is not yes.
# settle_end COND JSON SENT
settle_end() {
  local cond=$1 json=$2 sent=$3 line=$SETTLE_LINE rc used=$SECONDS
  if [[ $line == ready* ]]; then
    line=""
    while :; do
      if read -r -t 1 -u "$SETTLE_OUT" line; then
        [[ $line =~ ^(satisfied|unsatisfied|unknown)\  ]] && break
        SETTLE_ERR+="${SETTLE_ERR:+; }$line"; line=""; continue
      else
        rc=$?; [ $rc -gt 128 ] || { line=""; break; }   # EOF: the tool is gone without an answer
      fi
      # Waiting is using the box (idle expiry, finding 59).
      if [ $((SECONDS - used)) -ge 30 ]; then touch "$D/used" 2>/dev/null || true; used=$SECONDS; fi
    done
  fi
  exec {SETTLE_IN}>&- {SETTLE_OUT}<&-
  SETTLE_IN="" SETTLE_OUT=""
  wait "$SETTLE_PID" 2>/dev/null || true
  local res reason kv; local -A f=()
  read -r res reason kv <<<"$line"
  for kv in $kv; do f[${kv%%=*}]=${kv#*=}; done
  if [ -z "$res" ]; then
    res=unknown reason=lost
  fi
  if [ "$res" = unknown ]; then
    case $reason in
      not-rendered)
        # A hidden interactive box is drawn (finding 90) unless it is older than that or confirm-close
        # replaced its window: as shot says, a restart is the user's, and nobody shows the window.
        if [ "$(meta mode)" != interactive ]; then reason="box '$NAME' sent no frame"
        elif [ "$(meta drawn_hidden)" != true ]; then
          reason="box '$NAME' not rendered: an older omabox started it, and it is not drawn while hidden (it needs a restart: ask the user; never switch their workspace or focus)"
        elif [ -f "$D/run/omabox.reopened" ]; then
          reason="box '$NAME' not rendered: its window was replaced (confirm-close) and is not drawn while hidden (ask the user; never switch their workspace or focus)"
        else reason="box '$NAME' sent no frame ($(ws_text "$(meta workspace)"); ask the user; never switch their workspace or focus)"; fi ;;
      refused) reason="box '$NAME' refused a screen capture${SETTLE_ERR:+ ($SETTLE_ERR)}" ;;
      off-screen) reason="the region watched is not on the screen of box '$NAME'" ;;
      *) # Its compositor gone: the box is (being) taken down.
         local end gone; gone=$(($(date +%s%3N) - SETTLE_T0)) end=$((SECONDS + 2))
         while box_alive && [ $SECONDS -lt $end ]; do sleep 0.2; done
         if ! box_alive; then reason="box '$NAME' went down after $(ms_s "$gone")"
         else reason="lost the box's screen${SETTLE_ERR:+ ($SETTLE_ERR)}"; fi ;;
    esac
  fi
  local geo="" ign=""
  [ "${f[change]:--}" = - ] || geo=$(awk -F, '{ printf "%s,%s %sx%s", $1, $2, $3, $4 }' <<<"${f[change]}")
  [ "${f[ignored]:--}" = - ] || ign=$(awk -F, -v w="${f[why]}" '{ printf "%sx%s at %s,%s: %s", $3, $4, $1, $2, (w == "caret" ? "caret?" : w) }' <<<"${f[ignored]}")
  local msg
  case $res:$reason in
    satisfied:changed) msg="changed after $(ms_s "${f[last]}") at $geo" ;;
    satisfied:still|satisfied:settled)
      msg="$([ "$reason" = still ] && echo still || echo settled) after $(ms_s "${f[t]}")"
      if [ -n "$geo" ]; then msg+=" (last change $(ms_s "${f[last]}") at $geo${ign:+; ignored $ign})"
      else msg+=" (no change${ign:+; ignored $ign})"; fi ;;
    unsatisfied:nothing) msg="nothing changed in $(ms_s "${f[t]}")${ign:+ (ignored $ign)}" ;;
    unsatisfied:changing) msg="still changing after $(ms_s "${f[t]}") (last change $(ms_s "${f[last]}") at $geo)" ;;
    *) msg=$reason ;;
  esac
  if [ "$json" = 1 ]; then
    jq -nc --arg res "$res" --arg cond "$cond" --arg msg "$msg" --arg t "${f[t]:-}" --arg first "${f[first]:-}" \
      --arg last "${f[last]:-}" --arg ch "${f[change]:--}" --arg ig "${f[ignored]:--}" --arg why "${f[why]:--}" --arg frames "${f[frames]:-}" '
      def secs: if . == "" or . == "-" then null else tonumber / 1000 end;
      def box: if . == "-" then null else split(",") | map(tonumber) | {x: .[0], y: .[1], w: .[2], h: .[3]} end;
      {result: $res, condition: $cond, message: $msg, elapsed: ($t | secs), first_change: ($first | secs),
       last_change: ($last | secs), change: ($ch | box),
       ignored: (($ig | box) as $b | if $b then $b + {why: $why} else null end),
       frames: (if $frames == "" then null else $frames | tonumber end)}'
  else
    echo "$res: $msg"
  fi
  case $res in
    satisfied) return 0 ;;
    unsatisfied) [ -z "$sent" ] || say "$sent all the same (124 is about the screen): take a shot before sending anything again"; return 124 ;;
    *) [ -z "$sent" ] || say "$sent before the screen could be watched to the end"; return 1 ;;
  esac
}

# --wait on keys, click and run -d: its options, taken where the command parses its own. Sets
# SETTLE_WAIT, SETTLE_ARGS (for omabox-still), SETTLE_JSON, and SETTLE_TOOK: how many words it took (0:
# not one of these). Not in $(...): it sets globals. settle_opt OPT [VALUE]
SETTLE_ARGS=() SETTLE_JSON=0 SETTLE_WAIT=0 SETTLE_TOOK=0
settle_opt() {
  local ms
  SETTLE_TOOK=1
  case $1 in
    --wait) SETTLE_WAIT=1 ;;
    --json) SETTLE_JSON=1 ;;
    --start|--quiet|--timeout)
      if [ $# -lt 2 ] || ! ms=$(ms_duration "$2"); then die "$1 takes a duration: 300ms, 2s, 1m"; fi
      [ "$ms" -le $WAIT_MAX_MS ] || die "$1 is at most 10m"
      SETTLE_ARGS+=("$1" "$ms"); SETTLE_TOOK=2 ;;
    --strict) SETTLE_ARGS+=(--strict) ;;
    *) SETTLE_TOOK=0 ;;
  esac
}
settle_opts_check() {
  [ "$SETTLE_WAIT" = 1 ] || { [ ${#SETTLE_ARGS[@]} = 0 ] && [ "$SETTLE_JSON" = 0 ]; } ||
    die "--start, --quiet, --timeout, --strict and --json go with --wait"
}

# The polled conditions (wait window, layer, cmd): a probe prints "yes DETAIL" or "no DETAIL"; exit 2
# is a selector that can never be answered (several windows), anything else the box not answering.
# shellcheck disable=SC2329 # called through poll_until
win_probe() {
  local want=$1 wins hits n w; shift
  wins=$(box_windows 2>/dev/null) || return 1
  hits=$(jq -c "$WIN_SEL_JQ" --args "$@" <<<"$wins" 2>&1) || { say "bad window selector ($*): ${hits#jq: error*: }"; return 2; }
  n=$(jq length <<<"$hits")
  if [ "$n" -gt 1 ] && [ "$want" != gone ]; then
    say "$* matches $n windows: name one by its address (or add a selector):"; win_lines "$hits" >&2; return 2
  fi
  w=$(jq -c '.[0] // empty' <<<"$hits")
  case $want in
    gone) if [ "$n" = 0 ]; then echo yes; else echo "no $n matching"; fi ;;
    *) if [ "$n" = 0 ]; then echo no
       elif [ "$want" = focused ] && [ "$(jq -r .active <<<"$w")" != true ]; then echo "no $(win_desc "$w") is there"
       else echo "yes $(jq -r '"\(.address) \(.class) \(.title | tojson) at \(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" + (if .active then ", focused" else "" end)' <<<"$w")"; fi ;;
  esac
}
# shellcheck disable=SC2329 # called through poll_until
layer_probe() {
  local want=$1 ns=$2 layers l
  layers=$(on_box hyprctl -j layers 2>/dev/null) || return 1
  l=$(jq -r --arg n "$ns" 'first(.. | objects | select(.namespace? == $n) | "\(.x),\(.y) \(.w)x\(.h)") // empty' <<<"$layers")
  if [ "$want" = gone ]; then if [ -z "$l" ]; then echo yes; else echo no; fi
  elif [ -n "$l" ]; then echo "yes at $l"; else echo no; fi
}
# One try of `wait cmd`: the command in the box, cut off at the time left.
# shellcheck disable=SC2329 # called through poll_until
cmd_probe() {
  local left=$((POLL_TMO - ($(date +%s%3N) - POLL_T0))) rc=0
  box_alive || return 1
  box_exec timeout -k 1 "$(awk -v m="$left" 'BEGIN { printf "%.3f", (m < 100 ? 100 : m) / 1000 }')" "$@" >/dev/null 2>&1 || rc=$?
  if [ "$rc" = 0 ]; then echo yes; else echo "no exit $rc"; fi
}

# Poll PROBE every 100 ms until it says yes NEED times in a row (2 for a window or layer: one caught
# mid-map or mid-close is not an answer), or the deadline. YES and NO are the condition in words.
# poll_until YES NO NEED TIMEOUT_MS JSON PROBE...
poll_until() {
  local yes_text=$1 no_text=$2 need=$3 json=$5 out="" rc yes=0 used=$SECONDS res msg now detail=""
  POLL_TMO=$4 POLL_T0=$(date +%s%3N); shift 5
  while :; do
    rc=0; out=$("$@") || rc=$?
    now=$(($(date +%s%3N) - POLL_T0))
    [ $rc != 2 ] || exit 2
    if [ $rc != 0 ]; then
      box_alive && die "wait: could not ask box '$NAME'"
      res=unknown msg="box '$NAME' went down after $(ms_s $now)"; break
    fi
    detail=${out#* }; [ "$detail" != "$out" ] || detail=""
    if [[ $out == yes* ]]; then
      yes=$((yes + 1)); [ $yes -lt "$need" ] || { res=satisfied msg="$yes_text after $(ms_s $now)${detail:+: $detail}"; break; }
    else yes=0; fi
    if [ $now -ge "$POLL_TMO" ]; then res=unsatisfied msg="$no_text after $(ms_s $now)${detail:+ ($detail)}"; break; fi
    if [ $((SECONDS - used)) -ge 30 ]; then touch "$D/used" 2>/dev/null || true; used=$SECONDS; fi
    sleep 0.1
  done
  if [ "$json" = 1 ]; then
    jq -nc --arg res "$res" --arg cond "$1" --arg msg "$msg" --arg t "$now" --arg d "$detail" \
      '{result: $res, condition: ($cond | sub("_probe$"; "") | sub("^win$"; "window")), message: $msg, elapsed: ($t | tonumber / 1000),
        detail: (if $d == "" then null else $d end)}'
  else
    echo "$res: $msg"
  fi
  case $res in satisfied) return 0 ;; unsatisfied) return 124 ;; *) return 1 ;; esac
}

cmd_wait() {
  local name="" json=0 tmo=10000 cond="" quiet="" strict=0 geom="" sels=() want="" ns="" run=()
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      --json) json=1 ;;
      --timeout) optarg "$@"; tmo=$(ms_duration "$2") || die "wait: --timeout takes a duration: 500ms, 10s, 2m"
        [ "$tmo" -le $WAIT_MAX_MS ] || die "wait: --timeout is at most 10m (got $2)"; shift ;;
      --quiet) optarg "$@"; quiet=$(ms_duration "$2") || die "wait: --quiet takes a duration: 300ms, 1s"
        [ "$quiet" -le $WAIT_MAX_MS ] || die "wait: --quiet is at most 10m (got $2)"; shift ;;
      --strict) strict=1 ;;
      -g) optarg "$@"; geom=$2; shift ;;
      -w|--window) optarg "$@"; sels+=("$2"); shift ;;
      --gone) want=gone ;;
      --focused) want=focused ;;
      --) shift; [ "$cond" = cmd ] || die "wait: -- goes with cmd (omabox wait cmd -- CMD ...)"; run=("$@"); break ;;
      -*) die "wait: unknown option $1" ;;
      *) if [ -z "$cond" ]; then cond=$1
         elif [ "$cond" = window ]; then sels+=("$1")
         elif [ "$cond" = layer ] && [ -z "$ns" ]; then ns=$1
         else die "wait: unexpected $1"; fi ;;
    esac
    shift
  done
  case $cond in
    still|change)
      [ -z "$want" ] || die "wait: --gone and --focused go with window or layer"
      [ -z "$geom" ] || [ ${#sels[@]} = 0 ] || die "wait: -g or --window, not both" ;;
    window) [ ${#sels[@]} -gt 0 ] || die "wait window: which window? (a SEL, as for shot --window)"
      [ -z "$geom$quiet" ] && [ $strict = 0 ] || die "wait window: -g, --quiet and --strict go with still and change" ;;
    layer) [ -n "$ns" ] || die "wait layer: which layer? its namespace (omabox hyprctl layers): omarchy-menu, ..."
      [ "$want" != focused ] || die "wait layer: --gone or nothing"
      [ ${#sels[@]} = 0 ] && [ -z "$geom$quiet" ] && [ $strict = 0 ] || die "wait layer: only --gone" ;;
    cmd) [ ${#run[@]} -gt 0 ] || die "wait cmd: nothing to run (omabox wait cmd -- CMD ...)" ;;
    "") die "wait: for what? still, change, window SEL, layer NAMESPACE or cmd -- CMD (omabox help)" ;;
    *) die "wait: unknown condition $cond (still, change, window, layer, cmd)" ;;
  esac
  [ "$cond" != change ] || [ -z "$quiet" ] || die "wait change: no --quiet (that is still's)"
  select_box "$name"; need_box
  case $cond in
    window)
      local w="window ${sels[*]}"
      case $want in
        gone) poll_until "$w gone" "$w still there" 2 "$tmo" "$json" win_probe gone "${sels[@]}" ;;
        focused) poll_until "$w focused" "$w not focused" 2 "$tmo" "$json" win_probe focused "${sels[@]}" ;;
        *) poll_until "$w" "no $w" 2 "$tmo" "$json" win_probe present "${sels[@]}" ;;
      esac ;;
    layer)
      if [ "$want" = gone ]; then poll_until "layer $ns gone" "layer $ns still there" 2 "$tmo" "$json" layer_probe gone "$ns"
      else poll_until "layer $ns" "no layer $ns" 2 "$tmo" "$json" layer_probe present "$ns"; fi ;;
    cmd) poll_until "cmd" "cmd still failing" 1 "$tmo" "$json" cmd_probe "${run[@]}" ;;
    still|change)
      local args=(--timeout "$tmo") region="" p
      [ -z "$quiet" ] || args+=(--quiet "$quiet")
      [ $strict = 0 ] || args+=(--strict)
      if [ -n "$geom" ]; then
        local g; g=$(geom_parse "$geom") || die "wait: -g is \"X,Y WxH\" (or X,Y,W,H), got $geom"
        region=${g// /,}
      elif [ ${#sels[@]} -gt 0 ]; then
        # Its place on the screen: what is drawn there is what is watched.
        local w; w=$(win_select "$(box_windows)" "${sels[@]}")
        [ "$(jq -r .onscreen <<<"$w")" = true ] || die "wait: window $(win_desc "$w") is not on screen (workspace $(jq -r .workspace <<<"$w")): $cond watches its place on the screen"
        region=$(jq -r '"\(.at[0]),\(.at[1]),\(.size[0]),\(.size[1])"' <<<"$w")
      fi
      [ -z "$region" ] || args+=(--region "$region")
      p=$(cursor_now) && [ -n "$p" ] && args+=(--ignore "$(cursor_rect "$p")")
      settle_begin "$cond" "${args[@]}"
      local rc=0; settle_end "$cond" "$json" "" || rc=$?
      return $rc ;;
  esac
}

cmd_hyprctl() {
  local name=""
  while [ "${1:-}" = -b ] || [ "${1:-}" = --box ]; do optarg "$@"; name=$2; shift 2; done
  select_box "$name"; need_box
  on_box hyprctl "$@"
}

# The box's screen: output name and mode (WxH@HZ as Hyprland reports it).
box_screen() {
  on_box hyprctl -j monitors | jq -r 'map(select(.disabled | not)) | .[0] // empty |
    "\(.name) \(.width)x\(.height)@\(.refreshRate * 100 | round / 100)"'
}

# Change a headless box's mode live. `hyprctl keyword monitor` fails under the Lua config ("keyword
# can't work with non-legacy parsers"), so it goes through eval; omabox.mode keeps it over a reload.
cmd_mode() {
  local name="" want=""
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -*) die "mode: unknown option $1" ;;
      *) want=$1 ;;
    esac
    shift
  done
  select_box "$name"; need_box
  local screen; screen=$(box_screen)
  [ -n "$want" ] || { echo "$screen"; return; }
  [ "$(meta mode)" = headless ] || die "mode: box '$NAME' is interactive: its window's size is its mode"
  want=$(parse_mode "$want")
  if [ "$(meta wayland_screen)" = true ]; then
    local parent
    parent=$(cat "$D/run/omabox-parent-display" 2>/dev/null) || die "mode: no parent Wayland display"
    [[ $parent =~ ^wayland-[0-9]+$ ]] && [ -S "$D/run/$parent" ] && [ ! -L "$D/run/$parent" ] ||
      die "mode: invalid parent Wayland display"
    on_box env WAYLAND_DISPLAY="$parent" /usr/bin/wlr-randr --output HEADLESS-1 --custom-mode "${want}Hz" ||
      die "mode: could not resize the private parent output to $want"
  fi
  local out; out=$(on_box hyprctl eval "hl.monitor({ output = '${screen%% *}', mode = '$want', position = '0x0', scale = 1 })" 2>&1) || true
  [ "$out" = ok ] || die "mode: hyprctl eval failed: $out"
  local deadline=$((SECONDS + 5))
  until screen=$(box_screen) && [ "${screen#* }" = "$want" ]; do
    [ $SECONDS -lt $deadline ] || die "mode: asked for $want, box reports ${screen#* }"
    sleep 0.1
  done
  # Kept only once the box has it: omabox.mode for a config reload, box.json for `ls`. box.json under
  # the box's lock, as take_over writes it: a takeover between this read and write would be undone
  # (the agent that exited put back, and the box taken down under the new one; finding 93).
  box_file "$D/run/omabox.mode" "$want" || die "mode: could not record $want for the box's config reloads"
  local lock; exec {lock}>"$BOXES/.lock-$NAME"
  flock -w 60 "$lock" || die "mode: box '$NAME' is busy (an up or down); $want is set, but ls will not show it"
  box_alive || die "mode: box '$NAME' went down meanwhile"
  jq --arg s "$want" '.size = $s' "$D/box.json" > "$D/box.json.tmp" && mv "$D/box.json.tmp" "$D/box.json"
  exec {lock}>&-
  echo "$screen"
}

# GPU engine time of this box's processes, as % of wall time, by process name. Host-wide tools sum
# DRM fdinfo by name, so a box's Hyprland and quickshell merge with the real ones; here a process
# belongs to the box when it is in the box's pid namespace. Any driver that reports drm-engine-*;
# a DRM client shared by several fds or processes counts once (drm-pdev + drm-client-id).
cmd_gpu() {
  local name="" secs=5 json=0
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      --json) json=1 ;;
      -*) die "gpu: unknown option $1" ;;
      *) { [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v s="$1" 'BEGIN { exit !(s > 0) }'; } || die "gpu: SECONDS is a number above 0, got $1"; secs=$1 ;;
    esac
    shift
  done
  select_box "$name"; need_box
  box_pids >/dev/null || die "gpu: cannot read the box's pid namespace"
  # Global, not local: the EXIT trap runs after this function has returned (or on Ctrl-C).
  GPU_TMP=$(mktemp -d); trap 'rm -rf "$GPU_TMP"' EXIT
  local tmp=$GPU_TMP
  # One line per DRM client and engine: time, pdev/client-id, engine, ns, pid, name.
  snap() {
    local pids p
    pids=$(box_pids) || true
    for p in $pids; do
      # shellcheck disable=SC2016 # awk's own $ fields
      awk -v pid="$p" -v comm="$(tr -s ' \t' _ < "/proc/$p/comm" 2>/dev/null)" '
        FNR == 1 { flush() }
        /^drm-pdev:/ { pdev = $2 } /^drm-client-id:/ { cid = $2 }
        /^drm-engine-/ && !/^drm-engine-capacity-/ { e = $1; sub(/^drm-engine-/, "", e); sub(/:$/, "", e); eng[e] = $2 }
        function flush(  k) { if (cid != "") for (k in eng) print pdev "/" cid, k, eng[k], pid, comm; pdev = cid = ""; delete eng }
        END { flush() }' "/proc/$p/fdinfo/"* 2>/dev/null || true
    done
  }
  local t0 t1
  t0=$(date +%s%N); snap > "$tmp/a"
  sleep "$secs"
  t1=$(date +%s%N); snap > "$tmp/b"
  local screen; screen=$(box_screen)
  # A client first seen in the second sample started during the window: all its time counts. Every
  # process holding a client is listed, idle ones at 0.0.
  awk -v wall=$((t1 - t0)) '
    FNR == NR { a[$1 " " $2] = $3; next }
    !(($1 " " $2) in seen) { seen[$1 " " $2]; if (!($1 in who)) who[$1] = $5
      d = $3 - a[$1 " " $2]; if (d < 0) d = 0; t[who[$1]] += d; te[who[$1] " " $2] += d }
    END { for (n in t) printf "%s %.1f\n", n, t[n] / wall * 100
          for (k in te) printf "engine %s %.1f\n", k, te[k] / wall * 100 }' "$tmp/a" "$tmp/b" > "$tmp/r"
  if [ $json = 1 ]; then
    jq -Rn --arg box "$NAME" --arg screen "$screen" --argjson secs "$secs" '
      [inputs | split(" ")] as $r |
      { box: $box, output: ($screen | split(" ")[0]), mode: ($screen | split(" ")[1]), seconds: $secs,
        percent: ([$r[] | select(.[0] != "engine") | {(.[0]): (.[1] | tonumber)}] | add // {}),
        engines: (reduce ($r[] | select(.[0] == "engine")) as $e ({}; .[$e[1]][$e[2]] = ($e[3] | tonumber))) }' < "$tmp/r"
    return
  fi
  echo "box '$NAME': ${screen#* } on ${screen%% *}, ${secs}s, % of wall time on the GPU (all engines)"
  grep -v '^engine ' "$tmp/r" | sort -k2 -rn | awk '{ printf "  %-20s %5.1f%%\n", $1, $2 }'
  grep -qv '^engine ' "$tmp/r" || echo "  (no GPU time)"
}

# A live, view-only window of a headless box on the user's workspace 9 (or the configured one,
# finding 70), opened without focus: frames
# copied out of the box (tools/peek), nothing sent in, so it never disturbs what an agent is doing.
# --focus (the bar widget's click, so the user asked for it) then brings that window forward, and for
# an interactive box its own window; it never focuses anything unasked.
cmd_peek() {
  local name="" fps=10 focus=0 ws=""
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      --fps) optarg "$@"; fps=$2; shift ;;
      --workspace) optarg "$@"; ws=$(ws_check "$2") || die "--workspace: 1-99, special (the scratchpad, SUPER+S) or special:NAME, got $2"; shift ;;
      --focus) focus=1 ;;
      -*) die "peek: unknown option $1" ;;
      *) [ -z "$name" ] || die "peek: one box name, got $name and $1"; name=$1 ;;
    esac
    shift
  done
  [[ $fps =~ ^[1-9][0-9]?$ ]] || die "peek: --fps is 1 to 99, got $fps"
  select_box "$name"; need_box
  host_session
  if [ "$(meta mode)" = interactive ]; then
    # omabox-wlfd connects and execs bwrap, so the host sees the window as the outer bwrap's.
    [ $focus = 1 ] && { focus_pid "$(ps -o ppid= -p "$(box_pid)" | tr -d ' ')"; return; }
    say "box '$NAME' is interactive: it is already a window on $(ws_text "$(meta workspace)")"; return
  fi
  local pid; pid=$(peek_pid) || true
  if [ -n "$pid" ]; then
    [ $focus = 1 ] && { focus_pid "$pid"; return; }
    say "box '$NAME' already has a peek window"; return
  fi
  [ -n "$ws" ] || ws=$(conf_get workspace)
  [ -x "$PEEK" ] || die "missing $PEEK: run install.sh"
  # peek itself runs on the host (it is a window there) and connects to the box's socket from the
  # host's side of its runtime dir, which the box can write: only a real socket, no symlink (finding
  # 63; tools/peek also checks every frame it is sent). Everything that goes into the host's Lua is
  # a checked, tame value.
  local wd sock output
  wd=$(box_env WAYLAND_DISPLAY) || die "peek: box '$NAME' has no WAYLAND_DISPLAY"
  sock=$D/run/$wd
  [ -S "$sock" ] && [ ! -L "$sock" ] || die "peek: $sock is not the box's Wayland socket"
  output=$(on_box hyprctl -j monitors | jq -r 'map(select(.disabled | not)) | .[0].name // empty')
  [[ $output =~ ^[A-Za-z0-9_-]+$ ]] || die "peek: box '$NAME' reports no usable output ($output)"
  # A fresh marks file (finding 85) that only we can read; peek reads what is added to it.
  rm -f "$D/marks"; (umask 077; : > "$D/marks")
  # Launched by the host Hyprland: its exec rules put exactly this window on that workspace, unfocused.
  host_eval "hl.exec_cmd('$(lua_str "$PEEK") --box $(lua_str "$sock") --output $output --fps $fps --title \"omabox peek: $NAME\" --marks $(lua_str "$D/marks")', { workspace = '$ws silent', no_initial_focus = true })"
  say "peek at box '$NAME' on $(ws_text "$ws") (view only; close it with SUPER+W, or it goes with the box)"
  [ $focus = 1 ] || return 0
  local deadline=$((SECONDS + 5))
  until pid=$(peek_pid) && host_hyprctl -j clients | jq -e --argjson p "$pid" 'any(.pid == $p)' >/dev/null; do
    [ $SECONDS -lt $deadline ] || die "peek window did not appear"
    sleep 0.05
  done
  focus_pid "$pid"
}

# Focus a host window by its pid; Hyprland switches to its workspace.
focus_pid() {
  [[ $1 =~ ^[0-9]+$ ]] || die "no window to focus"
  host_eval "hl.dispatch(hl.dsp.focus({ window = 'pid:$1' }))"
}

# NAME, -b NAME, or nothing (the default box): for commands that take nothing else.
name_arg() {
  local cmd=$1 name=""; shift
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -*) die "$cmd: unknown option $1" ;;
      *) [ -z "$name" ] || die "$cmd: one box name, got $name and $1"; name=$1 ;;
    esac
    shift
  done
  printf '%s' "$name"
}

# share/shell.sh keeps the shell's pid in the box's omabox-shell.pid: the new pid appearing there is
# the restart (a project's own quickshell in the box is not the Omarchy shell, finding 63).
cmd_restart_shell() {
  local name; name=$(name_arg restart-shell "$@") || exit 1
  select_box "$name"; need_box
  local old; old=$(cat "$D/run/omabox-shell.pid" 2>/dev/null) || old=""
  on_box hyprctl dispatch "hl.dsp.exec_cmd('/opt/omabox/share/shell.sh')" >/dev/null
  local deadline=$((SECONDS + 15)) new
  until new=$(cat "$D/run/omabox-shell.pid" 2>/dev/null) && [ -n "$new" ] && [ "$new" != "$old" ]; do
    [ $SECONDS -lt $deadline ] || die "shell did not restart; see $D/home/shell.log"
    sleep 0.1
  done
  wait_ready 1
  say "shell restarted in box '$NAME'"
}

# --- guard ---------------------------------------------------------------------------------------

# The agent guard (findings 65-67): agents' shell commands get a display that does not exist, so a
# window, hyprctl or grim outside a box fails instead of reaching the desktop. It stops accidents, not
# an agent that sets the variables back on purpose, and not the session bus. Also:
# - QT_QPA_PLATFORMTHEME blank: Omarchy's gtk3 makes even an offscreen Qt program (ctest's) start GTK,
#   which exits with "cannot open display" (finding 66);
# - QT_FORCE_STDERR_LOGGING: a Qt program with no display aborts, and without a terminal its reason
#   went to the journal: now the agent reads it;
# - a core limit of 1 byte, so that abort does not reach omarchy-crash-watch's notification (see nocore);
# - no opening links or files on the desktop (finding 92): xdg-open, gh --web and whatever reads $BROWSER
#   reach a browser already running there over its own socket, not the display. BROWSER and GH_BROWSER
#   name share/guard/xdg-open, which refuses; Claude Code's and `guard exec`'s PATH also put it first
#   as xdg-open (Codex only sets values, so it gets the variables).
GUARD_PATH=$ROOT/share/guard
GUARD_ENV=(WAYLAND_DISPLAY="$GUARD" HYPRLAND_INSTANCE_SIGNATURE="$GUARD" DISPLAY= QT_QPA_PLATFORMTHEME= QT_FORCE_STDERR_LOGGING=1
  BROWSER="$GUARD_PATH/xdg-open" GH_BROWSER="$GUARD_PATH/xdg-open")
GUARD_NOTE="omabox guard: shell commands here have no display (WAYLAND_DISPLAY=$GUARD). Anything that may open a \
window (apps, test binaries run outside ctest), hyprctl, grim and keyring checks go through omabox (load the omabox \
skill). Opening a link or file there (xdg-open, gh --web) is refused too: give the user the link. Never point \
WAYLAND_DISPLAY, DISPLAY or HYPRLAND_INSTANCE_SIGNATURE back at the real session. Only when the \
user asked for their real desktop in this task, run that command with: omabox host -- CMD"
# Claude Code: a SessionStart hook writes the exports to $CLAUDE_ENV_FILE, which Claude Code sources
# before every shell command of the session, subagents' included, and prints the note into the
# context. Not the settings' `env` block: that also changes Claude Code's own process (clipboard
# paste, opening the browser). The hook is ours if its command mentions $GUARD.
GUARD_HOOK="if [ -n \"\$CLAUDE_ENV_FILE\" ] && echo 'export ${GUARD_ENV[*]} PATH=\"$GUARD_PATH:\$PATH\"; prlimit --pid \$\$ --core=1: 2>/dev/null || true' >> \"\$CLAUDE_ENV_FILE\"; then echo '$GUARD_NOTE'; \
else echo 'omabox guard: NOT applied (no CLAUDE_ENV_FILE): shell commands here reach the real desktop; do GUI work in omabox anyway'; fi"
# shellcheck disable=SC2016 # jq, not shell
GUARD_JQ='def ours: (.command? // "") | contains($g);
  def strip: if any(.hooks.SessionStart[]?.hooks[]?; ours) then
      .hooks.SessionStart |= map(if any(.hooks[]?; ours) then (.hooks |= map(select(ours | not))) | select(.hooks != []) else . end)
      | if .hooks.SessionStart == [] then del(.hooks.SessionStart) else . end
      | if .hooks == {} then del(.hooks) else . end
    else . end;'
# Codex: its shell_environment_policy.set, in a marked block of config.toml (no note: nothing checked
# yet makes a Codex hook add to the context). No core limit there: Codex sets variables, not limits.
GUARD_CODEX="# >>> omabox guard (\`omabox guard off\` removes this block)
[shell_environment_policy.set]
$(for kv in "${GUARD_ENV[@]}"; do printf '%s = "%s"\n' "${kv%%=*}" "${kv#*=}"; done)
# <<< omabox guard"

# Write a settings file the way both agents need: through a link to its target, a .bak-<ts> of the
# old one, its mode kept, renamed into place. guard_write FILE CONTENT
guard_write() {
  local file=$1 tmp bak=""
  mkdir -p "$(dirname "$file")"
  tmp=$(mktemp "$file.omabox.XXXXXX")
  if [ -e "$file" ]; then
    bak=$file.bak-$(date +%s.%N)   # (two changes in one second each keep their own)
    cp -p "$file" "$bak"
    chmod --reference="$file" "$tmp"
  fi
  if ! { printf '%s' "$2" > "$tmp" && mv "$tmp" "$file"; }; then rm -f "$tmp"; die "could not write $file"; fi
  say "guard $ACT in $file${bak:+ (was: $bak)}; new sessions pick it up"
}

# guard_claude state|on|off: prints the state, or applies.
guard_claude() {
  local file; file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
  [ ! -L "$file" ] || file=$(readlink -f "$file")   # a settings file linked from a dotfiles repo
  local cur='{}'
  if [ -e "$file" ]; then
    cur=$(cat "$file") || die "cannot read $file"
    jq -e 'type == "object"' <<<"$cur" >/dev/null 2>&1 || die "$file is not a JSON object: not touched"
  fi
  local want
  case $1 in
    state)
      local line dir
      line=$(jq -r --arg g "$GUARD" --arg c "$GUARD_HOOK" --arg f "$file" "$GUARD_JQ"'
        [.hooks.SessionStart[]?.hooks[]? | select(ours)]
        | "Claude Code (\($f)): " + if . == [] then "off" elif all(.command == $c) then "on" else "outdated" end' <<<"$cur")
      # A hook written from a checkout that is gone (a removed worktree) no longer stops xdg-open.
      if [[ $line == *": outdated" ]]; then
        while IFS= read -r dir; do
          [ -x "$dir/xdg-open" ] || line+=": its $dir is gone, so links open on the desktop again"
        done < <(jq -r --arg g "$GUARD" "$GUARD_JQ"'.hooks.SessionStart[]?.hooks[]? | select(ours) | .command' <<<"$cur" |
          grep -o 'PATH="[^"]*/share/guard:' | sed 's/^PATH="//; s/:$//')
      fi
      echo "$line"
      return ;;
    on) want=$(jq --arg g "$GUARD" --arg c "$GUARD_HOOK" "$GUARD_JQ"' strip | .hooks.SessionStart += [{hooks: [{type: "command", command: $c}]}]' <<<"$cur") ;;
    off) want=$(jq --arg g "$GUARD" "$GUARD_JQ"' strip' <<<"$cur") ;;
  esac
  if [ "$(jq -S . <<<"$want")" = "$(jq -S . <<<"$cur")" ]; then say "guard already $1 in $file"; return; fi
  guard_write "$file" "$want"$'\n'
}

# guard_codex state|on|off. TOML is edited as text (our block only) and the result checked with
# python's tomllib: a config whose own shell_environment_policy.set would clash is refused, untouched.
guard_codex() {
  local file; file=${CODEX_HOME:-$HOME/.codex}/config.toml
  [ ! -L "$file" ] || file=$(readlink -f "$file")
  local out
  out=$(python3 - "$1" "$file" "$GUARD_CODEX" <<'PY'
import os, sys, tomllib
mode, path, block = sys.argv[1:]
try:
    cur = open(path).read()
except FileNotFoundError:
    cur = ""
lines = block.split("\n")
begin, end, mine = "# >>> omabox guard", lines[-1], lines[1:-1]
keys = {l.split(" = ")[0] for l in mine[1:]}
def ours(l):   # our header, or one of our keys with any value (an older block's)
    return l == mine[0] or l.split(" = ")[0] in keys
def fail(msg):
    print("ERR " + msg); sys.exit(1)
def find(s):
    # (start, end, inner lines) of our block, or None. Codex keeps the file's last comment, our end
    # marker, at the very end when it adds a table (codex mcp add, a trusted project), so what follows
    # our lines inside the markers may be Codex's own.
    i = s.find(begin)
    if i < 0 or (i > 0 and s[i - 1] != "\n"):
        return None
    j = s.find("\n" + end, i)
    if j < 0:
        fail(f"{path}: an omabox guard block with no end marker: not touched")
    k = j + 1 + len(end) + (1 if s[j + 1 + len(end):j + 2 + len(end)] == "\n" else 0)
    return i, k, s[i:j].split("\n")[1:]
def strip(s):
    b = find(s)
    if not b:
        return s
    i, k, inner = b
    rest = [l for l in inner if not ours(l)]
    while rest and not rest[0].strip():
        rest.pop(0)
    # Only whole tables may stay: a key of someone else's left above them would join the table
    # before our block once our header is gone.
    if rest and not rest[0].startswith("["):
        fail(f"{path}: something was added inside the omabox guard block: not touched; remove the block by hand")
    kept = "\n".join(rest).rstrip("\n")
    if s[:i].endswith("\n\n") and not kept:
        i -= 1
    return s[:i] + (kept + "\n" if kept else "") + s[k:]
try:
    tomllib.loads(cur)
except tomllib.TOMLDecodeError as e:
    fail(f"{path} is not valid TOML ({e}): not touched")
b = find(cur)
on = bool(b) and b[2][:len(mine)] == mine
if mode == "state":
    state = "off" if not b else ("on" if on else "outdated")
    # A block written from a checkout that is gone (a removed worktree) no longer stops gh --web.
    for l in (b[2] if b and not on else []):
        if l.startswith("BROWSER = "):
            stand_in = l.split(" = ", 1)[1].strip('"')
            if not os.access(stand_in, os.X_OK):
                state += f": its {os.path.dirname(stand_in)} is gone, so links open on the desktop again"
    print(f"STATE Codex ({path}): {state}")
    sys.exit()
base = strip(cur)
want = base
if mode == "on" and on:
    want = cur
elif mode == "on":
    want = base + ("\n" if base and not base.endswith("\n\n") else "") + ("" if not base or base.endswith("\n") else "\n") + block + "\n"
    try:
        tomllib.loads(want)
    except tomllib.TOMLDecodeError as e:
        fail(f"{path}: its own shell_environment_policy clashes with the guard's ({e}): not touched; add these under [shell_environment_policy.set] by hand:\n{block}")
if want == cur:
    print("SAME")
else:
    print("WANT"); sys.stdout.write(want + ".")   # the dot keeps $(...) from eating trailing newlines
PY
) || die "${out#ERR }"
  case $out in
    STATE*) echo "${out#STATE }" ;;
    SAME) say "guard already $1 in $file" ;;
    WANT*) out=${out#WANT$'\n'}; guard_write "$file" "${out%.}" ;;
  esac
}

# The guard's paths go into agents' settings files unquoted: only a plain path for the omabox checkout.
guard_root() {
  [[ $ROOT =~ ^[A-Za-z0-9._/+-]+$ ]] || die "the guard needs omabox at a path of letters, digits and ._/+- only, not $ROOT"
}

guard_agent() {
  case $1 in claude) guard_claude "$2" ;; codex) guard_codex "$2" ;; esac
}

cmd_guard() {
  local act=${1:-} which=${2:-all}
  case $act in
    exec)
      # Any other agent, whole: everything it runs inherits the guard (its own process loses the
      # display too: clipboard, opening a browser). And a session of its own (finding 88), unless
      # OMABOX_SESSION says otherwise.
      shift; [ "${1:-}" != -- ] || shift
      [ $# -gt 0 ] || die "guard exec: nothing to run (omabox guard exec -- AGENT ...)"
      export "${GUARD_ENV[@]}" PATH="$GUARD_PATH:$PATH"; prlimit --pid $$ --core=1: 2>/dev/null || true
      # The pid the agent runs as (exec keeps it), so its box can go with it (finding 93). A session
      # it keeps keeps its agent too, while this runs under that one: a guard exec inside a guarded
      # agent shares the outer one's box, which must not go when the inner one exits.
      if [ -z "${OMABOX_SESSION+x}" ]; then
        OMABOX_SESSION=g$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n'); export OMABOX_SESSION
        OMABOX_AGENT_PID=$$
      elif ! [[ ${OMABOX_AGENT_PID:-} =~ ^[0-9]+$ ]] || ! descends_from "$OMABOX_AGENT_PID"; then
        OMABOX_AGENT_PID=$$
      fi
      export OMABOX_AGENT_PID
      exec "$@" ;;
    ""|on|off) ;;
    *) die "guard: on or off [claude|codex], exec -- CMD, or nothing to show it" ;;
  esac
  case $which in all|claude|codex) ;; *) die "guard: which agent? claude or codex, got $which" ;; esac
  [ $# -le 2 ] || die "guard: too many arguments"
  # With no agent named: every one that is installed (its config dir exists); Claude Code always.
  local agents=()
  [ "$which" = codex ] || agents+=(claude)
  if [ "$which" = codex ] || { [ "$which" = all ] && [ -d "${CODEX_HOME:-$HOME/.codex}" ]; }; then agents+=(codex); fi
  local a
  if [ -z "$act" ]; then
    local states=() s
    # A config it cannot read is reported for that agent; the others are still shown.
    for a in "${agents[@]}"; do s=$(guard_agent "$a" state 2>&1) || s="$a: ${s#omabox: }"; states+=("$s"); echo "$s"; done
    if [ "${WAYLAND_DISPLAY:-}" = "$GUARD" ]; then echo "this shell: guarded"; else echo "this shell: reaches the desktop"; fi
    if printf '%s\n' "${states[@]}" | grep -qv ': on$'; then
      echo; echo "\`omabox guard on\` gives agents' shell commands:"
      echo "  ${GUARD_ENV[*]}, and (Claude Code) $GUARD_PATH first on PATH and a core limit of 1 byte"
      echo "and tells Claude Code's agents: $GUARD_NOTE"
    fi
    return
  fi
  ACT=$act
  [ "$act" = off ] || guard_root
  for a in "${agents[@]}"; do guard_agent "$a" "$act"; done
}

# `omabox host -- CMD`: one command on the user's real desktop, from a guarded shell, when the user
# asked for it (finding 67). The session as omabox finds it (host_session); DISPLAY and the Qt theme
# as the user manager has them (uwsm exports the session there); cores as usual. It says what it runs,
# so the exception is on the record.
cmd_host() {
  [ "${1:-}" != -- ] || shift
  [ $# -gt 0 ] || die "host: nothing to run (omabox host -- CMD ...)"
  host_session
  local sysenv v val; sysenv=$(systemctl --user show-environment 2>/dev/null) || sysenv=""
  for v in DISPLAY QT_QPA_PLATFORMTHEME; do
    val=$(sed -n "s/^$v=//p" <<<"$sysenv")
    if [[ $val =~ ^[A-Za-z0-9:._-]+$ ]]; then export "$v=$val"; else unset "$v"; fi
  done
  local path; path=$(caller_path)
  export WAYLAND_DISPLAY="${HOST_WL##*/}" HYPRLAND_INSTANCE_SIGNATURE="$HOST_SIG" PATH="$path"
  unset QT_FORCE_STDERR_LOGGING
  # The guard's browser stand-in (finding 92, any checkout's) gives way to the user manager's value, or
  # none. A BROWSER the guard did not set stays: Omarchy sets it in the shell, not the user manager.
  # systemctl prints a value with spaces or shell characters quoted, as $'...': not taken as it is.
  for v in BROWSER GH_BROWSER; do
    case ${!v:-} in */share/guard/xdg-open) ;; *) continue ;; esac
    val=$(sed -n "s/^$v=//p" <<<"$sysenv")
    case $val in ""|*/share/guard/xdg-open|\$\'*) unset "$v" ;; *) export "$v=$val" ;; esac
  done
  ulimit -Sc "$(ulimit -Hc)" 2>/dev/null || true
  say "on your real desktop: $*"
  exec "$@"
}

cmd_env() {
  local name; name=$(name_arg env "$@") || exit 1
  select_box "$name"; need_box
  # The box bus is private and its Hyprland socket path too long to reach directly: for those use
  # `omabox run` and `omabox hyprctl`. Plain Wayland clients (wl-paste, wlr-randr, ...) work with this.
  # The socket is in the box's runtime dir: a tool pointed at it talks to whatever the box put there.
  local wd; wd=$(box_env WAYLAND_DISPLAY) || die "box '$NAME' has no WAYLAND_DISPLAY"
  printf 'export WAYLAND_DISPLAY=%q\nunset DISPLAY WAYLAND_SOCKET HYPRLAND_INSTANCE_SIGNATURE\n' "$D/run/$wd"
}

cmd_path() {
  local name; name=$(name_arg path "$@") || exit 1
  select_box "$name"
  # Seeding a box's HOME through its path is using it.
  if box_alive; then touch "$D/used" 2>/dev/null || true; take_over || need_box; fi
  echo "$D"
}

# --- lifecycle -----------------------------------------------------------------------------------

# PID 1 of a pid namespace ignores SIGTERM from outside (finding 6): kill_box SIGKILLs it and the
# kernel kills everything in the namespace. Takes the box's lock, so it waits for an `up` in progress.
# Show or change the settings (finding 70). The bar widget uses --json and KEY VALUE.
cmd_config() {
  local json=0 args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1 ;;
      -h|--help) echo "usage: omabox config [--json] | KEY | KEY VALUE | KEY default   (keys: ${CONF_KEYS[*]})"; return ;;
      -*) die "config: unknown option $1" ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  local k v
  case ${#args[@]} in
    0)
      if [ $json = 1 ]; then
        for k in "${CONF_KEYS[@]}"; do printf '%s\t%s\n' "$k" "$(conf_get "$k")"; done |
          jq -R 'split("\t") | {(.[0]): .[1]}' | jq -s 'add'
      else
        for k in "${CONF_KEYS[@]}"; do echo "$k=$(conf_get "$k")"; done
      fi ;;
    1) k=${args[0]}; [ -n "$(conf_default "$k")" ] || die "config: unknown key $k (keys: ${CONF_KEYS[*]})"
       conf_get "$k" ;;
    2) k=${args[0]}; [ -n "$(conf_default "$k")" ] || die "config: unknown key $k (keys: ${CONF_KEYS[*]})"
       if [ "${args[1]}" = default ]; then conf_set "$k"; v=$(conf_default "$k")
       else v=$(conf_check "$k" "${args[1]}") || die "config: bad $k: ${args[1]} ($(conf_help "$k"))"; conf_set "$k" "$v"; fi
       [ "$k" = confirm-close ] && confirm_live "$v"
       echo "$k=$v" ;;
    *) die "config: KEY [VALUE]" ;;
  esac
}
conf_help() {
  case $1 in
    workspace) echo "1-99, special (the scratchpad, SUPER+S) or special:NAME" ;;
    confirm-close) echo "on or off" ;;
    bar-icon) echo "always (the default) or auto (only while boxes exist)" ;;
  esac
}

# confirm-close is live: running interactive boxes that took it from the config follow a change
# (--confirm-close / --no-confirm-close on `up` pins a box's own).
confirm_live() {
  local d
  for d in "$BOXES"/*/; do
    [ "$(jq -r 'select(.mode == "interactive") | .confirm_close_from // empty' "$d/box.json" 2>/dev/null)" = config ] || continue
    write_confirm_flag "$d/run" "$1"
  done
}
# The flag the box's Hyprland reads when its window closes.
write_confirm_flag() {
  box_file "$1/omabox.confirm-close" "$2" 2>/dev/null || say "could not update ${1%/run}'s confirm-close"
}

cmd_down() {
  local names=() n all=0
  while [ $# -gt 0 ]; do
    case $1 in
      --all) all=1 ;;
      -b|--box) optarg "$@"; names+=("$2"); shift ;;
      -*) die "down: unknown option $1" ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  if [ $all = 1 ]; then
    [ ${#names[@]} = 0 ] || die "down: --all or names, not both"
    mapfile -t names < <(list_names)
  fi
  [ $all = 1 ] || [ ${#names[@]} -gt 0 ] || names=("$(default_name)")
  local rc=0
  for n in "${names[@]}"; do
    select_box "$n"
    rm -f "$BOXES/.expired-$NAME"
    [ -d "$D" ] || { say "no box '$NAME'"; continue; }
    mkdir -p "$BOXES"
    local lock; exec {lock}>"$BOXES/.lock-$NAME"
    # The reaper takes a box down through here while holding nothing; anyone else waits for an `up`.
    flock -w 60 "$lock" || { say "box '$NAME' is busy (an up in progress?); not taken down"; rc=1; exec {lock}>&-; continue; }
    # The reaper decided on the box it watched, then waited here: an `up` holding the lock may have
    # started a new box under the name (finding 74). Not that one.
    if [ -n "${DOWN_IF_CREATED:-}" ] && [ "$(meta created)" != "$DOWN_IF_CREATED" ]; then exec {lock}>&-; continue; fi
    # Nor, when it decided on an agent that exited, a box its session took over meanwhile (take_over).
    if [ -n "${DOWN_IF_AGENT_GONE:-}" ] && agent_alive; then exec {lock}>&-; continue; fi
    local p; p=$(peek_pid) && kill "$p" 2>/dev/null   # its peek window, if one is open
    if ! kill_box; then rc=1; exec {lock}>&-; continue; fi
    # Its reaper, unless that is us: nothing may be left running for a box that is gone.
    for p in $(pgrep -f "^(/usr/bin/)?bash $(re_quote "$ROOT/bin/omabox") _reap $(re_quote "$NAME") "); do
      [ "$p" = $$ ] || [ "$p" = "$BASHPID" ] || kill "$p" 2>/dev/null
    done
    rm_box
    exec {lock}>&-
    say "box '$NAME' down"
  done
  return $rc
}

# --json is for the bar widget (plugin/): one array, a single pass, with peek state.
cmd_ls() {
  local n
  if [ "${1:-}" = --json ]; then
    for n in $(list_names); do
      select_box "$n"
      local state=dead peeking=false
      box_alive && state=up
      peek_pid >/dev/null && peeking=true
      jq -c --arg name "$NAME" --arg state "$state" --argjson peeking $peeking \
        '{name: $name, mode, size, created, plugins, net: (.net // "host"), allow: (.allow // ""), idle: (.idle // 0),
          bar: (.bar // "user"), systemd: (.systemd // false), hyprland: (.hyprland // null),
          hyprland_version: (.hyprland_version // null)} + {state: $state, peeking: $peeking}' "$D/box.json" 2>/dev/null ||
        jq -nc --arg name "$NAME" --arg state "$state" '{name: $name, state: $state, plugins: [], peeking: false}'
    done | jq -s -c .
    return
  fi
  # IDLE: minutes since the box was last used, of its limit (it goes down when they meet).
  printf '%-24s %-11s %-16s %-6s %-9s %-9s %s\n' NAME MODE SIZE STATE NET IDLE PLUGINS
  for n in $(list_names); do
    select_box "$n"
    local state=dead idle; box_alive && state=up
    idle=$(meta idle)
    if [ "${idle:-0}" -gt 0 ] && [ -f "$D/used" ]; then
      idle="$((($(date +%s) - $(stat -c %Y "$D/used")) / 60))m/$(human_duration "$idle")"
    else idle=never; fi
    printf '%-24s %-11s %-16s %-6s %-9s %-9s %s\n' "$NAME" "$(meta mode)" "$(meta size)" "$state" "$(meta net)" "$idle" \
      "$(jq -r '.plugins | join(",")' "$D/box.json" 2>/dev/null)"
    # A box on a Hyprland build of its own (finding 116), under its line: never taken for a stock one.
    [ -z "$(meta hyprland)" ] || printf '  Hyprland: %s%s\n' "$(meta hyprland)" "$(v=$(meta hyprland_version); [ -z "$v" ] || echo " ($v)")"
  done
}

# --- ai-jail: the broker ---------------------------------------------------------------------------
# An agent inside ai-jail cannot enter a box (the jail's seccomp filter refuses setns and unshare), so
# its omabox hands each command to the broker outside, over a socket its ~/.ai-jail maps in
# (tools/relay; issue #16, finding 99). The broker runs the command here, for that jail: it reads what
# the jail may see and reach from the jail's own bwrap, and keeps the boxes it starts to that (driving
# a box is running code in it). No change to ai-jail.

in_jail() { [ -n "${OMABOX_JAIL:-}" ]; }
jail_get() { jq -r "$1" <<<"$OMABOX_JAIL"; }
# Host path P resolved, when the jail sees it (inside one of its folders); fails otherwise.
jail_sees() {
  local p; p=$(readlink -e -- "$1" 2>/dev/null) || return 1
  jq -e --arg p "$p" 'any(.roots[]; .path as $r | $p == $r or ($p | startswith($r + "/")))' <<<"$OMABOX_JAIL" >/dev/null && echo "$p"
}
# Host path P resolved, when it is one of the jail's folders, whole: nothing of the jail's own mounted
# inside (the box would see what the jail has hidden), and a mount the jail cannot swap for a link
# between this check and the box's mount (a folder below it could be).
jail_root() {
  local p; p=$(readlink -e -- "$1" 2>/dev/null) || return 1
  jq -e --arg p "$p" 'any(.roots[]; $p == .path and (.masked | not))' <<<"$OMABOX_JAIL" >/dev/null && echo "$p"
}

# The repo the caller works in (git's top level), or a failure. For a jailed caller not through git: its
# .git/config is the jail's to write, and settings there (core.fsmonitor and others) run programs, here,
# outside the jail. Its repo is the jail's folder the caller is in, when that has a .git (ai-jail's
# project: the folder it was started in).
repo_top() {
  if ! in_jail; then git rev-parse --show-toplevel 2>/dev/null; return; fi
  local cwd r; cwd=$(jail_get '.cwd // empty'); [ -n "$cwd" ] || return 1
  r=$(jq -r --arg p "$cwd" '[.roots[] | select(.masked | not) | .path as $r | select($p == $r or ($p | startswith($r + "/"))) | $r]
    | max_by(length) // empty' <<<"$OMABOX_JAIL")
  [ -n "$r" ] && [ -e "$r/.git" ] && echo "$r"
}

# bwrap's options and how many arguments each takes: the jail's policy is read from its bwrap's command
# line, and an option not known here would be misread, so it fails the read (never guessed).
declare -A BWRAP_ARITY=()
for o in unshare-user unshare-user-try unshare-ipc unshare-pid unshare-net unshare-uts unshare-cgroup \
  unshare-cgroup-try unshare-all share-net die-with-parent as-pid-1 new-session clearenv disable-userns \
  assert-userns-disabled level-prefix; do BWRAP_ARITY[--$o]=0; done
for o in tmpfs dev proc mqueue dir remount-ro chdir hostname unsetenv perms size uid gid userns userns2 \
  pidns seccomp add-seccomp-fd exec-label file-label block-fd userns-block-fd info-fd json-status-fd \
  lock-file sync-fd cap-add cap-drop argv0 overlay-src tmp-overlay ro-overlay; do BWRAP_ARITY[--$o]=1; done
for o in bind bind-try dev-bind dev-bind-try ro-bind ro-bind-try setenv symlink file bind-data \
  ro-bind-data chmod bind-fd ro-bind-fd; do BWRAP_ARITY[--$o]=2; done
BWRAP_ARITY[--overlay]=3
unset o

# A jail's policy from its bwrap's command line (NUL-separated, on stdin), as JSON: net (whether it has
# the host's network) and roots (the host folders it sees at their own path, masked when something of
# the jail's is mounted inside). A folder a later mount covers is not one. Prints why, and fails, on
# anything it cannot read.
jail_policy() {
  local a=() i=1 op n net=true binds=() dests=() k
  mapfile -d '' a
  while [ $i -lt ${#a[@]} ]; do
    op=${a[i]}
    [ "$op" != -- ] || break
    n=${BWRAP_ARITY[$op]:-}
    [ -n "$n" ] || { echo "unknown bwrap option $op"; return 1; }
    [ $((i + n)) -lt ${#a[@]} ] || { echo "bwrap option $op is cut short"; return 1; }
    case $op in
      --unshare-net|--unshare-all) net=false ;;
      --share-net) net=true ;;
      --bind|--bind-try|--dev-bind|--dev-bind-try|--ro-bind|--ro-bind-try)
        [ "${a[i+1]}" != "${a[i+2]}" ] || binds+=("${#dests[@]}")
        dests+=("${a[i+2]}") ;;
      --tmpfs|--dev|--proc|--mqueue|--dir|--tmp-overlay|--ro-overlay) dests+=("${a[i+1]}") ;;
      --symlink|--file|--bind-data|--ro-bind-data|--bind-fd|--ro-bind-fd) dests+=("${a[i+2]}") ;;
      --overlay) dests+=("${a[i+3]}") ;;
    esac
    i=$((i + n + 1))
  done
  [ $i -lt ${#a[@]} ] || { echo "no -- in the jail's bwrap command line"; return 1; }
  local roots=() r d j masked hidden
  for k in "${binds[@]}"; do
    r=${dests[k]%/}; masked=false hidden=0
    for ((j = k + 1; j < ${#dests[@]}; j++)); do
      d=${dests[j]%/}
      case "$r/" in "$d/"*) hidden=1 ;; esac      # at or above it: the folder is covered
      case "$d" in "$r/"*) masked=true ;; esac   # inside it
    done
    [ $hidden = 0 ] || continue
    r=$(readlink -e -- "$r") || continue
    roots+=("$(jq -nc --arg p "$r" --argjson m $masked '{path: $p, masked: $m}')")
  done
  jq -nc --argjson net $net '{net: $net, roots: $ARGS.positional | map(fromjson)}' --args "${roots[@]}"
}

# In the broker (omabox-relay started this command for a caller): find the caller's jail and set
# OMABOX_JAIL, which everything that matters here reads, and every omabox this one starts inherits
# (run's throwaway `up`, a box's reaper). The caller is ai-jail's: a process in the pid namespace of a
# bwrap whose parent is ai-jail itself; that bwrap's command line is the jail's whole policy, and
# nothing in the jail can change it. The pidfd (from the socket) makes sure the pid read is the
# caller's, not a reused one.
broker_init() {
  local peer=${OMABOX_BROKER_PEER:-} pfd=${OMABOX_BROKER_PIDFD:-} p pp jail="" cwd
  unset OMABOX_BROKER_PEER OMABOX_BROKER_PIDFD
  [[ $peer =~ ^[0-9]+$ && $pfd =~ ^[0-9]+$ ]] || die "broker: no caller"
  peer_there() { [ "$(awk '/^Pid:/ {print $2}' "/proc/self/fdinfo/$pfd" 2>/dev/null)" = "$peer" ]; }
  peer_there || die "broker: the caller is gone"
  p=$peer
  while [ "$p" -gt 1 ]; do
    pp=$(proc_ppid "$p") || break
    if [ "$(cat "/proc/$p/comm" 2>/dev/null)" = bwrap ] && [ "$(basename -- "$(readlink "/proc/$pp/exe" 2>/dev/null)")" = ai-jail ]; then
      jail=$p; break
    fi
    p=$pp
  done
  [ -n "$jail" ] || die "the omabox broker serves agents inside ai-jail; this caller is not in one (run omabox without the broker)"
  [ "$(readlink "/proc/$peer/ns/pid")" != "$(readlink "/proc/$jail/ns/pid")" ] || die "broker: the caller is not inside its jail"
  local policy start
  start=$(proc_start "$jail") && [ -n "$start" ] || die "broker: the jail is gone"
  policy=$(jail_policy < "/proc/$jail/cmdline") || die "broker: cannot read the jail's policy: $policy"
  peer_there || die "broker: the caller is gone"
  eval "exec $pfd<&-"
  OMABOX_JAIL=$(jq -c --arg id "$jail $start" '. + {id: $id}' <<<"$policy"); export OMABOX_JAIL
  # The caller's working directory, when the jail sees it at the same path here (box_exec starts `run`
  # there); the broker itself stays in /.
  cwd=$(jail_sees "${OMABOX_BROKER_CWD:-/nonexistent}") || cwd=""
  unset OMABOX_BROKER_CWD
  OMABOX_JAIL=$(jq -c --arg c "$cwd" '. + {cwd: $c}' <<<"$OMABOX_JAIL")
}

# What a jailed agent may ask of the broker. Not the user's desktop (host, peek, interactive boxes),
# nor omabox's own settings, the guard, the broker or the user's saves; the boxes' own commands, and `up`'s mounts and
# network, are checked where they are used (cmd_up, cmd_shot, shot_point, select_box).
broker_check() {
  local cmd=$1; shift
  case $cmd in
    up|run|shot|screenshot|windows|keys|click|pointer|drag|wait|hyprctl|restart-shell|mode|gpu|env|path|down|ls|list) ;;
    help|-h|--help|version|-V|--version) ;;
    config) [ $# = 0 ] || [ "$*" = --json ] || die "config: a jailed agent does not change omabox's settings" ;;
    *) die "omabox $cmd is not for an agent inside ai-jail" ;;
  esac
}

# The relay's binary, for a jailed caller's omabox: the checkout's, or the one the jail was given.
relay_bin() {
  if [ -x "$RELAY" ]; then echo "$RELAY"; else command -v omabox-relay; fi
}

# Whether this omabox should hand its command to the broker: it cannot enter a box here (a sandbox
# refuses it new namespaces: ai-jail), and the broker's socket is in reach.
relay_wanted() {
  [ -z "${OMABOX_BROKER_PEER:-}${OMABOX_JAIL:-}" ] && [ -S "$BROKER_SOCK" ] && ! unshare -U true 2>/dev/null
}

# Hand the command to the broker (in a jail). What only the caller has goes along: the box it would
# pick by default (the repo and session it is in, as seen here), its PATH (for `run`'s commands in the
# box) and the variables it names with --pass. Paths the command takes become absolute (the broker is
# not in this directory); files it writes or reads (shot, --in) are opened here and passed open.
relay_call() {
  local cmd=$1 relay; shift
  relay=$(relay_bin) || die "omabox-relay is not in reach: map it into the jail (omabox broker on prints how)"
  local env=(--env "DEFAULT=$(default_name)" --env "PATH=$(caller_path)") args=() a prev="" v kv kvs
  for a in "$@"; do
    # run --env-file: read here, in the jail, and sent as --pass entries (the broker reads no path of
    # the caller's). Values go in the relay's environment entries, as --pass values do.
    if [ "$prev" = --env-file ] && [ "$cmd" = run ]; then
      envfile_read "$a" >/dev/null
      mapfile -d '' kvs < <(envfile_read "$a")
      for kv in "${kvs[@]}"; do
        [[ ${kv%%=*} =~ ^[A-Za-z_][A-Za-z0-9_]{0,58}$ ]] || die "--env-file: ${kv%%=*}: a name up to 59 characters, from inside ai-jail"
        env+=(--env "PASS_$kv"); args+=(--pass "${kv%%=*}")
      done
      prev=""; continue
    fi
    if [ "$a" = --env-file ] && [ "$cmd" = run ]; then prev=$a; continue; fi
    if [ "$prev" = --pass ] && [[ $a =~ ^[A-Za-z_][A-Za-z0-9_]{0,58}$ ]] && v=$(caller_env "$a"); then env+=(--env "PASS_$a=$v"); fi
    case $prev in
      --plugin|--overlay) [[ $a != /* && -d $a ]] && a=$(readlink -f -- "$a") ;;
      --hyprland) [[ $a != /* && -e $a ]] && a=$(readlink -f -- "$a") ;;
      --ro-bind) [[ $a != /* ]] && a=$(readlink -f -- "${a%%:/*}")${a#"${a%%:/*}"} ;;
    esac
    args+=("$a"); prev=$a
  done
  case $cmd in
    shot|screenshot) relay_shot "$relay" "${env[@]}" -- "${args[@]}" ;;
    click|pointer|drag) relay_in "$relay" "$cmd" "${env[@]}" -- "${args[@]}" ;;
    *) exec "$relay" call "$BROKER_SOCK" "${env[@]}" -- "$cmd" "${args[@]}" ;;
  esac
}

# shot, from a jail: the file is made here (as `shot` names it) and filled by the broker through the
# fd; renamed into place once it is whole. relay_shot RELAY ENV... -- ARGS
relay_shot() {
  local relay=$1 env=() args=() name="" out=""; shift
  while [ "$1" != -- ]; do env+=("$1"); shift; done; shift
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; args+=("$1" "$2"); shift ;;
      -g|-w|--window|--fit) optarg "$@"; args+=("$1" "$2"); shift ;;
      -o|--output) optarg "$@"; out=$2; shift ;;
      -*) args+=("$1") ;;
      *) out=$1 ;;
    esac
    shift
  done
  select_box "$name"
  [ -n "$out" ] || out=${TMPDIR:-/tmp}/omabox-$NAME-$(date +%H%M%S-%N | cut -c1-10).png
  mkdir -p -- "$(dirname -- "$out")" || die "shot: cannot make the directory $(dirname -- "$out")"
  out=$(readlink -f -- "$out")
  local tmp fd rc=0
  tmp=$(mktemp "$(dirname -- "$out")/.omabox-shot.XXXXXX") || die "shot: cannot write in $(dirname -- "$out")"
  exec {fd}<>"$tmp"
  "$relay" call "$BROKER_SOCK" --fd "$fd" "${env[@]}" -- shot "${args[@]}" --to-fd 3 --as "$out" || rc=$?
  exec {fd}>&-
  if [ $rc = 0 ]; then mv -f -- "$tmp" "$out"; else rm -f -- "$tmp"; fi
  exit $rc
}

# click and pointer --in SHOT, from a jail: the shot is opened here and passed as fd 3, with its name.
relay_in() {
  local relay=$1 cmd=$2 env=() args=() in=""; shift 2
  while [ "$1" != -- ]; do env+=("$1"); shift; done; shift
  while [ $# -gt 0 ]; do
    [ "$1" != -- ] || { args+=("$@"); break; }
    if [ "$1" = --in ] && [ $# -ge 2 ]; then in=$2; args+=(--in /dev/fd/3); shift 2; continue; fi
    args+=("$1"); shift
  done
  [ -n "$in" ] || exec "$relay" call "$BROKER_SOCK" "${env[@]}" -- "$cmd" "${args[@]}"
  [ -f "$in" ] || die "--in: no such file: $in"
  local fd; exec {fd}<"$in"
  exec "$relay" call "$BROKER_SOCK" --fd "$fd" "${env[@]}" --env "IN_AS=$(readlink -f -- "$in")" -- "$cmd" "${args[@]}"
}

# omabox broker [on|off]: the broker as a systemd user socket (started on the first connection), and
# what to add to ~/.ai-jail so a jail reaches it. omabox never edits ~/.ai-jail.
BROKER_UNITS=$HOME/.config/systemd/user
cmd_broker() {
  local sock=$BROKER_UNITS/omabox-broker.socket svc=$BROKER_UNITS/omabox-broker.service
  case ${1:-} in
    on)
      [ -x "$RELAY" ] || make -s -C "$ROOT/tools/relay" || die "building tools/relay failed"
      mkdir -p "$BROKER_UNITS"
      cat > "$sock" <<EOF
# Written by omabox broker on ($ROOT): lets an agent inside ai-jail drive its own boxes.
[Unit]
Description=omabox broker socket (agents inside ai-jail)

[Socket]
ListenStream=%t/omabox/.broker/sock
SocketMode=0600
DirectoryMode=0700

[Install]
WantedBy=sockets.target
EOF
      # KillMode=process: the boxes it starts outlive the broker (their own reapers end them).
      cat > "$svc" <<EOF
# Written by omabox broker on ($ROOT).
[Unit]
Description=omabox broker (agents inside ai-jail)

[Service]
ExecStart=$(printf '%q' "$RELAY") listen -- $(printf '%q' "$ROOT/bin/omabox")
KillMode=process
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now omabox-broker.socket >/dev/null 2>&1 || die "systemctl --user enable --now omabox-broker.socket failed"
      systemctl --user try-restart omabox-broker.service
      echo "broker on: $BROKER_SOCK"
      broker_recipe ;;
    off)
      systemctl --user disable --now omabox-broker.socket >/dev/null 2>&1 || true
      systemctl --user stop omabox-broker.service 2>/dev/null || true
      rm -f "$sock" "$svc"; systemctl --user daemon-reload
      echo "broker off (the lines in ~/.ai-jail, if you added them, can go)" ;;
    "")
      if systemctl --user is-active -q omabox-broker.socket 2>/dev/null; then echo "broker on: $BROKER_SOCK"; broker_recipe
      else echo "broker off (omabox broker on turns it on)"; fi ;;
    *) die "broker: on, off, or nothing to see it" ;;
  esac
}
broker_recipe() {
  local bin=~/.local/bin
  cat <<EOF

For ai-jail, add to ~/.ai-jail (merge into the ro_maps there, if it has some; or under
[commands.claude] for one agent only):

ro_maps = ["$ROOT/bin/omabox:$bin/omabox", "$RELAY:$bin/omabox-relay", "$ROOT/skill", "${BROKER_SOCK%/*}"]

or for one run: ai-jail --map $ROOT/bin/omabox:$bin/omabox --map $RELAY:$bin/omabox-relay --map $ROOT/skill --map ${BROKER_SOCK%/*} claude

(omabox itself and its relay, the agent skill your agents link to, and the broker's socket; all read-only.)
EOF
}

# --- saves ---------------------------------------------------------------------------------------
# A save is a box HOME kept on purpose, for `up --from` and `run --from` to start with: what a box's
# apps set up once (signed in, a PIN set, a library scanned). SAVES/NAME/home and its save.json.
# Private (the dir is 0700): a save keeps the box's keyring, which holds what agents stored in it.

# Save names are paths: as tame as box names, but refused rather than changed to fit.
save_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$ ]] || die "bad save name: $1 (letters, digits, . _ -; 40 at most)"; }
# The save's dir, or a failure that says why.
save_dir() {
  save_name "$1"
  [ -d "$SAVES/$1/home" ] || die "no save '$1' (omabox saves lists them)"
  echo "$SAVES/$1"
}
# Whether a save's keyring holds a secret: gnome-keyring's unencrypted file has a [N] section per item.
save_keyring() { grep -qs '^\[[0-9]' "$1"/home/.local/share/keyrings/*.keyring; }
# A save or what is left of one being written; a copy of a HOME may have dirs without u+w.
rm_save() { chmod -R u+rwX "$1" 2>/dev/null || true; rm -rf "$1"; }

cmd_save() {
  local name="" save="" force=0
  while [ $# -gt 0 ]; do
    case $1 in
      -b|--box) optarg "$@"; name=$2; shift ;;
      -f|--force) force=1 ;;
      -h|--help) usage; return ;;
      -*) die "save: unknown option $1" ;;
      *) [ -z "$save" ] || die "save: one save name, got $save and $1 (the box goes with -b)"; save=$1 ;;
    esac
    shift
  done
  [ -n "$save" ] || die "save: name it (omabox save SAVE [-b NAME])"
  save_name "$save"
  select_box "$name"; need_box
  mkdir -p "$SAVES"; chmod 700 "$SAVES"
  # One save per name at a time (locked where the boxes' are); what a killed one left behind goes now.
  local lock; exec {lock}>"$BOXES/.lock-save-$save"
  flock -w 60 "$lock" || die "save '$save' is being written by another omabox save; try again"
  local d; for d in "$SAVES"/.new-"$save"-* "$SAVES"/.old-"$save"-*; do
    [ -e "$d" ] && ! kill -0 "${d##*-}" 2>/dev/null && rm_save "$d"
  done
  local dest=$SAVES/$save
  [ ! -e "$dest" ] || [ $force = 1 ] || die "save '$save' exists (--force replaces it; omabox saves lists them)"
  # The copy is made with the box paused (SIGSTOP to all of it), so it is what a power cut would have
  # left: an app's database is whole, as after a crash, not torn by a write that ran during the copy.
  # Globals: the EXIT trap runs after this function has returned (or on Ctrl-C).
  SAVE_TMP=$SAVES/.new-$save-$$ SAVE_PIDS=$(box_pids) || die "save: cannot read the pid namespace of box '$NAME'"
  trap '[ -z "$SAVE_PIDS" ] || kill -CONT $SAVE_PIDS 2>/dev/null; rm_save "$SAVE_TMP"' EXIT
  mkdir -m 700 "$SAVE_TMP"; mkdir "$SAVE_TMP/home"
  # shellcheck disable=SC2086 # one pid per word
  kill -STOP $SAVE_PIDS 2>/dev/null || true
  # All of the HOME but .cache (rebuilt by the apps) and the logs at its top (the box's, and run -d's).
  local h=$HOMES/$NAME/home e
  for e in "$h"/* "$h"/.[!.]* "$h"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    case ${e##*/} in .cache|*.log) continue ;; esac
    cp -a --reflink=auto -- "$e" "$SAVE_TMP/home/" || die "save: could not copy ${e#"$h"/}"
  done
  # shellcheck disable=SC2086
  kill -CONT $SAVE_PIDS 2>/dev/null || true
  SAVE_PIDS=""
  # The Hyprland build it ran (finding 116), so an `up --from` on another one can say so.
  jq -n --arg box "$NAME" --arg saved "$(date -Is)" --arg version "$(cat "$ROOT/VERSION")" --arg hyprland "$(meta hyprland)" \
    '{box: $box, saved: $saved, version: $version} + (if $hyprland != "" then {hyprland: $hyprland} else {} end)' > "$SAVE_TMP/save.json"
  local old=$SAVES/.old-$save-$$
  [ ! -e "$dest" ] || mv -T "$dest" "$old"
  mv -T "$SAVE_TMP" "$dest"
  [ ! -e "$old" ] || rm_save "$old"
  exec {lock}>&-
  local size keyring=""; size=$(du -sh "$dest" | cut -f1)
  save_keyring "$dest" && keyring=", keyring secrets included"
  say "saved box '$NAME' as '$save' ($size$keyring); start from it: omabox up --from $save (or run --from $save)"
  [ "$(du -sk "$dest" | cut -f1)" -lt 1048576 ] ||
    say "save '$save' is $size: a build or a download in the box HOME? (omabox saves rm $save)"
}

cmd_saves() {
  local d n
  case ${1:-} in
    rm)
      shift; [ $# -gt 0 ] || die "saves rm: which? (omabox saves lists them)"
      for n; do d=$(save_dir "$n"); rm_save "$d"; say "save '$n' removed"; done ;;
    --json)
      for d in "$SAVES"/*/; do
        [ -d "$d/home" ] || continue
        local k=false; save_keyring "$d" && k=true
        jq -c --arg name "$(basename "$d")" --arg size "$(du -sh "$d" | cut -f1)" --argjson keyring $k \
          '{name: $name, box, saved, size: $size, keyring: $keyring}' "$d/save.json" 2>/dev/null ||
          jq -nc --arg name "$(basename "$d")" '{name: $name}'
      done | jq -s -c . ;;
    "")
      printf '%-24s %-6s %-17s %-24s %s\n' NAME SIZE SAVED FROM KEYRING
      for d in "$SAVES"/*/; do
        [ -d "$d/home" ] || continue
        local k=no; save_keyring "$d" && k=yes
        printf '%-24s %-6s %-17s %-24s %s\n' "$(basename "$d")" "$(du -sh "$d" | cut -f1)" \
          "$(jq -r '.saved // "?" | sub("T"; " ") | .[0:16]' "$d/save.json" 2>/dev/null)" \
          "$(jq -r '.box // "?"' "$d/save.json" 2>/dev/null)" "$k"
      done ;;
    -h|--help) usage ;;
    *) die "saves: rm SAVE... or --json, got $1" ;;
  esac
}

# Everything runs from main, called on the file's last line: bash reads a script as it runs it, so
# with ~/.local/bin/omabox linked to a working copy, an edit made while a command ran used to land in
# the middle of what it was still reading ("line 1207: q: command not found"). By the time that line
# is read, bash has the whole file (finding 66).
main() {
  local cmd=${1:-help}; shift || true
  if [ -n "${OMABOX_BROKER_PEER:-}" ]; then broker_init; broker_check "$cmd" "$@"
  elif relay_wanted; then relay_call "$cmd" "$@"; fi
  case $cmd in
    up) cmd_up "$@" ;;
    run) cmd_run "$@" ;;
    shot|screenshot) cmd_shot "$@" ;;
    windows) cmd_windows "$@" ;;
    keys) cmd_keys "$@" ;;
    click) cmd_click "$@" ;;
    pointer) cmd_pointer "$@" ;;
    drag) cmd_drag "$@" ;;
    wait) cmd_wait "$@" ;;
    hyprctl) cmd_hyprctl "$@" ;;
    peek) cmd_peek "$@" ;;
    restart-shell) cmd_restart_shell "$@" ;;
    mode) cmd_mode "$@" ;;
    gpu) cmd_gpu "$@" ;;
    env) cmd_env "$@" ;;
    path) cmd_path "$@" ;;
    down) cmd_down "$@" ;;
    ls|list) cmd_ls "$@" ;;
    save) cmd_save "$@" ;;
    saves) cmd_saves "$@" ;;
    config) cmd_config "$@" ;;
    guard) cmd_guard "$@" ;;
    host) cmd_host "$@" ;;
    broker) cmd_broker "$@" ;;
    _reap) cmd__reap "$@" ;;
    help|-h|--help) usage ;;
    version|-V|--version) echo "omabox $(cat "$ROOT/VERSION")" ;;
    *) say "unknown command: $cmd"; usage >&2; exit 2 ;;
  esac
}

main "$@"; exit
