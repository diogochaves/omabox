+// A consumer whose compositor must tell one output's window from another's (each gets its own window
+// rule) sets AQ_WAYLAND_APP_ID_FILES to a path prefix P: an output NAME whose file P+NAME holds a token
+// (1-64 of [A-Za-z0-9_-]) gets the app_id "aquamarine-TOKEN"; any other output, and every output without
+// the env, keeps "aquamarine". Read once, when the output is made.
+static std::string appIdFor(const std::string& name) {
+    const char* prefix = getenv("AQ_WAYLAND_APP_ID_FILES");
+    if (!prefix || !*prefix || name.empty() || name.find('/') != std::string::npos)
+        return "aquamarine";
+
+    std::ifstream f(std::string{prefix} + name);
+    std::string   token;
+    if (!(f >> token) || token.size() > 64 ||
+        !std::ranges::all_of(token, [](unsigned char c) { return std::isalnum(c) || c == '-' || c == '_'; }))
+        return "aquamarine";
+
+    return "aquamarine-" + token;
+}
